.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFF9ED;
}

.loading-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.preview-card {
  width: 500rpx;
  height: 500rpx;
  background: #fff;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(140,107,75,0.1);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 120rpx;
}

.progress-info {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.progress-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #FFE0B2;
  border-top-color: #FF9800;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.progress-text {
  font-size: 28rpx;
  color: #8C6B4B;
  font-weight: 500;
}

.steps {
  margin-top: 80rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: #fff;
  opacity: 0.5;
}

.step--active {
  opacity: 1;
  background: #FFF3E0;
}

.step--done {
  opacity: 1;
  background: #E8F5E9;
}

.step text {
  font-size: 22rpx;
  color: #8C6B4B;
  font-weight: 600;
}

.step-line {
  width: 40rpx;
  height: 4rpx;
  background: #E0E0E0;
  border-radius: 2rpx;
}

.step-line--done {
  background: #4CAF50;
}
