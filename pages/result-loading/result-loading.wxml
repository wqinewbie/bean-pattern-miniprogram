<view class="container">

  <!-- 加载动画区 -->
  <view class="loading-area">

    <!-- 原图预览 -->
    <view class="preview-card">
      <image wx:if="{{sourceUrl}}" class="preview-image" src="{{sourceUrl}}" mode="aspectFit" />
      <view wx:else class="preview-placeholder">
        <text class="placeholder-icon">🖼️</text>
      </view>
    </view>

    <!-- 进度信息 -->
    <view class="progress-info">
      <view class="progress-spinner"></view>
      <text class="progress-text">{{progressText}}</text>
    </view>

    <!-- 步骤指示 -->
    <view class="steps">
      <view class="step {{step >= 1 ? 'step--done' : ''}} {{step === 1 ? 'step--active' : ''}}">
        <text>加载数据</text>
      </view>
      <view class="step-line {{step >= 2 ? 'step-line--done' : ''}}"></view>
      <view class="step {{step >= 2 ? 'step--done' : ''}} {{step === 2 ? 'step--active' : ''}}">
        <text>渲染图纸</text>
      </view>
      <view class="step-line {{step >= 3 ? 'step-line--done' : ''}}"></view>
      <view class="step {{step >= 3 ? 'step--done' : ''}} {{step === 3 ? 'step--active' : ''}}">
        <text>完成</text>
      </view>
    </view>
  </view>

  <!-- 隐藏的 Canvas 用于预渲染（使用传统 API） -->
  <canvas canvas-id="patternCanvas" style="position:fixed;left:-9999px;top:-9999px;width:300px;height:300px" />
  <canvas canvas-id="resultCanvas" style="position:fixed;left:-9999px;top:-9999px;width:300px;height:300px" />
</view>
