<view class="profile-page">
  <!-- 安全区域占位 -->
  <view style="height: {{statusBarHeight}}px; width: 100%; background:#FFEBB5;"></view>
  
  <!-- 头部黄色区域 -->
  <view class="header-zone">
    <view class="header-top">
      <view class="bell-wrap" bindtap="onNotifications">
        <image class="bell-icon" src="/assets/icons/lucide-bell.svg" mode="aspectFit"/>
        <view class="bell-dot" wx:if="{{unreadCount > 0}}"></view>
      </view>
    </view>
    <view class="user-row" bindtap="onEditProfile">
      <view class="avatar-box">
        <view class="avatar-wrap">
          <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="avatar-ph">👤</view>
        </view>
        <view class="avatar-edit">✎</view>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || '魔法师小豆'}}</text>
        <view class="user-tags">
          <text class="{{isVip ? 'tag-vip' : 'tag-normal'}}">{{isVip ? '✨ 至尊魔法会员' : '普通魔法学徒'}}</text>
          <text class="phone-tag" wx:if="{{phone}}">{{phone}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计卡片（悬浮）-->
  <view class="stats-card">
    <view class="stat-item" bindtap="onShowMagicPanel">
      <text class="stat-num">{{magicCount}}</text>
      <view class="stat-label-row">
        <image class="stat-icon" src="/assets/icons/lucide-wand2-purple.svg" mode="aspectFit"/>
        <text class="stat-label">AI魔法</text>
      </view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onShowGiftPanel">
      <text class="stat-num">{{gifts.length}}</text>
      <view class="stat-label-row">
        <image class="stat-icon" src="/assets/icons/lucide-gift-red.svg" mode="aspectFit"/>
        <text class="stat-label">礼品包</text>
      </view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onShowTaskPanel">
      <text class="stat-num">{{pendingTaskCount}}</text>
      <view class="stat-label-row">
        <image class="stat-icon" src="/assets/icons/lucide-star-yellow.svg" mode="aspectFit"/>
        <text class="stat-label">任务中心</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="scroll-body">

    <!-- VIP卡 -->
    <view class="vip-card" bindtap="onVip">
      <view class="vip-glow"></view>
      <view class="vip-left">
        <text class="vip-title">👑 {{isVip ? '至尊魔法会员' : '升级至尊魔法会员'}}</text>
        <text class="vip-sub">纯净无广告·AI生图次数·定制化水印</text>
      </view>
      <view class="vip-btn">立即开通</view>
    </view>

    <!-- 我的创作空间 -->
    <view class="section-card">
      <view class="section-title-row">
        <view class="section-bar"></view>
        <text class="section-title">我的创作</text>
      </view>
      <view class="action-grid">
        <view class="action-item action-item--blue" bindtap="onGoMyPatterns">
          <image class="action-svg" src="/assets/icons/lucide-folder-blue.svg" mode="aspectFit"/>
          <text class="action-label">图纸箱</text>
        </view>
        <view class="action-item action-item--orange" bindtap="onGoDraft">
          <image class="action-svg" src="/assets/icons/lucide-file-text-orange.svg" mode="aspectFit"/>
          <text class="action-label">草稿箱</text>
          <view wx:if="{{draftCount > 0}}" class="draft-badge">{{draftCount}}</view>
        </view>
        <view class="action-item action-item--purple" bindtap="onGoHistory">
          <image class="action-svg" src="/assets/icons/image_177743243804717.png" mode="aspectFit"/>
          <text class="action-label">时光机</text>
        </view>
      </view>
    </view>

    <!-- 菜单列表 -->
    <view class="menu-card">
      <view class="menu-item" bindtap="onOpenInvitePage">
        <view class="menu-left">
          <view class="menu-icon menu-icon--help"><image class="menu-svg" src="/assets/icons/lucide-star-yellow.svg" mode="aspectFit"/></view>
          <text class="menu-title">我的邀请码</text>
        </view>
        <view class="menu-right">
          <text class="menu-value" wx:if="{{inviteCode}}">{{inviteCode}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="onShowFeedback">
        <view class="menu-left">
          <view class="menu-icon menu-icon--help"><image class="menu-svg" src="/assets/icons/lucide-help-circle-green.svg" mode="aspectFit"/></view>
          <text class="menu-title">帮助中心</text>
        </view>
        <view class="menu-right"><text class="menu-arrow">›</text></view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="onShowSettings">
        <view class="menu-left">
          <view class="menu-icon menu-icon--settings"><image class="menu-svg" src="/assets/icons/lucide-settings-slate.svg" mode="aspectFit"/></view>
          <text class="menu-title">设置</text>
        </view>
        <view class="menu-right"><text class="menu-arrow">›</text></view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="onShowPrivacy">
        <view class="menu-left">
          <view class="menu-icon menu-icon--privacy"><image class="menu-svg" src="/assets/icons/lucide-shield-purple.svg" mode="aspectFit"/></view>
          <text class="menu-title">隐私政策</text>
        </view>
        <view class="menu-right"><text class="menu-arrow">›</text></view>
      </view>
    </view>

    <view style="height:120rpx"></view>
  </scroll-view>

  <!-- ====== 子页 ====== -->
  <view class="sub-page {{subPage?'sub-page--show':''}}">
    <view class="sub-header" style="padding-top: {{subTopSafePx}}px; min-height: {{subHeaderHeightPx}}px;">
      <view class="sub-back" bindtap="onCloseSubPage">←</view>
      <view class="sub-title-wrap">
        <text class="sub-title">{{subPage==='patterns'?'图纸箱':subPage==='feedback'?'帮助中心':subPage==='privacy'?'隐私政策':subPage==='notifications'?'通知':subPage==='account'?'账号设置':'回收站'}}</text>
        <text wx:if="{{subPage==='patterns'}}" class="sub-title-badge">📁 {{subPagePatternAll.length}}/{{isVip ? 100 : 10}}</text>
        <text wx:if="{{subPage==='notifications'}}" class="sub-title-badge">消息中心</text>
      </view>
      <view class="sub-action sub-add" wx:if="{{subPage==='patterns'}}" bindtap="onAddPattern">＋</view>
      <view class="sub-action sub-add sub-add--hidden" wx:else>{{''}}</view>
    </view>

    <scroll-view scroll-y class="sub-scroll">
      <!-- 消息中心 -->
      <view wx:if="{{subPage==='notifications'}}" class="notifications-page">
        <view wx:if="{{notifications.length===0}}" class="notifications-empty">
          <view class="notifications-empty-icon">🔔</view>
          <text class="notifications-empty-title">暂无消息</text>
        </view>
        <view wx:else class="notifications-list">
          <view wx:for="{{notifications}}" wx:key="id" class="notification-card {{item.read ? '' : 'notification-card--unread'}}">
            <view class="notification-icon notification-icon--{{item.type}}">{{item.type==='gift'?'🎁':item.type==='magic'?'🪄':'🔔'}}</view>
            <view class="notification-content">
              <view class="notification-title-row">
                <text class="notification-title">{{item.title}}</text>
                <view wx:if="{{!item.read}}" class="notification-dot"></view>
              </view>
              <text class="notification-text">{{item.content}}</text>
              <text class="notification-time">{{item.time}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 图纸箱 -->
      <view wx:if="{{subPage==='patterns'}}" class="patterns-page">
        <view class="patterns-search">
          <text class="patterns-search-icon">⌕</text>
          <input class="patterns-search-input" placeholder="搜索图纸..." value="{{patternSearchKeyword}}" bindinput="onPatternSearchInput"/>
        </view>
        <view wx:if="{{subPagePatterns.length===0}}" class="patterns-empty">
          <view class="patterns-empty-icon">📁</view>
          <text class="patterns-empty-title">{{patternSearchKeyword ? '没有找到相关图纸' : '还没有施展过魔法哦'}}</text>
        </view>
        <view wx:else class="patterns-grid">
          <view wx:for="{{subPagePatterns}}" wx:key="id" class="pattern-card">
            <view class="pattern-thumb" bindtap="onSubItemTap" data-item="{{item}}">
              <image wx:if="{{item.sourceUrl}}" class="pattern-thumb-img" src="{{item.sourceUrl}}" mode="aspectFill"/>
              <view wx:else class="pattern-thumb-ph">{{item.gridSize || 64}}x{{item.gridSize || 64}}</view>
              <view wx:if="{{item.sourceLabel}}" class="pattern-source-badge pattern-source-badge--{{item.sourceClass}}">
                <image wx:if="{{item.sourceClass==='ai'}}" class="pattern-source-icon" src="/assets/icons/lucide-sparkles-brown.svg" mode="aspectFit"/>
                <image wx:if="{{item.sourceClass==='free'}}" class="pattern-source-icon" src="/assets/icons/lucide-eye-blue.svg" mode="aspectFit"/>
                <image wx:if="{{item.sourceClass==='draft'}}" class="pattern-source-icon" src="/assets/icons/lucide-file-text-orange.svg" mode="aspectFit"/>
                <text>{{item.sourceLabel}}</text>
              </view>
            </view>
            <view class="pattern-body">
              <text class="pattern-name">{{item.name || ('图纸#'+item.id)}}</text>
              <view class="pattern-actions">
                <view class="pattern-view-btn" bindtap="onSubItemTap" data-item="{{item}}">
                  <image class="pattern-action-icon" src="/assets/icons/lucide-eye-blue.svg" mode="aspectFit"/>
                  <text>查看</text>
                </view>
                <view class="pattern-del-btn" catchtap="onSubDelete" data-id="{{item.id}}">⌫</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 帮助中心 -->
      <view wx:if="{{subPage==='feedback'}}" class="help-page">
        <!-- 常见问题 -->
        <view class="help-section">
          <view class="help-section-title-row">
            <view class="help-section-bar"></view>
            <text class="help-section-title">常见问题</text>
          </view>
          <view class="help-faq-list">
            <view wx:for="{{helpFaqs}}" wx:key="question" class="help-faq-item">
              <view class="help-faq-header">
                <text class="help-faq-question">{{item.question}}</text>
                <text class="help-faq-arrow">›</text>
              </view>
              <text class="help-faq-answer">{{item.answer}}</text>
            </view>
          </view>
        </view>

        <!-- 联系客服卡片 -->
        <view class="help-contact-card">
          <text class="help-contact-title">还有其他问题？</text>
          <text class="help-contact-desc">我们的客服团队随时为您服务</text>
          <view class="help-contact-btn" bindtap="onContactService">联系在线客服</view>
        </view>
      </view>

      <!-- 隐私政策 -->
      <view wx:if="{{subPage==='privacy'}}" class="privacy-page">
        <view class="privacy-content">
          <view class="privacy-section">
            <text class="privacy-section-title">隐私政策</text>
            <text class="privacy-update-time">更新日期：2026年5月9日</text>
          </view>

          <view class="privacy-section">
            <text class="privacy-subtitle">引言</text>
            <text class="privacy-text">欢迎使用魔法拼豆小程序（以下简称"本小程序"）。我们非常重视您的隐私保护和个人信息安全。本隐私政策将帮助您了解我们如何收集、使用、存储和保护您的个人信息。</text>
          </view>

          <view class="privacy-section">
            <text class="privacy-subtitle">一、我们收集的信息</text>
            <text class="privacy-text">为了向您提供更好的服务，我们可能会收集以下信息：</text>
            <text class="privacy-text">1. 账号信息：包括您的微信昵称、头像、手机号码等基本信息</text>
            <text class="privacy-text">2. 创作内容：您上传的图片、生成的拼豆图纸、草稿等创作数据</text>
            <text class="privacy-text">3. 使用数据：您在使用本小程序时产生的操作记录、访问日志等</text>
            <text class="privacy-text">4. 设备信息：设备型号、操作系统版本、网络状态等技术信息</text>
          </view>

          <view class="privacy-section">
            <text class="privacy-subtitle">二、信息的使用</text>
            <text class="privacy-text">我们收集的信息将用于以下目的：</text>
            <text class="privacy-text">1. 为您提供图纸生成、编辑、保存等核心功能服务</text>
            <text class="privacy-text">2. 改进和优化产品功能，提升用户体验</text>
            <text class="privacy-text">3. 进行数据分析和统计，了解产品使用情况</text>
            <text class="privacy-text">4. 保障账号安全，防止欺诈和滥用行为</text>
            <text class="privacy-text">5. 向您推送重要通知和服务消息</text>
          </view>

          <view class="privacy-section">
            <text class="privacy-subtitle">三、信息的存储与保护</text>
            <text class="privacy-text">1. 您的个人信息将存储在安全的服务器中，我们采用行业标准的安全技术和管理措施保护您的数据</text>
            <text class="privacy-text">2. 您的创作内容默认存储在云端，以便您在不同设备间同步访问</text>
            <text class="privacy-text">3. 我们会定期备份数据，防止数据丢失</text>
            <text class="privacy-text">4. 未经您的明确授权，我们不会向第三方分享、出售或披露您的个人信息</text>
          </view>

          <view class="privacy-section">
            <text class="privacy-subtitle">四、您的权利</text>
            <text class="privacy-text">您对自己的个人信息享有以下权利：</text>
            <text class="privacy-text">1. 访问权：您可以随时查看和管理您的个人信息</text>
            <text class="privacy-text">2. 更正权：您可以修改不准确或不完整的个人信息</text>
            <text class="privacy-text">3. 删除权：您可以通过"清除魔法痕迹"功能删除本地存储的数据</text>
            <text class="privacy-text">4. 撤回授权：您可以在小程序设置中撤回已授予的权限</text>
          </view>

          <view class="privacy-section">
            <text class="privacy-subtitle">五、第三方服务</text>
            <text class="privacy-text">本小程序可能使用第三方服务来提供部分功能（如AI图像生成、云存储等）。这些第三方服务提供商会按照其自身的隐私政策处理相关数据。我们会要求第三方服务商采取适当的安全措施保护您的信息。</text>
          </view>

          <view class="privacy-section">
            <text class="privacy-subtitle">六、未成年人保护</text>
            <text class="privacy-text">我们非常重视未成年人的个人信息保护。如果您是未成年人，请在监护人的陪同下阅读本政策，并在监护人同意后使用我们的服务。</text>
          </view>

          <view class="privacy-section">
            <text class="privacy-subtitle">七、政策更新</text>
            <text class="privacy-text">我们可能会不定期更新本隐私政策。更新后的政策将在小程序内公布，重大变更我们会通过显著方式通知您。继续使用本小程序即表示您同意更新后的隐私政策。</text>
          </view>

          <view class="privacy-section">
            <text class="privacy-subtitle">八、联系我们</text>
            <text class="privacy-text">如果您对本隐私政策有任何疑问、意见或建议，或需要行使您的个人信息权利，请通过以下方式联系我们：</text>
            <text class="privacy-text">• 在小程序内通过"帮助中心"联系在线客服</text>
            <text class="privacy-text">• 我们将在收到您的反馈后尽快处理并回复</text>
          </view>

          <view class="privacy-footer">
            <text class="privacy-footer-text">感谢您信任并使用魔法拼豆！</text>
          </view>
        </view>
      </view>


      <view style="height:180rpx"></view>
    </scroll-view>
  </view>

  <!-- ====== 弹窗蒙层 ====== -->
  <view wx:if="{{showMagicPanel || showGiftPanel || showTaskPanel || showSettingsPanel}}" class="modal-mask" bindtap="onCloseAllPanels"></view>

  <!-- AI魔法弹框 -->
  <view class="bottom-sheet {{showMagicPanel ? 'bottom-sheet--show' : ''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">AI魔法次数</text>
    <text class="sheet-sub-title">当前剩余魔法 {{magicCount}} 次，请及时使用</text>
    
    <view class="magic-info-box">
      <text class="magic-info-icon">ℹ</text>
      <text class="magic-info-text">所有途径获取的AI次数即时到账，除特殊情况外（特殊原因找客服售后）不可退款。</text>
    </view>

    <view class="sheet-list">
      <view class="sheet-link-row" bindtap="onShowTaskPanelFromMagic">
        <text class="sheet-link-text">做任务领取AI魔法次数奖励</text>
        <text class="sheet-link-arrow">›</text>
      </view>
      
      <view wx:if="{{!isVip}}" class="sheet-link-row" bindtap="onVip">
        <text class="sheet-link-text">充值会员得AI魔法次数</text>
        <text class="sheet-link-arrow">›</text>
      </view>
      
      <view class="sheet-link-row" bindtap="onGoCards">
        <text class="sheet-link-text">{{isVip ? '会员享折扣购AI魔法次卡' : '购买AI魔法次卡'}}</text>
        <text class="sheet-link-arrow">›</text>
      </view>
    </view>

    <view class="sheet-close-btn" bindtap="onCloseAllPanels">关闭</view>
  </view>

  <!-- 礼品包弹框 -->
  <view class="bottom-sheet {{showGiftPanel ? 'bottom-sheet--show' : ''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">我的礼品包</text>

    <view class="gift-tabs">
      <view
        wx:for="{{giftTabs}}"
        wx:key="key"
        class="gift-tab {{giftTab === item.key ? 'gift-tab--active' : ''}}"
        bindtap="onGiftTabChange"
        data-tab="{{item.key}}"
      >
        <text class="gift-tab-text">{{item.label}}</text>
        <text class="gift-tab-count">{{item.count}}</text>
      </view>
    </view>
    
    <view class="gift-list" wx:if="{{visibleGifts.length > 0}}">
      <view wx:for="{{visibleGifts}}" wx:key="id" class="gift-item {{item.itemClass}}">
        <view class="gift-info">
          <view class="gift-title-row">
            <text class="gift-title">{{item.giftName || item.title}}</text>
            <text class="gift-status gift-status--{{item.statusClass}}">{{item.statusText}}</text>
            <text wx:if="{{item.expiringSoon}}" class="gift-soon-tag">即将过期</text>
          </view>
          <text class="gift-subtitle">{{item.giftCategory || item.subtitle}}</text>
          <text wx:if="{{item.expireText}}" class="gift-expire">有效期至：{{item.expireText}}</text>
          <text wx:if="{{item.giftCode === 'GIFT_PACKAGE'}}" class="gift-tip">礼包已入包，可稍后在此兑换</text>
        </view>
        <view wx:if="{{item.canUse}}" class="gift-use-btn" bindtap="onUseGift" data-gift="{{item}}">{{item.giftCode === 'GIFT_PACKAGE' ? '立即兑换' : '使用'}}</view>
      </view>
    </view>
    <view wx:else class="gift-empty">
      <text class="gift-empty-icon">🎁</text>
      <text class="gift-empty-text">当前分类下暂无礼品</text>
    </view>

    <view class="sheet-close-btn" bindtap="onCloseAllPanels">关闭</view>
  </view>

  <!-- 任务中心弹框 -->
  <view class="bottom-sheet {{showTaskPanel ? 'bottom-sheet--show' : ''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">任务中心</text>

    <!-- 签到区域 -->
    <view class="checkin-section">
      <view class="checkin-header">
        <text class="checkin-title">📅 每日签到</text>
        <text class="checkin-desc">连续签到{{checkinStatus.requiredDays}}天可领取奖励</text>
      </view>

      <view class="checkin-summary-card">
        <view class="checkin-main-row">
          <view class="checkin-main-block">
            <text class="checkin-main-value">{{checkinStatus.continuousDays || 0}}</text>
            <text class="checkin-main-label">已连续签到（天）</text>
          </view>
          <view class="checkin-main-divider"></view>
          <view class="checkin-main-block">
            <text class="checkin-main-value">{{checkinStatus.canClaim ? 0 : ((checkinStatus.requiredDays || 3) - (checkinStatus.continuousDays || 0))}}</text>
            <text class="checkin-main-label">距离领奖还差（天）</text>
          </view>
        </view>

        <view class="checkin-tips-row">
          <text class="checkin-tip-text">累计签到 {{checkinStatus.totalDays || 0}} 天</text>
          <text wx:if="{{checkinStatus.canClaim}}" class="checkin-tip-text checkin-tip-text--highlight">已达标，可领取奖励</text>
          <text wx:elif="{{checkinStatus.checkedInToday}}" class="checkin-tip-text">今天已签到，继续保持</text>
          <text wx:else class="checkin-tip-text">今天还没签到，记得打卡</text>
        </view>
      </view>

      <view class="checkin-actions">
        <button
          wx:if="{{!checkinStatus.checkedInToday}}"
          class="checkin-btn"
          bindtap="onCheckin">
          立即签到
        </button>
        <button
          wx:else
          class="checkin-btn checkin-btn--disabled"
          disabled>
          今日已签到
        </button>

        <button
          wx:if="{{checkinStatus.canClaim}}"
          class="claim-btn"
          bindtap="onClaimCheckinReward">
          领取奖励 +{{checkinStatus.rewardValue}}次AI
        </button>
      </view>
    </view>

    <!-- 任务列表 -->
    <view class="task-list">
      <view class="task-section-title">🎯 每日任务</view>

      <view wx:for="{{tasks}}" wx:key="id" class="task-item">
        <view class="task-info">
          <text class="task-name">{{item.taskName}}</text>
          <text class="task-desc">{{item.description}}</text>
          <text class="task-reward">{{item.rewardText}}</text>
        </view>
        <view class="task-progress">
          <text class="progress-text">{{item.progressDisplay || item.progressText || ((item.currentCount || 0) + '/' + (item.targetCount || 1))}}</text>
        </view>
        <view wx:if="{{item.status === 2}}" class="task-done-btn">已完成</view>
        <view wx:elif="{{item.status === 1}}" class="task-claim-btn" bindtap="onDoTask" data-task="{{item}}">{{item.actionText || '领取'}}</view>
        <view wx:else class="task-do-btn" bindtap="onDoTask" data-task="{{item}}">{{item.actionText || '去完成'}}</view>
      </view>
    </view>

    <view class="sheet-close-btn" bindtap="onCloseAllPanels">关闭</view>
  </view>

  <!-- 设置弹框 -->
  <view class="bottom-sheet {{showSettingsPanel ? 'bottom-sheet--show' : ''}}">
    <view class="sheet-handle"></view>
    <view class="settings-header">
      <text class="sheet-title">魔法设置</text>
      <view class="settings-close" bindtap="onCloseAllPanels">✕</view>
    </view>
    
    <view class="settings-list">
      <!-- 水印开关 -->
      <view class="settings-row">
        <view class="settings-row-left">
          <view class="settings-row-title-row">
            <text class="settings-row-title">图纸水印</text>
            <text class="settings-vip-tag">VIP</text>
          </view>
          <text class="settings-row-desc">非会员默认开启图纸水印</text>
        </view>
        <switch class="settings-switch" checked="{{watermarkEnabled}}" bindchange="onWatermarkChange" color="#4CAF50"/>
      </view>

      <!-- 自定义水印 -->
      <view class="settings-row" bindtap="onCustomWatermarkTap">
        <view class="settings-row-left">
          <view class="settings-row-title-row">
            <text class="settings-row-title">自定义水印内容</text>
            <text class="settings-vip-tag">VIP</text>
          </view>
          <input class="settings-input {{isVip ? '' : 'settings-input-disabled'}}" 
            type="text" 
            value="{{watermarkText}}" 
            placeholder="输入您的专属印记"
            maxlength="15"
            disabled="{{!isVip}}"
            bindinput="onWatermarkTextChange"/>
          <text class="settings-row-hint">最多15个字符</text>
        </view>
      </view>
    </view>

    <view class="settings-confirm-btn" bindtap="onConfirmSettings">完成设置</view>
  </view>

</view>
