<view class="profile-page">
  <!-- 安全区域占位 -->
  <view style="height: {{statusBarHeight}}px; width: 100%;"></view>
  
  <!-- 头部黄色区域 -->
  <view class="header-zone">
    <view class="header-top">
      <view style="width:60rpx"></view>
      <view class="bell-wrap">
        <text class="bell-icon">🔔</text>
        <view class="bell-dot"></view>
      </view>
    </view>
    <view class="user-row" bindtap="onEditProfile">
      <view class="avatar-wrap">
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
        <view wx:else class="avatar-ph">👤</view>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || '魔法师小豆'}}</text>
        <view class="user-tags">
          <text class="{{isVip ? 'tag-vip' : 'tag-normal'}}">{{isVip ? '✨ 至尊魔法会员' : '普通魔法学徒'}}</text>
          <text class="phone-tag" wx:if="{{phone}}">{{phone}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计卡片（悬浮）-->
  <view class="stats-card">
    <view class="stat-item" bindtap="onShowMagicPanel">
      <text class="stat-num">{{magicCount}}</text>
      <text class="stat-label">✨ AI魔法</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onShowGiftPanel">
      <text class="stat-num">{{gifts.length}}</text>
      <text class="stat-label">🎁 礼品包</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onShowTaskPanel">
      <text class="stat-num">{{pendingTaskCount}}</text>
      <text class="stat-label">⭐ 任务中心</text>
    </view>
  </view>

  <scroll-view scroll-y class="scroll-body">

    <!-- VIP卡 -->
    <view class="vip-card" bindtap="onVip">
      <view class="vip-left">
        <text class="vip-title">👑 {{isVip ? '至尊魔法会员' : '升级至尊魔法会员'}}</text>
        <text class="vip-sub">纯净无广告·AI生图次数·定制化水印</text>
      </view>
      <view class="vip-btn">立即开通</view>
    </view>

    <!-- 我的创作空间 -->
    <view class="section-card">
      <view class="section-title-row">
        <view class="section-bar"></view>
        <text class="section-title">我的创作中心</text>
      </view>
      <view class="action-grid">
        <view class="action-item" bindtap="onGoMyPatterns">
          <view class="action-icon blue">📁</view>
          <text class="action-label">图纸箱</text>
        </view>
        <view class="action-item" bindtap="onGoHistory">
          <view class="action-icon orange">🕐</view>
          <text class="action-label">时光机</text>
        </view>
        <view class="action-item" bindtap="onGoDraft">
          <view class="action-icon purple">📝</view>
          <text class="action-label">草稿箱</text>
        </view>
      </view>
    </view>

    <!-- 菜单列表 -->
    <view class="menu-card">
      <view class="menu-item" bindtap="onShowFeedback">
        <view class="menu-left">
          <view class="menu-icon" style="background:#E8F5E9;color:#4CAF50">ℹ</view>
          <text class="menu-title">用户反馈</text>
        </view>
        <view class="menu-right"><text class="menu-arrow">›</text></view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="onShowSettings">
        <view class="menu-left">
          <view class="menu-icon" style="background:#ECEFF1;color:#607D8B">⚙</view>
          <text class="menu-title">设置</text>
        </view>
        <view class="menu-right"><text class="menu-arrow">›</text></view>
      </view>
    </view>

    <view style="height:120rpx"></view>
  </scroll-view>

  <!-- ====== 子页 ====== -->
  <view class="sub-page {{subPage?'sub-page--show':''}}">
    <view class="sub-header" style="padding-top: {{subTopSafePx}}px; min-height: {{subHeaderHeightPx}}px;">
      <view class="sub-back" bindtap="onCloseSubPage">←</view>
      <text class="sub-title">{{subPage==='patterns'?'图纸箱':subPage==='history'?'时光机':subPage==='feedback'?'帮助与反馈':subPage==='privacy'?'隐私安全':subPage==='account'?'账号设置':'回收站'}}</text>
      <view class="sub-action" wx:if="{{subPage==='history'}}" bindtap="onSubClearHistory">清空</view>
    </view>

    <scroll-view scroll-y class="sub-scroll">
      <!-- 图纸箱 -->
      <view wx:if="{{subPage==='patterns'}}" class="sub-list">
        <view wx:if="{{subPagePatterns.length===0}}" class="sub-empty">还没有施展过魔法哦</view>
        <view wx:for="{{subPagePatterns}}" wx:key="id" class="sub-item" bindtap="onSubItemTap" data-item="{{item}}">
          <view class="sub-thumb">
            <image wx:if="{{item.patternUrl}}" class="sub-thumb-img" src="{{item.patternUrl}}" mode="aspectFill"/>
            <view wx:else class="sub-thumb-ph">🖼</view>
          </view>
          <view class="sub-info">
            <text class="sub-name">{{item.patternName || ('魔法图纸#'+item.id)}}</text>
            <text class="sub-meta">拼豆图纸 · {{item.createdAt}}</text>
          </view>
          <view class="sub-del" catchtap="onSubDelete" data-id="{{item.id}}">🗑</view>
        </view>
      </view>

      <!-- 时光机 -->
      <view wx:if="{{subPage==='history'}}" class="sub-list">
        <view wx:if="{{subPageHistory.length===0}}" class="sub-empty">时光机里没有草稿哦</view>
        <view wx:for="{{subPageHistory}}" wx:key="id" class="sub-item" bindtap="onSubItemTap" data-item="{{item}}">
          <view class="sub-thumb">
            <image wx:if="{{item.resultUrl}}" class="sub-thumb-img" src="{{item.resultUrl}}" mode="aspectFill"/>
            <view wx:else class="sub-thumb-ph">🖼</view>
          </view>
          <view class="sub-info">
            <text class="sub-name">恢复编辑 {{item.gridSize || 0}}格</text>
            <text class="sub-meta">{{item.createdAt}}</text>
          </view>
          <view class="sub-go">继续</view>
        </view>
      </view>

      <!-- 用户反馈 -->
      <view wx:if="{{subPage==='feedback'}}" class="feedback-page">
        <view class="feedback-tutorial-card">
          <view class="feedback-tutorial-icon">🎬</view>
          <view class="feedback-tutorial-texts">
            <text class="feedback-tutorial-title">新手魔法教程</text>
            <text class="feedback-tutorial-desc">3分钟快速精通拼豆魔法</text>
          </view>
          <text class="feedback-tutorial-arrow">›</text>
        </view>
        <view class="feedback-section">
          <text class="feedback-label">写下你的建议</text>
          <textarea class="feedback-input" placeholder="有什么问题或者新想法，告诉小豆吧..." value="{{feedbackText}}" bindinput="onFeedbackInput" maxlength="200"/>
          <view class="feedback-send-btn" bindtap="onSendFeedback">发送给小豆 ✉</view>
        </view>
      </view>

      <!-- 隐私安全 -->
      <view wx:if="{{subPage==='privacy'}}" class="privacy-page">
        <view class="privacy-row">
          <view class="privacy-row-left">
            <text class="privacy-row-title">图片云端处理</text>
            <text class="privacy-row-desc">开启后生图速度更快</text>
          </view>
          <switch class="privacy-switch" checked="{{cloudProcess}}" bindchange="onCloudProcessChange" color="#FF9800"/>
        </view>
        <view class="privacy-row privacy-row-danger" bindtap="onClearTrace">
          <view class="privacy-row-left">
            <text class="privacy-row-title danger">清除魔法痕迹</text>
            <text class="privacy-row-desc danger">删除所有本地记录与图纸</text>
          </view>
          <text class="privacy-row-icon">🧹</text>
        </view>
      </view>

      <!-- 账号设置 -->
      <view wx:if="{{subPage==='account'}}" class="account-page">
        <view class="account-row">
          <view class="account-row-left">
            <text class="account-row-icon">📱</text>
            <text class="account-row-title">绑定手机号</text>
          </view>
          <text class="account-row-value">{{phone || '未绑定'}}</text>
        </view>
        <view class="account-row account-row-danger" bindtap="onLogout">
          <text class="account-row-icon">🚪</text>
          <text class="account-row-title danger">退出登录</text>
        </view>
      </view>

      <!-- 回收站 -->
      <view wx:if="{{subPage==='recycle'}}" class="sub-list">
        <view wx:if="{{subPageRecycle.length===0}}" class="sub-empty">这里空空如也，魔法很干净</view>
        <view wx:for="{{subPageRecycle}}" wx:key="id" class="sub-item" bindtap="onSubItemTap" data-item="{{item}}">
          <view class="sub-thumb">
            <image wx:if="{{item.patternUrl}}" class="sub-thumb-img" src="{{item.patternUrl}}" mode="aspectFill"/>
            <view wx:else class="sub-thumb-ph">🖼</view>
          </view>
          <view class="sub-info">
            <text class="sub-name">{{item.patternName || '未命名作品'}}</text>
            <text class="sub-meta">剩 {{item.daysLeft || 30}} 天</text>
          </view>
          <view class="sub-restore" catchtap="onSubRestore" data-id="{{item.id}}">↩</view>
        </view>
      </view>

      <view style="height:180rpx"></view>
    </scroll-view>
  </view>

  <!-- ====== 弹窗蒙层 ====== -->
  <view wx:if="{{showMagicPanel || showGiftPanel || showTaskPanel || showSettingsPanel}}" class="modal-mask" bindtap="onCloseAllPanels"></view>

  <!-- AI魔法弹框 -->
  <view class="bottom-sheet {{showMagicPanel ? 'bottom-sheet--show' : ''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">AI魔法次数</text>
    <text class="sheet-sub-title">当前剩余魔法 {{magicCount}} 次，请及时使用</text>
    
    <view class="magic-info-box">
      <text class="magic-info-icon">ℹ</text>
      <text class="magic-info-text">所有途径获取的AI次数即时到账，除特殊情况外（特殊原因找客服售后）不可退款。</text>
    </view>

    <view class="sheet-list">
      <view class="sheet-link-row" bindtap="onShowTaskPanelFromMagic">
        <text class="sheet-link-text">做任务领取AI魔法次数奖励</text>
        <text class="sheet-link-arrow">›</text>
      </view>
      
      <view wx:if="{{!isVip}}" class="sheet-link-row" bindtap="onVip">
        <text class="sheet-link-text">充值会员得AI魔法次数</text>
        <text class="sheet-link-arrow">›</text>
      </view>
      
      <view class="sheet-link-row" bindtap="onGoCards">
        <text class="sheet-link-text">{{isVip ? '会员享折扣购AI魔法次卡' : '购买AI魔法次卡'}}</text>
        <text class="sheet-link-arrow">›</text>
      </view>
    </view>

    <view class="sheet-close-btn" bindtap="onCloseAllPanels">关闭</view>
  </view>

  <!-- 礼品包弹框 -->
  <view class="bottom-sheet {{showGiftPanel ? 'bottom-sheet--show' : ''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">我的礼品包</text>
    
    <view class="gift-list" wx:if="{{gifts.length > 0}}">
      <view wx:for="{{gifts}}" wx:key="id" class="gift-item">
        <view class="gift-info">
          <text class="gift-title">{{item.title}}</text>
          <text class="gift-subtitle">{{item.subtitle}}</text>
        </view>
        <view class="gift-use-btn" bindtap="onUseGift" data-gift="{{item}}">使用</view>
      </view>
    </view>
    <view wx:else class="gift-empty">
      <text class="gift-empty-icon">🎁</text>
      <text class="gift-empty-text">暂未获得礼品</text>
    </view>

    <view class="sheet-close-btn" bindtap="onCloseAllPanels">关闭</view>
  </view>

  <!-- 任务中心弹框 -->
  <view class="bottom-sheet {{showTaskPanel ? 'bottom-sheet--show' : ''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">任务中心</text>
    
    <view class="task-list">
      <!-- 打卡任务 -->
      <view class="task-item task-item-special">
        <view class="task-info">
          <text class="task-name">连续打卡 {{checkedIn ? 1 : 0}}/3 天</text>
          <text class="task-reward">可获得 3次 AI魔法</text>
        </view>
        <view wx:if="{{checkedIn}}" class="task-done-btn">已打卡</view>
        <view wx:else class="task-do-btn" bindtap="onCheckIn">打卡</view>
      </view>

      <!-- 其他任务 -->
      <view wx:for="{{tasks}}" wx:key="id" class="task-item">
        <view class="task-info">
          <text class="task-name">{{item.name}}</text>
          <text class="task-reward">{{item.reward}}</text>
        </view>
        <view wx:if="{{item.done}}" class="task-done-btn">已完成</view>
        <view wx:else class="task-do-btn" bindtap="onDoTask" data-task="{{item}}">{{item.actionText}}</view>
      </view>

      <!-- 首次开通会员 -->
      <view class="task-item">
        <view class="task-info">
          <text class="task-name">首次开通会员</text>
          <text class="task-reward">奖励 10次 AI魔法</text>
        </view>
        <view class="task-do-btn" bindtap="onVip">去开通</view>
      </view>
    </view>

    <view class="sheet-close-btn" bindtap="onCloseAllPanels">关闭</view>
  </view>

  <!-- 设置弹框 -->
  <view class="bottom-sheet {{showSettingsPanel ? 'bottom-sheet--show' : ''}}">
    <view class="sheet-handle"></view>
    <view class="settings-header">
      <text class="sheet-title">魔法设置</text>
      <view class="settings-close" bindtap="onCloseAllPanels">✕</view>
    </view>
    
    <view class="settings-list">
      <!-- 水印开关 -->
      <view class="settings-row">
        <view class="settings-row-left">
          <view class="settings-row-title-row">
            <text class="settings-row-title">图纸水印</text>
            <text class="settings-vip-tag">VIP</text>
          </view>
          <text class="settings-row-desc">非会员默认开启图纸水印</text>
        </view>
        <switch class="settings-switch" checked="{{watermarkEnabled}}" bindchange="onWatermarkChange" color="#4CAF50"/>
      </view>

      <!-- 自定义水印 -->
      <view class="settings-row" bindtap="{{isVip ? '' : 'onVip'}}">
        <view class="settings-row-left">
          <view class="settings-row-title-row">
            <text class="settings-row-title">自定义水印内容</text>
            <text class="settings-vip-tag">VIP</text>
          </view>
          <input class="settings-input {{isVip ? '' : 'settings-input-disabled'}}" 
            type="text" 
            value="{{watermarkText}}" 
            placeholder="输入您的专属印记"
            maxlength="15"
            disabled="{{!isVip}}"
            bindinput="onWatermarkTextChange"/>
          <text class="settings-row-hint">最多15个字符</text>
        </view>
      </view>
    </view>

    <view class="settings-confirm-btn" bindtap="onConfirmSettings">完成设置</view>
  </view>

</view>
