<view class="container">

  <!-- 头部黄色区域 -->
  <view class="header-zone" style="padding-top: {{profileTopPaddingPx}}px;">
    <view class="header-top">
      <view style="width:60rpx"></view>
      <view class="bell-wrap" bindtap="onGoHistory">
        <text class="bell-icon">🔔</text>
        <view class="bell-dot"></view>
      </view>
    </view>
    <view class="user-row" bindtap="onEditProfile">
      <view class="avatar-wrap">
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
        <view wx:else class="avatar-ph">👤</view>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || '魔法师小豆'}}</text>
        <view class="user-tags">
          <text class="tag-normal">普通魔法学徒</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计卡片（悬浮）-->
  <view class="stats-card">
    <view class="stat-item" bindtap="onGoMyPatterns">
      <text class="stat-num">{{stats.ai || 0}}</text>
      <text class="stat-label">✨ AI魔法</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">2</text>
      <text class="stat-label">🎁 礼品包</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onGoMyPatterns">
      <text class="stat-num">{{stats.saved || 0}}</text>
      <text class="stat-label">📁 魔法图</text>
    </view>
  </view>

  <scroll-view scroll-y class="scroll-body">

    <!-- VIP卡 -->
    <view class="vip-card" bindtap="onVip">
      <view class="vip-left">
        <text class="vip-title">👑 解锁高级魔法</text>
        <text class="vip-sub">无广告 · 高清导出 · 无限AI</text>
      </view>
      <view class="vip-btn">立即开通</view>
    </view>

    <!-- 我的创作空间 -->
    <view class="section-card">
      <view class="section-title-row">
        <view class="section-bar"></view>
        <text class="section-title">我的创作空间</text>
      </view>
      <view class="action-grid">
        <view class="action-item" bindtap="onGoMyPatterns">
          <view class="action-icon blue">📁</view>
          <text class="action-label">图纸箱</text>
        </view>
        <view class="action-item" bindtap="onGoHistory">
          <view class="action-icon orange">🕐</view>
          <text class="action-label">时光机</text>
        </view>
        <view class="action-item">
          <view class="action-icon red">⭐</view>
          <text class="action-label">收藏夹</text>
        </view>
      </view>
    </view>

    <!-- 菜单列表 -->
    <view class="menu-card">
      <view class="menu-item" bindtap="onCreator">
        <view class="menu-left">
          <text class="menu-icon" style="background:#F3E5F5;color:#9C27B0">🎨</text>
          <text class="menu-title">创作者中心</text>
        </view>
        <view class="menu-right"><text class="menu-sub">上传赚金币</text><text class="menu-arrow">›</text></view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="onHelp">
        <view class="menu-left">
          <text class="menu-icon" style="background:#E8F5E9;color:#4CAF50">ℹ</text>
          <text class="menu-title">帮助与反馈</text>
        </view>
        <view class="menu-right"><text class="menu-arrow">›</text></view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="onPrivacy">
        <view class="menu-left">
          <text class="menu-icon" style="background:#E1F5FE;color:#03A9F4">🔒</text>
          <text class="menu-title">隐私安全</text>
        </view>
        <view class="menu-right"><text class="menu-arrow">›</text></view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="onAccountSettings">
        <view class="menu-left">
          <text class="menu-icon" style="background:#ECEFF1;color:#607D8B">⚙</text>
          <text class="menu-title">账号设置</text>
        </view>
        <view class="menu-right"><text class="menu-arrow">›</text></view>
      </view>
    </view>

    <view style="height:120rpx"></view>
  </scroll-view>

  <!-- ====== 内嵌子页（TabBar保持不动） ====== -->
  <view class="sub-page {{subPage?'sub-page--show':''}}">
    <view class="sub-header" style="padding-top: {{subTopSafePx}}px; min-height: {{subHeaderHeightPx}}px;">
      <view class="sub-back" bindtap="onCloseSubPage">←</view>
      <text class="sub-title">{{subPage==='patterns'?'图纸箱':'时光机'}}</text>
      <view class="sub-action" wx:if="{{subPage==='history'}}" bindtap="onSubClearHistory">清空</view>
      <view class="sub-action" wx:elif="{{subPage==='patterns'}}"></view>
    </view>

    <scroll-view scroll-y class="sub-scroll">
      <view wx:if="{{subPageLoading}}" class="sub-loading">加载中...</view>

      <view wx:if="{{subPage==='patterns' && !subPageLoading && subPagePatterns.length===0}}" class="sub-empty">
        <text>还没有图纸，快去生成吧</text>
      </view>
      <view wx:if="{{subPage==='history' && !subPageLoading && subPageHistory.length===0}}" class="sub-empty">
        <text>还没有历史记录</text>
      </view>

      <view wx:if="{{subPage==='patterns'}}" class="sub-list">
        <view wx:for="{{subPagePatterns}}" wx:key="taskId" class="sub-item">
          <view class="sub-thumb" bindtap="onSubItemTap" data-item="{{item}}">
            <image wx:if="{{item.patternUrl}}" class="sub-thumb-img" src="{{item.patternUrl}}" mode="aspectFill"/>
            <image wx:elif="{{item.resultUrl}}" class="sub-thumb-img" src="{{item.resultUrl}}" mode="aspectFill"/>
            <view wx:else class="sub-thumb-ph">🖼</view>
          </view>
          <view class="sub-info" bindtap="onSubItemTap" data-item="{{item}}">
            <text class="sub-name">{{item.patternName || ('魔法图纸#'+item.taskId)}}</text>
            <text class="sub-meta">拼豆图纸 · {{item.createdAt}}</text>
          </view>
          <view class="sub-del" bindtap="onSubDelete" data-taskid="{{item.taskId}}">🗑</view>
        </view>
      </view>

      <view wx:if="{{subPage==='history'}}" class="sub-list">
        <view wx:for="{{subPageHistory}}" wx:key="taskId" class="sub-item" bindtap="onSubItemTap" data-item="{{item}}">
          <view class="sub-thumb">
            <image wx:if="{{item.resultUrl}}" class="sub-thumb-img" src="{{item.resultUrl}}" mode="aspectFill"/>
            <view wx:else class="sub-thumb-ph">🖼</view>
          </view>
          <view class="sub-info">
            <text class="sub-name">恢复编辑 {{item.gridSize}}格</text>
            <text class="sub-meta">{{item.createdAt}}</text>
          </view>
          <view class="sub-go">继续</view>
        </view>
      </view>

      <view style="height:180rpx"></view>
    </scroll-view>
  </view>

  <!-- ====== 子页弹窗 ====== -->

  <!-- 遮罩 -->
  <view wx:if="{{activeSheet}}" class="sheet-mask" bindtap="onCloseSheet"></view>

  <!-- 账号设置 -->
  <view class="bottom-sheet {{activeSheet==='account'?'bottom-sheet--show':''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">账号设置</text>
    <view class="sheet-list">
      <view class="sheet-row" bindtap="onBindPhone">
        <view class="sheet-row-left">
          <text class="sheet-row-icon">📱</text>
          <text class="sheet-row-label">绑定手机号</text>
        </view>
        <text class="sheet-row-arrow">›</text>
      </view>
      <view class="sheet-divider"></view>
      <view class="sheet-row sheet-row--danger" bindtap="onLogout">
        <view class="sheet-row-left">
          <text class="sheet-row-icon">🚪</text>
          <text class="sheet-row-label danger">退出登录</text>
        </view>
        <text class="sheet-row-arrow">›</text>
      </view>
    </view>
    <view class="sheet-cancel" bindtap="onCloseSheet">取消</view>
  </view>

  <!-- 隐私安全 -->
  <view class="bottom-sheet {{activeSheet==='privacy'?'bottom-sheet--show':''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">隐私安全</text>
    <view class="sheet-list">
      <view class="sheet-row">
        <view class="sheet-row-left">
          <text class="sheet-row-icon">☁</text>
          <view class="sheet-row-texts">
            <text class="sheet-row-label">图片云端处理</text>
            <text class="sheet-row-desc">上传图片将在云端处理后删除</text>
          </view>
        </view>
        <switch class="sheet-switch" checked="{{cloudProcess}}" bindchange="onCloudProcessChange" color="#FF9800"/>
      </view>
      <view class="sheet-divider"></view>
      <view class="sheet-row" bindtap="onClearTrace">
        <view class="sheet-row-left">
          <text class="sheet-row-icon">🧹</text>
          <view class="sheet-row-texts">
            <text class="sheet-row-label">清除魔法痕迹</text>
            <text class="sheet-row-desc">清除本地缓存和使用记录</text>
          </view>
        </view>
        <text class="sheet-row-arrow">›</text>
      </view>
    </view>
    <view class="sheet-cancel" bindtap="onCloseSheet">关闭</view>
  </view>

  <!-- 帮助与反馈 -->
  <view class="bottom-sheet {{activeSheet==='help'?'bottom-sheet--show':''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">帮助与反馈</text>
    <view class="sheet-list">
      <view class="sheet-tutorial-card">
        <text class="tutorial-icon">🪄</text>
        <view class="tutorial-texts">
          <text class="tutorial-title">新手魔法教程</text>
          <text class="tutorial-desc">5分钟学会拼豆图纸生成</text>
        </view>
        <text class="tutorial-arrow">›</text>
      </view>
      <view class="sheet-divider"></view>
      <text class="feedback-label">写下你的建议</text>
      <textarea class="feedback-input" placeholder="你的建议是我们进步的魔法源泉～" value="{{feedbackText}}" bindinput="onFeedbackInput" maxlength="200"/>
      <view class="feedback-send-btn" bindtap="onSendFeedback">发送给小豆 ✉</view>
    </view>
  </view>

  <!-- 创作者中心 -->
  <view class="bottom-sheet {{activeSheet==='creator'?'bottom-sheet--show':''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">创作者中心</text>
    <view class="creator-income-card">
      <text class="income-label">累计收益（金币）</text>
      <text class="income-num">{{creatorIncome}}</text>
      <view class="income-withdraw-btn">申请提现</view>
    </view>
    <view class="sheet-list">
      <view class="sheet-row" bindtap="onUploadPattern">
        <view class="sheet-row-left">
          <text class="sheet-row-icon">⬆</text>
          <view class="sheet-row-texts">
            <text class="sheet-row-label">上传原创图纸</text>
            <text class="sheet-row-desc">每次被下载可获得金币奖励</text>
          </view>
        </view>
        <text class="sheet-row-arrow">›</text>
      </view>
      <view class="sheet-divider"></view>
      <view class="sheet-row">
        <view class="sheet-row-left">
          <text class="sheet-row-icon">📊</text>
          <view class="sheet-row-texts">
            <text class="sheet-row-label">我的作品数据</text>
            <text class="sheet-row-desc">查看下载量和收益明细</text>
          </view>
        </view>
        <text class="sheet-row-arrow">›</text>
      </view>
    </view>
    <view class="sheet-cancel" bindtap="onCloseSheet">关闭</view>
  </view>

</view>
