/* profile.wxss - 暖色系风格 */

.profile-page {
  min-height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
}

/* ─── 头部黄色区域 ─── */
.header-zone {
  background: #FFEBB5;
  padding: 0 40rpx 80rpx;
  border-radius: 0 0 60rpx 60rpx;
  border-bottom: 4rpx solid #FFD54F;
  flex-shrink: 0;
  box-sizing: border-box;
}

.header-top {
  height: 20rpx;
  margin-bottom: 8rpx;
}

.bell-wrap { display: none; }
.bell-icon { font-size: 48rpx; color: #5D4037; }
.bell-dot {
  position: absolute; top: 8rpx; right: 8rpx;
  width: 16rpx; height: 16rpx;
  background: #FF6B6B;
  border-radius: 50%;
  border: 3rpx solid #FFEBB5;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.avatar-wrap {
  width: 128rpx; height: 128rpx;
  border-radius: 36rpx;
  background: rgba(255,255,255,0.6);
  border: 4rpx solid #fff;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(255,160,0,0.2);
  transform: rotate(-3deg);
}

.avatar { width: 128rpx; height: 128rpx; }
.avatar-ph {
  width: 128rpx; height: 128rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx;
}

.user-info { display: flex; flex-direction: column; gap: 12rpx; }
.user-name { font-size: 44rpx; font-weight: 700; color: #5D4037; }
.user-tags { display: flex; gap: 12rpx; flex-wrap: wrap; align-items: center;}

.tag-normal {
  font-size: 22rpx; font-weight: 700; color: #FF9800;
  background: #fff;
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.tag-vip {
  font-size: 22rpx; font-weight: 700; color: #5D4037;
  background: linear-gradient(135deg, #FFD54F, #FFB74D);
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(255,152,0,0.2);
}

.phone-tag {
  font-size: 22rpx; font-weight: 700; color: #A1887F;
}

/* ─── 统计卡片 ─── */
.stats-card {
  margin: -60rpx 32rpx 24rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 32rpx;
  display: flex;
  box-shadow: 0 16rpx 60rpx rgba(140,107,75,0.1);
  border: 2rpx solid #FFF4DC;
  position: relative; z-index: 10;
}

.stat-item {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; gap: 8rpx;
}

.stat-item:active { transform: scale(0.95); }

.stat-num { font-size: 40rpx; font-weight: 700; color: #5D4037; }
.stat-label { font-size: 22rpx; font-weight: 700; color: #A1887F; }
.stat-divider { width: 2rpx; background: #FFF4DC; margin: 8rpx 0; }

/* ─── 滚动区域 ─── */
.scroll-body { flex: 1; }

/* ─── VIP 卡 ─── */
.vip-card {
  margin: 0 32rpx 24rpx;
  background: linear-gradient(135deg, #212121, #3E2723);
  border-radius: 40rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 16rpx 60rpx rgba(0,0,0,0.18);
  border-bottom: 4rpx solid #1A1A1A;
}

.vip-card:active { transform: translateY(2rpx); }

.vip-left { display: flex; flex-direction: column; gap: 12rpx; }
.vip-title { font-size: 36rpx; font-weight: 700; color: #FFD54F; }
.vip-sub   { font-size: 22rpx; color: #A1887F; }

.vip-btn {
  background: linear-gradient(135deg, #FFD54F, #FF9800);
  color: #3E2723;
  font-size: 26rpx;
  font-weight: 700;
  padding: 20rpx 36rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(255,152,0,0.3);
}

/* ─── 创作空间卡片 ─── */
.section-card {
  margin: 0 32rpx 24rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(140,107,75,0.06);
  border: 2rpx solid #FFF4DC;
}

.section-title-row {
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 32rpx;
}

.section-bar {
  width: 6rpx; height: 32rpx;
  background: #FF9800;
  border-radius: 4rpx;
}

.section-title { font-size: 28rpx; font-weight: 700; color: #5D4037; }

.action-grid {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}

.action-item {
  display: flex; flex-direction: column;
  align-items: center; gap: 16rpx;
  min-width: 128rpx;
}

.action-item:active { transform: scale(0.93); }

.action-icon {
  width: 112rpx; height: 112rpx;
  border-radius: 36rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx;
}

.action-icon.blue   { background: #E3F2FD; }
.action-icon.orange { background: #FFF3E0; }
.action-icon.purple { background: #F3E5F5; }

.action-label { font-size: 24rpx; font-weight: 700; color: #8C6B4B; }

/* ─── 菜单卡片 ─── */
.menu-card {
  margin: 0 32rpx 24rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 12rpx;
  box-shadow: 0 8rpx 30rpx rgba(140,107,75,0.06);
  border: 2rpx solid #FFF4DC;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 32rpx;
}

.menu-item:active { background: #FFEBB5; }

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}

.menu-title { font-size: 28rpx; font-weight: 700; color: #5D4037; }

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-arrow { font-size: 40rpx; color: #D0B8A1; }
.menu-divider { height: 2rpx; background: #FFF9ED; margin: 0 24rpx; }

/* ─── 子页 ─── */
.sub-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  background: #FFF9ED;
  z-index: 40;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  display: flex;
  flex-direction: column;
}

.sub-page--show {
  transform: translateY(0);
}

.sub-header {
  padding: 0 28rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #FFF4DC;
  background: #FFF9ED;
  flex-shrink: 0;
}

.sub-back { font-size: 42rpx; color: #8C6B4B; width: 72rpx; }
.sub-title { font-size: 32rpx; font-weight: 800; color: #5D4037; }
.sub-action { font-size: 24rpx; color: #FF6B6B; width: 72rpx; text-align: right; }

.sub-scroll { flex: 1; }
.sub-loading, .sub-empty {
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #A1887F;
  font-size: 26rpx;
}

.sub-list { padding: 24rpx 32rpx; }
.sub-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(140,107,75,0.06);
}

.sub-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: #FFF4DC;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.sub-thumb-img { width: 100%; height: 100%; }
.sub-thumb-ph { font-size: 48rpx; }

.sub-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.sub-name { font-size: 26rpx; font-weight: 700; color: #5D4037; }
.sub-meta { font-size: 20rpx; color: #A1887F; }
.sub-del { font-size: 32rpx; color: #D0B8A1; padding: 8rpx; }
.sub-go {
  background: #FF9800;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.sub-restore {
  background: #E8F5E9;
  color: #4CAF50;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* ─── 弹窗蒙层 ─── */
.modal-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.4);
  z-index: 50;
}

/* ─── 底部弹窗 ─── */
.bottom-sheet {
  position: fixed;
  bottom: -110%;
  left: 0; right: 0;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 16rpx 40rpx 60rpx;
  z-index: 51;
  transition: bottom 0.32s cubic-bezier(0.32,0.72,0,1);
  max-height: 85vh;
  overflow-y: auto;
}

.bottom-sheet--show { bottom: 0; }

.sheet-handle {
  width: 80rpx; height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}

.sheet-title {
  display: block;
  font-size: 36rpx; font-weight: 700; color: #5D4037;
  text-align: center;
  margin-bottom: 8rpx;
}

.sheet-sub-title {
  display: block;
  font-size: 24rpx; color: #A1887F;
  text-align: center;
  margin-bottom: 24rpx;
}

.sheet-list { margin-bottom: 16rpx; }

/* AI魔法弹框 */
.magic-info-box {
  background: #FFF4DC;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.magic-info-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.magic-info-text {
  font-size: 22rpx;
  color: #A1887F;
  line-height: 1.6;
}

/* 链接行 */
.sheet-link-row {
  background: #FFF9ED;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  border: 2rpx solid #FFEBB5;
}

.sheet-link-row:active { transform: scale(0.98); }

.sheet-link-text {
  font-size: 28rpx; font-weight: 700; color: #5D4037;
}

.sheet-link-arrow { font-size: 36rpx; color: #FF9800; }

/* 礼品包 */
.gift-list { margin-bottom: 24rpx; }

.gift-item {
  background: #FFF9ED;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  border: 2rpx solid #FFEBB5;
}

.gift-info { flex: 1; }
.gift-title { font-size: 28rpx; font-weight: 700; color: #5D4037; display: block; }
.gift-subtitle { font-size: 22rpx; color: #A1887F; display: block; margin-top: 4rpx; }

.gift-use-btn {
  background: #FF9800;
  color: #fff;
  font-size: 24rpx; font-weight: 700;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
}

.gift-empty {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.gift-empty-icon { font-size: 96rpx; opacity: 0.5; }
.gift-empty-text { font-size: 28rpx; font-weight: 700; color: #D0B8A1; }

/* 任务中心 */
.task-list { margin-bottom: 24rpx; }

.task-item {
  background: #FFF9ED;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  border: 2rpx solid #FFEBB5;
}

.task-item-special {
  background: linear-gradient(135deg, rgba(255,213,79,0.2), rgba(255,152,0,0.2));
  border: 2rpx solid #FFD54F;
}

.task-info { flex: 1; }
.task-name { font-size: 28rpx; font-weight: 700; color: #5D4037; display: block; }
.task-reward { font-size: 22rpx; color: #A1887F; display: block; margin-top: 4rpx; }

.task-do-btn {
  background: #FF9800;
  color: #fff;
  font-size: 24rpx; font-weight: 700;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
}

.task-done-btn {
  background: #E0E0E0;
  color: #999;
  font-size: 24rpx; font-weight: 700;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
}

/* 关闭按钮 */
.sheet-close-btn {
  width: 100%;
  height: 96rpx;
  background: #FF9800;
  border-radius: 48rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700; color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255,152,0,0.3);
  margin-top: 16rpx;
}

.sheet-close-btn:active { opacity: 0.85; }

/* ─── 设置弹框 ─── */
.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.settings-close {
  font-size: 44rpx;
  color: #D0B8A1;
  padding: 8rpx;
}

.settings-list { margin-bottom: 24rpx; }

.settings-row {
  background: #FFF9ED;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #FFEBB5;
}

.settings-row-left { width: 100%; }

.settings-row-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.settings-row-title {
  font-size: 30rpx; font-weight: 700; color: #5D4037;
}

.settings-vip-tag {
  font-size: 18rpx; font-weight: 700;
  background: #FFEBB5;
  color: #8C6B4B;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.settings-row-desc {
  font-size: 22rpx; color: #A1887F;
  margin-bottom: 8rpx;
}

.settings-switch { transform: scale(0.85); }

.settings-input {
  width: 100%;
  background: #fff;
  border: 2rpx solid #F5E6D3;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #5D4037;
  margin-top: 8rpx;
  box-sizing: border-box;
}

.settings-input-disabled {
  background: #FFF4DC;
  border-color: #FFF4DC;
  color: #D0B8A1;
}

.settings-row-hint {
  font-size: 22rpx; color: #A1887F;
  text-align: right;
  margin-top: 8rpx;
  display: block;
}

.settings-confirm-btn {
  width: 100%;
  height: 120rpx;
  background: linear-gradient(135deg, #FFD54F, #FF9800);
  border-radius: 48rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; color: #3E2723;
  box-shadow: 0 8rpx 30rpx rgba(255,152,0,0.3);
}

.settings-confirm-btn:active { transform: scale(0.98); }

/* ─── 用户反馈页 ─── */
.feedback-page { padding: 32rpx; }

.feedback-tutorial-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 2rpx solid #FFF4DC;
  margin-bottom: 40rpx;
}

.feedback-tutorial-icon { font-size: 48rpx; }
.feedback-tutorial-texts { flex: 1; }
.feedback-tutorial-title { font-size: 30rpx; font-weight: 700; color: #5D4037; display: block; }
.feedback-tutorial-desc { font-size: 24rpx; color: #A1887F; display: block; margin-top: 8rpx; }
.feedback-tutorial-arrow { font-size: 40rpx; color: #D0B8A1; }

.feedback-section {}
.feedback-label {
  display: block;
  font-size: 28rpx; font-weight: 700; color: #5D4037;
  margin-bottom: 16rpx;
}

.feedback-input {
  width: 100%;
  min-height: 200rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #5D4037;
  box-sizing: border-box;
  border: 2rpx solid #FFF4DC;
}

.feedback-send-btn {
  width: 100%;
  height: 120rpx;
  background: #FF9800;
  border-radius: 48rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255,152,0,0.3);
  border-bottom: 4rpx solid #F57C00;
  margin-top: 24rpx;
}

.feedback-send-btn:active { transform: translateY(2rpx); }

/* ─── 隐私安全页 ─── */
.privacy-page { padding: 32rpx; }

.privacy-row {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  border: 2rpx solid #FFF4DC;
}

.privacy-row-left { flex: 1; }
.privacy-row-title { font-size: 30rpx; font-weight: 700; color: #5D4037; display: block; }
.privacy-row-desc { font-size: 22rpx; color: #A1887F; display: block; margin-top: 4rpx; }
.privacy-row-title.danger { color: #D32F2F; }
.privacy-row-desc.danger { color: #E57373; }
.privacy-row-icon { font-size: 40rpx; }
.privacy-switch { transform: scale(0.85); }

.privacy-row-danger {
  background: #FFE5E5;
  border-color: #FFCDCD;
}

.privacy-row-danger:active { transform: scale(0.98); }

/* ─── 账号设置页 ─── */
.account-page { padding: 32rpx; }

.account-row {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  border: 2rpx solid #FFF4DC;
}

.account-row-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.account-row-icon { font-size: 40rpx; }
.account-row-title { font-size: 28rpx; font-weight: 700; color: #5D4037; }
.account-row-value { font-size: 26rpx; font-weight: 700; color: #A1887F; }

.account-row-danger {
  color: #FF6B6B;
}

.account-row-danger:active { background: #FFE5E5; border-color: #FFCDCD; }
