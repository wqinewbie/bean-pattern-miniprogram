/* profile.wxss - 暖色系风格 */

.profile-page {
  min-height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
}

.checkin-section {
  margin: 24rpx 0 32rpx;
  padding: 28rpx;
  background: linear-gradient(180deg, #FFF8E8, #FFFFFF);
  border: 4rpx solid #FFF0C8;
  border-radius: 28rpx;
}

.checkin-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.checkin-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #5D4037;
}

.checkin-desc {
  font-size: 22rpx;
  line-height: 1.5;
  color: #A1887F;
  text-align: right;
}

.checkin-summary-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #FFF4DC;
  padding: 28rpx 24rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 244, 220, 0.45);
}

.checkin-main-row {
  display: flex;
  align-items: stretch;
}

.checkin-main-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.checkin-main-divider {
  width: 2rpx;
  background: #FFF0C8;
  margin: 0 12rpx;
}

.checkin-main-value {
  font-size: 52rpx;
  line-height: 1;
  font-weight: 900;
  color: #FF9800;
}

.checkin-main-label {
  font-size: 22rpx;
  color: #8C6B4B;
  font-weight: 700;
}

.checkin-tips-row {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #FFF0C8;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.checkin-tip-text {
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 700;
}

.checkin-tip-text--highlight {
  color: #FF9800;
}

.checkin-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.checkin-btn,
.claim-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  border: none;
  margin: 0;
  padding: 0;
}

.checkin-btn::after,
.claim-btn::after {
  border: none;
}

.checkin-btn {
  background: linear-gradient(180deg, #FFD54F, #FFB300);
  color: #5D4037;
}

.checkin-btn--disabled {
  background: #F2E6D9;
  color: #BCAAA4;
}

.claim-btn {
  background: linear-gradient(180deg, #FFB74D, #FF9800);
  color: #FFFFFF;
}

.profile-page {
  min-height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
}

/* ─── 头部黄色区域 ─── */
.header-zone {
  background: #FFEBB5;
  padding: 0 40rpx 80rpx;
  border-radius: 0 0 60rpx 60rpx;
  border-bottom: 4rpx solid #FFD54F;
  flex-shrink: 0;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.header-top {
  height: 72rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.bell-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  color: #5D4037;
}
.bell-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
}
.bell-dot {
  position: absolute; top: 8rpx; right: 8rpx;
  width: 16rpx; height: 16rpx;
  background: #FF6B6B;
  border-radius: 50%;
  border: 3rpx solid #FFEBB5;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding-bottom: 8rpx;
}

.avatar-box {
  position: relative;
  flex-shrink: 0;
}

.avatar-wrap {
  width: 128rpx; height: 128rpx;
  border-radius: 36rpx;
  background: rgba(255,255,255,0.6);
  border: 4rpx solid #fff;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(255,160,0,0.2);
  transform: rotate(-3deg);
}

.avatar { width: 128rpx; height: 128rpx; }
.avatar-edit {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FF9800;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(255,152,0,0.32);
}
.avatar-ph {
  width: 128rpx; height: 128rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx;
}

.user-info { display: flex; flex-direction: column; gap: 12rpx; }
.user-name { font-size: 44rpx; font-weight: 800; color: #5D4037; letter-spacing: 1rpx; }
.user-tags { display: flex; gap: 12rpx; flex-wrap: wrap; align-items: center;}

.tag-normal {
  font-size: 22rpx; font-weight: 800; color: #8C6B4B;
  background: #fff;
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  border: 2rpx solid #FFEBB5;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.tag-vip {
  font-size: 22rpx; font-weight: 700; color: #5D4037;
  background: linear-gradient(135deg, #FFD54F, #FFB74D);
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(255,152,0,0.2);
}

.phone-tag {
  font-size: 22rpx; font-weight: 700; color: #A1887F;
}

/* ─── 统计卡片 ─── */
.stats-card {
  margin: -60rpx 40rpx 40rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 28rpx 32rpx;
  display: flex;
  box-shadow: 0 16rpx 60rpx rgba(140,107,75,0.08);
  border: 4rpx solid #FFF4DC;
  position: relative; z-index: 10;
}

.stat-item {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; gap: 8rpx;
}

.stat-item:active { transform: scale(0.95); }

.stat-num { font-size: 40rpx; font-weight: 800; color: #5D4037; }
.stat-label-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.stat-icon {
  width: 24rpx;
  height: 24rpx;
}
.stat-label { font-size: 22rpx; font-weight: 700; color: #A1887F; }
.stat-divider { width: 2rpx; background: #FFF4DC; margin: 4rpx 0; }

/* ─── 滚动区域 ─── */
.scroll-body { flex: 1; }

/* ─── VIP 卡 ─── */
.vip-card {
  margin: 0 40rpx 40rpx;
  background: linear-gradient(135deg, #212121, #3E2723);
  border-radius: 40rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
  border-bottom: 8rpx solid #1A1A1A;
  position: relative;
  overflow: hidden;
}

.vip-card:active { transform: translateY(4rpx); border-bottom-width: 0; }

.vip-glow {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 256rpx;
  height: 256rpx;
  border-radius: 50%;
  background: rgba(255,213,79,0.2);
}

.vip-left { display: flex; flex-direction: column; gap: 12rpx; position: relative; z-index: 1; }
.vip-title { font-size: 36rpx; font-weight: 800; color: #FFD54F; }
.vip-sub   { font-size: 22rpx; color: #A1887F; font-weight: 700; }

.vip-btn {
  background: linear-gradient(180deg, #FFD54F, #FF9800);
  color: #3E2723;
  font-size: 26rpx;
  font-weight: 800;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(255,152,0,0.3);
  position: relative;
  z-index: 1;
}

/* ─── 创作空间卡片 ─── */
.section-card {
  margin: 0 40rpx 40rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 60rpx rgba(140,107,75,0.06);
  border: 4rpx solid #FFF4DC;
}

.section-title-row {
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 32rpx;
}

.section-bar {
  width: 6rpx; height: 32rpx;
  background: #FF9800;
  border-radius: 4rpx;
}

.section-title { font-size: 30rpx; font-weight: 800; color: #5D4037; }

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.action-item {
  display: flex; flex-direction: column;
  align-items: center; gap: 16rpx;
  padding: 24rpx 8rpx;
  border-radius: 24rpx;
  background: transparent;
  border: 0;
  position: relative;
}

.action-item--blue { background: #E3F2FD; }
.action-item--orange { background: #FFF3E0; }
.action-item--purple { background: #F3E5F5; }

.action-item:active { transform: scale(0.93); }

.action-icon {
  width: 64rpx; height: 64rpx;
  border-radius: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx;
}

.action-svg {
  width: 56rpx;
  height: 56rpx;
}

.draft-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  min-width: 36rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #FF6B6B;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.action-icon.blue,
.action-icon.orange,
.action-icon.purple { background: transparent; }

.action-label { font-size: 26rpx; font-weight: 800; color: #5D4037; }

/* ─── 菜单卡片 ─── */
.menu-card {
  margin: 0 40rpx 40rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 12rpx;
  box-shadow: 0 16rpx 60rpx rgba(140,107,75,0.06);
  border: 4rpx solid #FFF4DC;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 32rpx;
}

.menu-item:active { background: #FFEBB5; }

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
}

.menu-svg {
  width: 40rpx;
  height: 40rpx;
}

.menu-icon--help { background:#E8F5E9; color:#4CAF50; }
.menu-icon--settings { background:#ECEFF1; color:#607D8B; }
.menu-icon--privacy { background:#F3E5F5; color:#9C27B0; }

.menu-title { font-size: 28rpx; font-weight: 800; color: #5D4037; }

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-arrow { font-size: 40rpx; color: #D0B8A1; }
.menu-divider { height: 2rpx; background: #FFF9ED; margin: 0 24rpx; }

/* ─── 子页 ─── */
.sub-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #FFF9ED;
  z-index: 40;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  display: flex;
  flex-direction: column;
}

.sub-page--show {
  transform: translateY(0);
}

.sub-header {
  position: relative;
  padding: 0 28rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #FFF4DC;
  background: #FFF9ED;
  flex-shrink: 0;
}

.sub-back {
  font-size: 42rpx;
  color: #8C6B4B;
  width: 96rpx;
  text-align: left;
  z-index: 2;
}

.sub-title-wrap {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  max-width: calc(100% - 240rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.sub-title {
  max-width: 100%;
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub-title-badge {
  font-size: 18rpx;
  font-weight: 800;
  color: #FF9800;
  background: #FFF4DC;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}

.sub-action {
  font-size: 24rpx;
  color: #FF6B6B;
  width: 96rpx;
  text-align: right;
  z-index: 2;
  visibility: hidden;
}

.sub-add {
  visibility: visible;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFF9ED;
  color: #8C6B4B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
}

.sub-add--hidden {
  visibility: hidden;
}

.sub-scroll {
  flex: 1;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sub-loading, .sub-empty {
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #A1887F;
  font-size: 26rpx;
}

.sub-list { padding: 24rpx 32rpx; }
.sub-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(140,107,75,0.06);
}

.sub-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: #FFF4DC;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.sub-thumb-img { width: 100%; height: 100%; }
.sub-thumb-ph { font-size: 48rpx; }

.sub-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.sub-name { font-size: 26rpx; font-weight: 700; color: #5D4037; }
.sub-meta { font-size: 20rpx; color: #A1887F; }
.sub-del { font-size: 32rpx; color: #D0B8A1; padding: 8rpx; }
.sub-go {
  background: #FF9800;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.sub-restore {
  background: #E8F5E9;
  color: #4CAF50;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* 消息中心 */
.notifications-page {
  padding: 32rpx;
}

.notifications-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notification-card {
  background: #fff;
  border-radius: 32rpx;
  border: 4rpx solid #FFF4DC;
  box-shadow: 0 8rpx 24rpx rgba(140,107,75,0.06);
  padding: 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.notification-card--unread {
  border-color: #FFEBB5;
}

.notification-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.notification-icon--gift { background: #FFE5E5; }
.notification-icon--magic { background: #F3E5F5; }
.notification-icon--system { background: #E3F2FD; }

.notification-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.notification-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.notification-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
}

.notification-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF6B6B;
}

.notification-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #8C6B4B;
  font-weight: 700;
}

.notification-time {
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 700;
}

.notifications-empty {
  padding: 180rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.notifications-empty-icon {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  background: #FFF4DC;
  color: #FF9800;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  opacity: 0.72;
  margin-bottom: 32rpx;
}

.notifications-empty-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #8C6B4B;
}

/* 图纸箱子页 */
.patterns-page {
  padding: 32rpx;
}

.patterns-search {
  height: 88rpx;
  background: #fff;
  border-radius: 999rpx;
  border: 4rpx solid #FFF4DC;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.patterns-search-icon {
  font-size: 32rpx;
  color: #FF9800;
  font-weight: 800;
  margin-right: 16rpx;
}

.patterns-search-input {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #5D4037;
}

.patterns-empty {
  padding: 160rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #D0B8A1;
}

.patterns-empty-icon {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  background: #FFF4DC;
  color: #FF9800;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  opacity: 0.72;
  margin-bottom: 32rpx;
}

.patterns-empty-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #8C6B4B;
}

.patterns-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.pattern-card {
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  border: 4rpx solid #FFF4DC;
  box-shadow: 0 8rpx 24rpx rgba(140,107,75,0.06);
}

.pattern-thumb {
  width: 100%;
  aspect-ratio: 1;
  background: #F5F5F5;
  position: relative;
}

.pattern-thumb-img {
  width: 100%;
  height: 100%;
}

.pattern-thumb-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #A1887F;
  background: #FFF4DC;
}

.pattern-source-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  height: 36rpx;
  border-radius: 999rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 18rpx;
  font-weight: 900;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.12);
  border: 2rpx solid rgba(255,255,255,0.6);
}

.pattern-source-badge--ai {
  background: linear-gradient(90deg, #FFD54F, #FF9800);
  color: #3E2723;
}

.pattern-source-badge--free {
  background: rgba(255,255,255,0.9);
  color: #0288D1;
  border-color: #E3F2FD;
}

.pattern-source-badge--draft {
  background: rgba(255,255,255,0.9);
  color: #FF9800;
  border-color: #FFEBB5;
}

.pattern-source-icon {
  width: 20rpx;
  height: 20rpx;
}

.pattern-body {
  padding: 24rpx;
}

.pattern-name {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #5D4037;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 18rpx;
}

.pattern-actions {
  display: flex;
  gap: 12rpx;
}

.pattern-view-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 16rpx;
  background: #E3F2FD;
  color: #0288D1;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.pattern-action-icon {
  width: 28rpx;
  height: 28rpx;
}

.pattern-del-btn {
  width: 72rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #FFE5E5;
  color: #FF6B6B;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-empty-icon {
  background: #F3E5F5;
  color: #9C27B0;
}

.history-meta {
  display: block;
  font-size: 20rpx;
  color: #A1887F;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.history-continue-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 16rpx;
  background: #FFF3E0;
  color: #FF9800;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ─── 弹窗蒙层 ─── */
.modal-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(4rpx);
  z-index: 900;
}

/* ─── 底部弹窗 ─── */
.bottom-sheet {
  position: fixed;
  bottom: -110%;
  left: 0; right: 0;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 24rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  z-index: 901;
  transition: bottom 0.32s cubic-bezier(0.32,0.72,0,1);
  max-height: 85vh;
  overflow-y: auto;
  box-shadow: 0 -24rpx 80rpx rgba(93,64,55,0.18);
  border-top: 4rpx solid #FFEBB5;
}

.bottom-sheet--show { bottom: 0; }

.sheet-handle {
  width: 80rpx; height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin: 0 auto 36rpx;
}

.sheet-title {
  display: block;
  font-size: 36rpx; font-weight: 800; color: #5D4037;
  text-align: left;
  margin-bottom: 8rpx;
}

.sheet-sub-title {
  display: block;
  font-size: 24rpx; color: #A1887F;
  font-weight: 700;
  text-align: left;
  margin-bottom: 24rpx;
}

.sheet-list { margin-bottom: 16rpx; }

/* AI魔法弹框 */
.magic-info-box {
  background: #FFF4DC;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.magic-info-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #FF9800;
  color: #FFF4DC;
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.magic-info-text {
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 500;
  line-height: 1.6;
}

/* 链接行 */
.sheet-link-row {
  background: #FFF9ED;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  border: 2rpx solid #FFEBB5;
}

.sheet-link-row:active { transform: scale(0.98); }

.sheet-link-text {
  font-size: 28rpx; font-weight: 800; color: #5D4037;
}

.sheet-link-arrow { font-size: 36rpx; color: #D0B8A1; }

/* 礼品包 */
.gift-list { margin-bottom: 24rpx; }

.gift-item {
  background: #FFF9ED;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  border: 2rpx solid #FFEBB5;
}

.gift-info { flex: 1; }
.gift-title { font-size: 28rpx; font-weight: 800; color: #5D4037; display: block; }
.gift-subtitle { font-size: 22rpx; color: #A1887F; font-weight: 700; display: block; margin-top: 8rpx; }
.gift-tabs { display: flex; gap: 16rpx; margin: 20rpx 0 24rpx; }
.gift-tab { flex: 1; height: 68rpx; border-radius: 999rpx; background: #FFF4DC; color: #8D6E63; display: flex; align-items: center; justify-content: center; gap: 10rpx; font-size: 24rpx; font-weight: 700; }
.gift-tab--active { background: linear-gradient(90deg, #FFD54F, #FFB74D); color: #5D4037; }
.gift-tab-count { font-size: 20rpx; opacity: 0.9; }
.gift-title-row { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.gift-status { display: inline-flex; align-items: center; justify-content: center; min-width: 92rpx; height: 36rpx; padding: 0 14rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 800; }
.gift-item--expired, .gift-item--used { opacity: 0.58; filter: grayscale(40%); }
.gift-soon-tag { display: inline-flex; align-items: center; justify-content: center; height: 36rpx; padding: 0 14rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 900; background: #FFF3E0; color: #E65100; border: 2rpx solid #FFCC80; }
.gift-status--available { background: #E8F5E9; color: #2E7D32; }
.gift-status--used { background: #ECEFF1; color: #607D8B; }
.gift-status--expired { background: #FDECEA; color: #C62828; }
.gift-expire { font-size: 20rpx; color: #8D6E63; display: block; margin-top: 6rpx; }
.gift-tip { font-size: 20rpx; color: #E67E22; display: block; margin-top: 6rpx; font-weight: 700; }

.gift-use-btn {
  background: #FF9800;
  color: #fff;
  font-size: 24rpx; font-weight: 800;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.gift-empty {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.gift-empty-icon { font-size: 96rpx; opacity: 0.5; }
.gift-empty-text { font-size: 28rpx; font-weight: 700; color: #D0B8A1; }

/* 任务中心 */
.task-list { margin-bottom: 24rpx; }

.task-item {
  background: #FFF9ED;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  border: 2rpx solid #FFEBB5;
}

.task-item-special {
  background: linear-gradient(135deg, rgba(255,213,79,0.2), rgba(255,152,0,0.2));
  border: 2rpx solid #FFD54F;
}

.task-info { flex: 1; }
.task-name { font-size: 28rpx; font-weight: 800; color: #5D4037; display: block; }
.task-reward { font-size: 22rpx; color: #A1887F; font-weight: 700; display: block; margin-top: 8rpx; }

.task-do-btn {
  background: #FF9800;
  color: #fff;
  font-size: 24rpx; font-weight: 800;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.task-done-btn {
  background: #E0E0E0;
  color: #999;
  font-size: 24rpx; font-weight: 800;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* 关闭按钮 */
.sheet-close-btn {
  width: 100%;
  height: 96rpx;
  background: #FF9800;
  border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 800; color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255,152,0,0.3);
  margin-top: 16rpx;
}

.sheet-close-btn:active { opacity: 0.85; }

/* ─── 设置弹框 ─── */
.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 48rpx;
}

.settings-header .sheet-title {
  text-align: left;
  margin-bottom: 0;
  font-size: 40rpx;
}

.settings-close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #D0B8A1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
}

.settings-list { margin-bottom: 24rpx; }

.settings-row {
  background: #FFF9ED;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #FFEBB5;
}

.settings-row-left { width: 100%; }

.settings-row-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.settings-row-title {
  font-size: 30rpx; font-weight: 800; color: #5D4037;
}

.settings-vip-tag {
  font-size: 18rpx; font-weight: 800;
  background: #FFEBB5;
  color: #8C6B4B;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.settings-row-desc {
  font-size: 22rpx; color: #A1887F;
  font-weight: 700;
  margin-bottom: 0;
  line-height: 1.5;
}

.settings-switch { transform: scale(0.85); }

.settings-input {
  width: 100%;
  background: #fff;
  border: 2rpx solid #F5E6D3;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #5D4037;
  margin-top: 16rpx;
  box-sizing: border-box;
  min-height: 96rpx;
  line-height: 1.4;
}

.settings-input-disabled {
  background: #FFF4DC;
  border-color: #FFF4DC;
  color: #D0B8A1;
}

.settings-row-hint {
  font-size: 22rpx; color: #A1887F;
  text-align: right;
  margin-top: 12rpx;
  display: block;
}

.settings-confirm-btn {
  width: 100%;
  height: 104rpx;
  background: linear-gradient(90deg, #FFD54F, #FF9800);
  border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 800; color: #3E2723;
  box-shadow: 0 12rpx 40rpx rgba(255,152,0,0.3);
}

.settings-confirm-btn:active { transform: scale(0.98); }

/* ─── 帮助中心页 ─── */
.help-page {
  padding: 40rpx 40rpx 48rpx;
}

.help-section {
  margin-bottom: 48rpx;
}

.help-section-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.help-section-bar {
  width: 6rpx;
  height: 40rpx;
  background: #FF9800;
  border-radius: 999rpx;
}

.help-section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
}

.help-faq-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.help-faq-item {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(140,107,75,0.06);
  border: 4rpx solid #FFF4DC;
}

.help-faq-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.help-faq-question {
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
  line-height: 1.5;
}

.help-faq-arrow {
  font-size: 36rpx;
  color: #D0B8A1;
  font-weight: 800;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.help-faq-answer {
  font-size: 26rpx;
  color: #A1887F;
  line-height: 1.6;
  font-weight: 700;
}

.help-contact-card {
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  border-radius: 32rpx;
  padding: 48rpx;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(255,152,0,0.25);
}

.help-contact-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
}

.help-contact-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 700;
  margin-bottom: 32rpx;
}

.help-contact-btn {
  background: #fff;
  color: #FF9800;
  font-size: 28rpx;
  font-weight: 800;
  padding: 24rpx 48rpx;
  border-radius: 999rpx;
  display: inline-block;
}

.help-contact-btn:active {
  transform: scale(0.95);
}

/* ─── 隐私政策页 ─── */
.privacy-page {
  padding: 40rpx;
}

.privacy-content {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(140,107,75,0.06);
  border: 4rpx solid #FFF4DC;
}

.privacy-section {
  margin-bottom: 48rpx;
}

.privacy-section:last-child {
  margin-bottom: 0;
}

.privacy-section-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 16rpx;
  text-align: center;
}

.privacy-update-time {
  display: block;
  font-size: 22rpx;
  color: #A1887F;
  text-align: center;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.privacy-subtitle {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 24rpx;
  padding-left: 24rpx;
  border-left: 6rpx solid #FF9800;
}

.privacy-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #8C6B4B;
  font-weight: 500;
  margin-bottom: 20rpx;
  text-align: justify;
}

.privacy-text:last-child {
  margin-bottom: 0;
}

.privacy-footer {
  margin-top: 64rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #FFF4DC;
  text-align: center;
}

.privacy-footer-text {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #FF9800;
}

/* ─── 签到区域样式 ─── */
.checkin-section {
  background: linear-gradient(135deg, #FFF9ED 0%, #FFEBB5 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 3rpx solid #FFD54F;
}

.checkin-header {
  margin-bottom: 24rpx;
}

.checkin-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  display: block;
  margin-bottom: 8rpx;
}

.checkin-desc {
  font-size: 24rpx;
  color: #8C6B4B;
  font-weight: 600;
  display: block;
}

/* 签到日历 */
.checkin-calendar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
}

.calendar-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.day-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E0E0E0;
  border: 3rpx solid #BDBDBD;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-dot--checked {
  background: linear-gradient(135deg, #FF9800 0%, #FF6B00 100%);
  border-color: #FF6B00;
}

.day-dot--checked::after {
  content: '✓';
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

.day-label {
  font-size: 22rpx;
  color: #8C6B4B;
  font-weight: 600;
}

/* 签到状态 */
.checkin-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
}

.status-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #FF9800;
}

.status-total {
  font-size: 24rpx;
  font-weight: 600;
  color: #8C6B4B;
}

/* 签到按钮 */
.checkin-actions {
  display: flex;
  gap: 16rpx;
}

.checkin-btn,
.claim-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 800;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-btn {
  background: linear-gradient(135deg, #FF9800 0%, #FF6B00 100%);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(255, 152, 0, 0.3);
}

.checkin-btn:active {
  transform: scale(0.98);
}

.checkin-btn--disabled {
  background: #E0E0E0;
  color: #9E9E9E;
  box-shadow: none;
}

.claim-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(76, 175, 80, 0.3);
}

.claim-btn:active {
  transform: scale(0.98);
}

/* 任务区域标题 */
.task-section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 24rpx;
  padding-left: 24rpx;
  border-left: 6rpx solid #FF9800;
}

/* 任务进度 */
.task-progress {
  margin-right: 16rpx;
}

.progress-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF9800;
}

.task-claim-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  color: white;
  font-size: 24rpx;
  font-weight: 800;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  border: none;
  box-shadow: 0 4rpx 8rpx rgba(76, 175, 80, 0.2);
}

.task-claim-btn:active {
  transform: scale(0.98);
}

.task-desc {
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 500;
  display: block;
  margin-top: 4rpx;
}


