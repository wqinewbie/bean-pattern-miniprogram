/* profile.wxss - 暖色系风格 */

.profile-page {
  min-height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
}

.checkin-section {
  margin: 24rpx 0 32rpx;
  padding: 28rpx;
  background: linear-gradient(180deg, #FFF8E8, #FFFFFF);
  border: 4rpx solid #FFF0C8;
  border-radius: 28rpx;
}

.checkin-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.checkin-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #5D4037;
}

.checkin-desc {
  font-size: 22rpx;
  line-height: 1.5;
  color: #A1887F;
  text-align: right;
}

.checkin-summary-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #FFF4DC;
  padding: 28rpx 24rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 244, 220, 0.45);
}

.checkin-main-row {
  display: flex;
  align-items: stretch;
}

.checkin-main-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.checkin-main-divider {
  width: 2rpx;
  background: #FFF0C8;
  margin: 0 12rpx;
}

.checkin-main-value {
  font-size: 52rpx;
  line-height: 1;
  font-weight: 900;
  color: #FF9800;
}

.checkin-main-label {
  font-size: 22rpx;
  color: #8C6B4B;
  font-weight: 700;
}

.checkin-tips-row {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #FFF0C8;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.checkin-tip-text {
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 700;
}

.checkin-tip-text--highlight {
  color: #FF9800;
}

.checkin-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.checkin-btn,
.claim-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  border: none;
  margin: 0;
  padding: 0;
}

.checkin-btn::after,
.claim-btn::after {
  border: none;
}

.checkin-btn {
  background: linear-gradient(180deg, #FFD54F, #FFB300);
  color: #5D4037;
}

.checkin-btn--disabled {
  background: #F2E6D9;
  color: #BCAAA4;
}

.claim-btn {
  background: linear-gradient(180deg, #FFB74D, #FF9800);
  color: #FFFFFF;
}

.profile-page {
  min-height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
}

/* ─── 头部黄色区域 ─── */
.header-zone {
  background: #FFEBB5;
  padding: 0 40rpx 80rpx;
  border-radius: 0 0 96rpx 96rpx;
  border-bottom: 4rpx solid #FFD54F;
  flex-shrink: 0;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.header-top {
  height: 72rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.bell-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  color: #5D4037;
}
.bell-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
}
.bell-dot {
  position: absolute; top: 8rpx; right: 8rpx;
  width: 16rpx; height: 16rpx;
  background: #FF6B6B;
  border-radius: 50%;
  border: 3rpx solid #FFEBB5;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding-bottom: 8rpx;
}

.avatar-box {
  position: relative;
  flex-shrink: 0;
}

.avatar-wrap {
  width: 128rpx; height: 128rpx;
  border-radius: 48rpx;
  background: rgba(255,255,255,0.6);
  border: 4rpx solid #fff;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(255,160,0,0.2);
  transform: rotate(-3deg);
}

.avatar { width: 128rpx; height: 128rpx; }
.avatar-edit {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FF9800;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(255,152,0,0.32);
}
.avatar-ph {
  width: 128rpx; height: 128rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx;
}

.user-info { display: flex; flex-direction: column; gap: 12rpx; }
.user-name { font-size: 44rpx; font-weight: 800; color: #5D4037; letter-spacing: 1rpx; }
.user-tags { display: flex; gap: 12rpx; flex-wrap: wrap; align-items: center;}

.tag-normal {
  font-size: 22rpx; font-weight: 800; color: #8C6B4B;
  background: #fff;
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  border: 2rpx solid #FFEBB5;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.tag-vip {
  font-size: 22rpx; font-weight: 700; color: #5D4037;
  background: linear-gradient(135deg, #FFD54F, #FFB74D);
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(255,152,0,0.2);
}

.phone-tag {
  font-size: 22rpx; font-weight: 700; color: #A1887F;
}

/* ─── 统计卡片 ─── */
.stats-card {
  margin: -60rpx 40rpx 40rpx;
  background: #fff;
  border-radius: 64rpx;
  padding: 28rpx 32rpx;
  display: flex;
  box-shadow: 0 16rpx 60rpx rgba(140,107,75,0.08);
  border: 4rpx solid #FFF4DC;
  position: relative; z-index: 10;
}

.stat-item {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; gap: 8rpx;
}

.stat-item:active { transform: scale(0.95); }

.stat-num { font-size: 40rpx; font-weight: 800; color: #5D4037; }
.stat-label-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.stat-icon {
  width: 24rpx;
  height: 24rpx;
}
.stat-label { font-size: 22rpx; font-weight: 700; color: #A1887F; }
.stat-divider { width: 2rpx; background: #FFF4DC; margin: 4rpx 0; }

/* ─── 滚动区域 ─── */
.scroll-body { flex: 1; }

.tabbar-scroll-spacer {
  height: calc(180rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

/* ─── VIP 卡 ─── */
.vip-card {
  margin: 0 40rpx 40rpx;
  background: linear-gradient(135deg, #212121, #3E2723);
  border-radius: 64rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
  border-bottom: 8rpx solid #1A1A1A;
  position: relative;
  overflow: hidden;
}

.vip-card:active { transform: translateY(4rpx); border-bottom-width: 0; }

.vip-glow {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 256rpx;
  height: 256rpx;
  border-radius: 50%;
  background: rgba(255,213,79,0.2);
}

.vip-left { display: flex; flex-direction: column; gap: 12rpx; position: relative; z-index: 1; }
.vip-title { font-size: 36rpx; font-weight: 800; color: #FFD54F; }
.vip-sub   { font-size: 22rpx; color: #A1887F; font-weight: 700; }

.vip-btn {
  background: linear-gradient(180deg, #FFD54F, #FF9800);
  color: #3E2723;
  font-size: 26rpx;
  font-weight: 800;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(255,152,0,0.3);
  position: relative;
  z-index: 1;
}

/* ─── 创作空间卡片 ─── */
.section-card {
  margin: 0 40rpx 40rpx;
  background: #fff;
  border-radius: 64rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 60rpx rgba(140,107,75,0.06);
  border: 4rpx solid #FFF4DC;
}

.section-title-row {
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 32rpx;
}

.section-bar {
  width: 12rpx; height: 32rpx;
  background: #FF9800;
  border-radius: 999rpx;
}

.section-title { font-size: 30rpx; font-weight: 800; color: #5D4037; }

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.action-item {
  display: flex; flex-direction: column;
  align-items: center; gap: 16rpx;
  padding: 0;
  background: transparent;
  border: 0;
  position: relative;
}

.action-item:active { transform: scale(0.93); }

.action-icon-box {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon-box--blue { background: #E3F2FD; }
.action-icon-box--orange { background: #E0F2F1; }
.action-icon-box--purple { background: #FFF3E0; }

.action-svg {
  width: 56rpx;
  height: 56rpx;
}

.draft-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #FF6B6B;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.action-label { font-size: 26rpx; font-weight: 800; color: #5D4037; }

/* ─── 菜单卡片 ─── */
.menu-card {
  margin: 0 40rpx 40rpx;
  background: #fff;
  border-radius: 64rpx;
  padding: 12rpx;
  box-shadow: 0 16rpx 60rpx rgba(140,107,75,0.06);
  border: 4rpx solid #FFF4DC;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 48rpx;
}

.menu-item:active { background: #FFEBB5; }

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
}

.menu-svg {
  width: 40rpx;
  height: 40rpx;
}

.menu-icon--help { background:#E8F5E9; color:#4CAF50; }
.menu-icon--settings { background:#ECEFF1; color:#607D8B; }
.menu-icon--privacy { background:#F3E5F5; color:#9C27B0; }

.menu-title { font-size: 28rpx; font-weight: 800; color: #5D4037; }

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-arrow { font-size: 40rpx; color: #D0B8A1; }
.menu-divider { height: 2rpx; background: #FFF9ED; margin: 0 24rpx; }


/* ─── 签到区域样式 ─── */
.checkin-section {
  background: linear-gradient(135deg, #FFF9ED 0%, #FFEBB5 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 4rpx solid #FFD54F;
}

.checkin-header {
  margin-bottom: 24rpx;
}

.checkin-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  display: block;
  margin-bottom: 8rpx;
}

.checkin-desc {
  font-size: 24rpx;
  color: #8C6B4B;
  font-weight: 600;
  display: block;
}

/* 签到日历 */
.checkin-calendar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
}

.calendar-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.day-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E0E0E0;
  border: 3rpx solid #BDBDBD;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-dot--checked {
  background: linear-gradient(135deg, #FF9800 0%, #FF6B00 100%);
  border-color: #FF6B00;
}

.day-dot--checked::after {
  content: '✓';
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

.day-label {
  font-size: 22rpx;
  color: #8C6B4B;
  font-weight: 600;
}

/* 签到状态 */
.checkin-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
}

.status-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #FF9800;
}

.status-total {
  font-size: 24rpx;
  font-weight: 600;
  color: #8C6B4B;
}

/* 签到按钮 */
.checkin-actions {
  display: flex;
  gap: 16rpx;
}

.checkin-btn,
.claim-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 800;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-btn {
  background: linear-gradient(135deg, #FF9800 0%, #FF6B00 100%);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(255, 152, 0, 0.3);
}

.checkin-btn:active {
  transform: scale(0.98);
}

.checkin-btn--disabled {
  background: #E0E0E0;
  color: #9E9E9E;
  box-shadow: none;
}

.claim-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(76, 175, 80, 0.3);
}

.claim-btn:active {
  transform: scale(0.98);
}

.claim-btn--disabled {
  background: #E0E0E0;
  color: #9E9E9E;
  box-shadow: none;
}

/* 任务按钮通用禁用态 */
.task-btn--disabled {
  background: #E0E0E0 !important;
  color: #9E9E9E !important;
  box-shadow: none !important;
}

/* 任务区域标题 */
.task-section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 24rpx;
  padding-left: 24rpx;
  border-left: 6rpx solid #FF9800;
}

/* 任务进度 */
.task-progress {
  margin-right: 16rpx;
}

.progress-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF9800;
}

.task-claim-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  color: white;
  font-size: 24rpx;
  font-weight: 800;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  border: none;
  box-shadow: 0 4rpx 8rpx rgba(76, 175, 80, 0.2);
}

.task-claim-btn:active {
  transform: scale(0.98);
}

.task-desc {
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 500;
  display: block;
  margin-top: 4rpx;
}

/* ══════════════════════════════════════ */
/*  弹窗蒙层 & 底部弹出面板 (Bottom Sheet)  */
/* ══════════════════════════════════════ */

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
}

.bottom-sheet {
  position: fixed;
  bottom: -100%;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 80rpx 80rpx 0 0;
  border-top: 8rpx solid #FFEBB5;
  padding: 0 40rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 1000;
  transition: bottom 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.bottom-sheet--show {
  bottom: 0;
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  background: #E0D6CC;
  border-radius: 4rpx;
  margin: 20rpx auto 28rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 16rpx;
  display: block;
}

.sheet-sub-title {
  font-size: 24rpx;
  color: #A1887F;
  font-weight: 700;
  margin-bottom: 24rpx;
  display: block;
}

.sheet-close-btn {
  width: 100%;
  background: #FF9800;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 30rpx rgba(255, 152, 0, 0.3);
}

.sheet-close-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* ─── AI魔法弹框 ─── */

.magic-panel {
  background: #FFFFFF;
  padding: 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.magic-panel .sheet-handle {
  display: none;
}

.panel-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 8rpx;
  display: block;
}

.panel-sub-title {
  font-size: 24rpx;
  color: #A1887F;
  font-weight: 700;
  margin-bottom: 24rpx;
  display: block;
}

.magic-info-box {
  background: #FFF4DC;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-bottom: 48rpx;
}

.magic-info-icon {
  font-size: 28rpx;
  color: #FF9800;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.magic-info-text {
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 500;
  line-height: 1.625;
  flex: 1;
}

.magic-link-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.magic-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 32rpx;
  background: #FFF9ED;
  border: 4rpx solid #FFEBB5;
  border-radius: 32rpx;
}

.magic-link-row:active {
  background: #FFEBB5;
  transform: scale(0.97);
}

.magic-link-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #5D4037;
}

.magic-link-arrow {
  font-size: 48rpx;
  color: #FF9800;
}

/* ─── 礼品包弹框 ─── */

.gift-panel {
  background: #FFFFFF;
  height: 40vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.gift-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 32rpx;
  flex-shrink: 0;
  padding: 6rpx;
  background: #F5F0E8;
  border-radius: 24rpx;
}

.gift-tab {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.gift-tab--active {
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.gift-tab-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #A1887F;
}

.gift-tab--active .gift-tab-text {
  color: #5D4037;
}

.gift-tab-count {
  font-size: 20rpx;
  font-weight: 700;
  color: #BCAAA4;
}

.gift-tab--active .gift-tab-count {
  color: #FF9800;
}

.gift-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex: 1;
  overflow-y: auto;
  min-height: 0;
}

.gift-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #FFF9ED;
  border-radius: 20rpx;
  border: 4rpx solid #FFEBB5;
}

.gift-item--expired {
  opacity: 0.5;
}

.gift-item--used {
  opacity: 0.7;
}

.gift-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.gift-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.gift-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
}

.gift-status {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.gift-status--available {
  background: #E8F5E9;
  color: #388E3C;
}

.gift-status--used {
  background: #F5F0E8;
  color: #8C6B4B;
}

.gift-status--expired {
  background: #FBE9E7;
  color: #D84315;
}

.gift-soon-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #FF6B00;
  background: #FFF3E0;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.gift-subtitle {
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 700;
}

.gift-expire {
  font-size: 20rpx;
  color: #BCAAA4;
}

.gift-tip {
  font-size: 20rpx;
  color: #FF9800;
  font-weight: 600;
}

.gift-use-btn {
  background: #FF9800;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.gift-use-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.gift-use-btn--disabled {
  background: #E0E0E0;
  color: #9E9E9E;
}

.gift-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.gift-empty-icon {
  font-size: 72rpx;
}

.gift-empty-text {
  font-size: 24rpx;
  color: #BCAAA4;
  font-weight: 600;
}

/* ─── 任务中心弹框 ─── */

.task-panel {
  background: #FFFFFF;
  overflow: hidden;
}

.task-list-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.task-panel .checkin-section,
.task-panel .task-section-title {
  flex-shrink: 0;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #FFF9ED;
  border-radius: 20rpx;
  border: 4rpx solid #FFEBB5;
}

.task-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.task-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
}

.task-reward {
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 700;
}

.task-done-btn {
  background: #E0E0E0;
  color: #9E9E9E;
  font-size: 24rpx;
  font-weight: 700;
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.task-do-btn {
  background: #FF9800;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.task-do-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.task-claim-btn {
  background: linear-gradient(135deg, #4CAF50, #388E3C);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  padding: 16rpx 28rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 8rpx rgba(76, 175, 80, 0.2);
}

.task-claim-btn:active {
  transform: scale(0.98);
}

/* ─── 设置弹框 ─── */

/* 覆盖底部面板通用样式 */
.settings-panel {
  background: #FFFFFF;
  padding: 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.settings-panel .sheet-handle {
  display: none;
}

.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 48rpx;
}

.settings-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #5D4037;
}

.settings-close {
  width: auto;
  height: auto;
  padding: 16rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #D0B8A1;
  border-radius: 50%;
  line-height: 1;
}

.settings-close:active {
  background: #FFF9ED;
}

.settings-body {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

/* 移除了 .settings-list 改用 .settings-body */

.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: #FFF9ED;
  border: 4rpx solid #FFEBB5;
  border-radius: 32rpx;
  gap: 24rpx;
}

.settings-row-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.settings-row-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.settings-row-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #5D4037;
}

.settings-vip-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #8C6B4B;
  background: #FFEBB5;
  padding: 4rpx 6rpx;
  border-radius: 12rpx;
  line-height: 1;
}

.settings-row-desc {
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 700;
}

.settings-switch {
  flex-shrink: 0;
}

.settings-input {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  border: 2rpx solid #F5E6D3;
  border-radius: 24rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #5D4037;
  box-sizing: border-box;
  margin-top: 8rpx;
}

.settings-input::placeholder {
  color: #D0B8A1;
}

.settings-input-disabled {
  background: #F5F0E8;
  color: #BCAAA4;
  border-color: #FFF4DC;
}

.settings-row-hint {
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 700;
  text-align: right;
  margin-top: 16rpx;
}

.settings-confirm-btn {
  width: 100%;
  background: linear-gradient(to right, #FFD54F, #FF9800);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  font-size: 32rpx;
  font-weight: 800;
  color: #3E2723;
  flex-shrink: 0;
  box-shadow: 0 12rpx 40rpx rgba(255, 152, 0, 0.3);
}

.settings-confirm-btn:active {
  opacity: 0.85;
  transform: scale(0.95);
}
