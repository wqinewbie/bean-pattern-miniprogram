.page.review-page {
  min-height: 100vh;
  height: 100vh;
  background: linear-gradient(180deg, #ffefbf 0rpx, #fff9ed 220rpx, #fffdf8 100%);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.safe-area {
  width: 100%;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 38rpx;
  height: 38rpx;
}

.nav-title-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5d4037;
}

.nav-right-spacer {
  height: 72rpx;
  flex-shrink: 0;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page-body {
  padding: 12rpx 24rpx 0;
}

.top-banner,
.section-card {
  background: linear-gradient(180deg, #ffffff 0%, #fffaf0 100%);
  border-radius: 30rpx;
  border: 2rpx solid #fff0c8;
  box-shadow: 0 14rpx 36rpx rgba(255, 180, 64, 0.12);
  box-sizing: border-box;
}

.top-banner {
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.top-banner::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -90rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 213, 79, 0.22);
}

.top-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff4dc;
  color: #b7791f;
  font-size: 22rpx;
  font-weight: 800;
  position: relative;
  z-index: 1;
}

.top-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #5d4037;
  position: relative;
  z-index: 1;
}

.top-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #9b7b5b;
  position: relative;
  z-index: 1;
}

.section-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.section-head--compact {
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #5d4037;
}

.section-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #a1887f;
}

.section-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff3cf 0%, #ffe1a0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.section-icon--purple {
  background: linear-gradient(135deg, #f3ecff 0%, #dfd3ff 100%);
}

.section-icon--orange {
  background: linear-gradient(135deg, #fff3db 0%, #ffd7a0 100%);
}

.tips-box {
  padding: 24rpx 26rpx;
  background: #fffdf8;
  border-radius: 24rpx;
  border: 2rpx solid #fff0d2;
}

.tips-title {
  display: block;
  font-size: 22rpx;
  color: #a1887f;
  font-weight: 700;
}

.textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #fff7e8;
  color: #5d4037;
  font-size: 28rpx;
  line-height: 1.7;
}

.upload-grid {
  display: flex;
  gap: 18rpx;
}

.upload-item {
  flex: 1;
  height: 286rpx;
  border-radius: 24rpx;
  background: #fff7e8;
  border: 2rpx dashed #ffd180;
  position: relative;
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #a1887f;
}

.upload-empty-plus {
  font-size: 56rpx;
  line-height: 1;
  color: #ff9800;
  font-weight: 500;
}

.upload-empty-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.upload-tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(93, 64, 55, 0.72);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.upload-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22rpx 20rpx 18rpx;
  background: linear-gradient(180deg, rgba(93, 64, 55, 0) 0%, rgba(93, 64, 55, 0.84) 100%);
  color: #ffffff;
}

.upload-mask-title {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
}

.upload-mask-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  opacity: 0.92;
}

.tips-box {
  margin-top: 22rpx;
}

.tips-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #8c6b4b;
}

.page-bottom-space {
  height: 220rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx 24rpx;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0) 0%, rgba(255, 249, 237, 0.94) 24%, #fff9ed 100%);
  box-sizing: border-box;
  z-index: 20;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(135deg, #ffb74d 0%, #ff9800 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 24rpx rgba(255, 152, 0, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: normal;
}

.submit-btn--disabled {
  background: #eadfce;
  color: #b49a82;
  box-shadow: none;
}

.submit-btn[disabled] {
  opacity: 1;
}

.submit-btn::after {
  border: none;
}
