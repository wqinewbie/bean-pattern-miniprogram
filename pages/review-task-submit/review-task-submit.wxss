.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 32rpx;
  box-sizing: border-box;
}
.header {
  margin-bottom: 24rpx;
}
.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
}
.desc {
  display: block;
  font-size: 24rpx;
  color: #86909c;
  margin-top: 12rpx;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
}
.field { margin-bottom: 28rpx; }
.label {
  display: block;
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 12rpx;
}
.value {
  font-size: 30rpx;
  color: #1f2329;
}
.textarea {
  width: 100%;
  min-height: 180rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.upload-list {
  display: flex;
  gap: 20rpx;
}
.upload-box {
  width: 280rpx;
  height: 280rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.preview {
  width: 100%;
  height: 100%;
}
.upload-placeholder {
  color: #86909c;
  font-size: 24rpx;
}
.submit-btn {
  margin-top: 16rpx;
  background: #ff9800;
  color: #fff;
  border-radius: 999rpx;
}
