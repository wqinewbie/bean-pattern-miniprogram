<view class="container">

  <!-- Banner -->
  <view class="main-banner" style="margin-top: {{bannerTop}}px;" bindtap="onBannerTap">
    <image wx:if="{{currentBanner.imageUrl}}" class="banner-bg-img" src="{{currentBanner.imageUrl}}" mode="aspectFill"/>
    <view class="banner-content">
      <text class="banner-tag">{{currentBanner.tagText||'魔法上新'}}</text>
      <text class="banner-title">{{currentBanner.title||'初夏限定拼豆'}}</text>
      <text class="banner-sub">{{currentBanner.subTitle||'一键生成专属图纸'}}</text>
    </view>
  </view>

  <!-- 功能卡片 2×2 -->
  <view class="action-zone">
    <view class="card-grid-2x2">
      <view class="action-card" bindtap="onBeadPatternLocal">
        <view class="card-icon card-tilt-left pink">
          <image class="icon-img" src="/assets/icons/card-convert.svg" mode="aspectFit"/>
        </view>
        <text class="card-title">图片转图纸</text>
        <text class="card-desc">智能识别色彩</text>
      </view>
      <view class="action-card" bindtap="onBeadPatternAI">
        <view class="card-icon card-tilt-right purple">
          <image class="icon-img" src="/assets/icons/card-ai.svg" mode="aspectFit"/>
        </view>
        <text class="card-title">AI一键生成</text>
        <text class="card-desc">文字秒变图纸</text>
      </view>
      <view class="action-card" bindtap="onDrawBoard">
        <view class="card-icon card-tilt-right blue">
          <image class="icon-img" src="/assets/icons/card-draw.svg" mode="aspectFit"/>
        </view>
        <text class="card-title">空白画板</text>
        <text class="card-desc">自由创作拼豆</text>
      </view>
      <view class="action-card" bindtap="onGoMyPatterns">
        <view class="card-icon card-tilt-left orange">
          <image class="icon-img" src="/assets/icons/card-patterns.svg" mode="aspectFit"/>
        </view>
        <text class="card-title">我的图纸</text>
        <text class="card-desc">管理历史作品</text>
      </view>
    </view>
  </view>

  <!-- 魔法小课堂 -->
  <view class="tutorial-zone">
    <view class="tutorial-header">
      <view class="tutorial-title-row">
        <view class="title-bar"></view>
        <text class="tutorial-title">魔法小课堂</text>
      </view>
    </view>
    <view class="tutorial-card">
      <view class="tutorial-thumb">
        <text class="tutorial-play">▶</text>
      </view>
      <view class="tutorial-info">
        <text class="tutorial-name">新手必看：如何拼出完美立体豆？</text>
        <text class="tutorial-desc">了解熨烫技巧与温度控制，让你的作品更牢固漂亮！</text>
      </view>
    </view>
  </view>

  <view style="height:120rpx"></view>

  <!-- 离屏 Canvas -->
  <canvas canvas-id="bead-sample-canvas" style="position:fixed;left:-9999px;top:0;width:512px;height:512px;"/>
  <canvas canvas-id="bead-result-canvas" style="position:fixed;left:-9999px;top:0;width:2048px;height:2048px;"/>
  <canvas canvas-id="bead-pattern-canvas" style="position:fixed;left:-9999px;top:0;width:2048px;height:2048px;"/>

  <!-- 加载蒙层 -->
  <view wx:if="{{loading}}" class="loading-mask">
    <view class="loading-box">
      <view class="loading-spinner"></view>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>

  <!-- 登录弹窗蒙层 -->
  <view wx:if="{{showLoginModal}}" class="modal-mask" bindtap="onCloseLoginModal"></view>

  <!-- 登录弹窗 -->
  <view wx:if="{{showLoginModal}}" class="login-modal login-modal--show">
    <view class="modal-close" bindtap="onCloseLoginModal">✕</view>
    <view class="modal-magic-icon">{{isFirstLogin ? '🌟' : '🪄'}}</view>
    <text class="modal-title">{{isFirstLogin ? '微信登录' : '欢迎回来'}}</text>
    <text class="modal-sub">{{isFirstLogin ? '微信快速登录后即可使用，头像昵称可在“我的”页面补充' : '登录后可在“我的”页面补充头像昵称'}}</text>

    <view class="modal-wechat-btn modal-wechat-btn--ghost" bindtap="onQuickWxLogin">
      <text wx:if="{{!loginSubmitting}}">🟢 立即微信登录</text>
      <view wx:else class="btn-loading-row"><view class="modal-spinner"></view><text>处理中...</text></view>
    </view>

    <view class="modal-skip-btn" bindtap="onCloseLoginModal">暂不登录</view>
    <text class="modal-policy">登录即代表同意 <text class="policy-link">《用户协议》</text> 和 <text class="policy-link">《隐私政策》</text></text>
  </view>

</view>
