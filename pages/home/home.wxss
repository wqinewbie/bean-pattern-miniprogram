/* home.wxss - 首页样式 */

.home-page {
  min-height: 100vh;
  background: #FFF9ED;
  padding-bottom: 120rpx;
}

/* 欢迎卡片 */
.welcome-card {
  margin: 32rpx 32rpx 0;
  background: linear-gradient(135deg, #FFEBB5, #FFF4DC);
  border-radius: 40rpx;
  padding: 48rpx 40rpx 40rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(255, 160, 0, 0.08);
}

.welcome-deco-1 {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
}

.welcome-deco-2 {
  position: absolute;
  top: 20rpx;
  left: -60rpx;
  width: 120rpx;
  height: 120rpx;
  background: #FFD54F;
  border-radius: 50%;
  opacity: 0.2;
}

.welcome-text {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.welcome-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #5D4037;
  line-height: 1.3;
}

.welcome-sub {
  font-size: 26rpx;
  font-weight: 700;
  color: #A1887F;
}

/* Banner 轮播 */
.banner-zone {
  margin-top: 24rpx;
  position: relative;
}

.banner-scroll {
  width: 100%;
  height: 336rpx;
  white-space: nowrap;
}

.banner-card {
  display: inline-block;
  width: calc(100% - 64rpx);
  height: 288rpx;
  margin-left: 32rpx;
  margin-right: 0;
  border-radius: 40rpx;
  position: relative;
  overflow: hidden;
  border: 8rpx solid #fff;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.1);
  background: #FF9800;
  vertical-align: top;
}

.banner-card:last-child {
  margin-right: 32rpx;
}

.banner-bg-img {
  position: absolute;
  top: 0;
  right: 0;
  width: 50%;
  height: 100%;
  z-index: 0;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 50%;
  bottom: 0;
  background: linear-gradient(to right, rgba(255, 152, 0, 0.85), rgba(255, 183, 77, 0.6));
  z-index: 1;
}

.banner-card-content {
  position: absolute;
  left: 48rpx;
  top: 0;
  bottom: 0;
  width: 45%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  z-index: 2;
}

.banner-tag {
  font-size: 20rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  color: #fff;
  width: fit-content;
  margin-bottom: 16rpx;
}

.banner-main-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.4;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.banner-sub-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 功能卡片 */
.action-zone {
  padding: 0 32rpx;
  margin-top: 24rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.action-card {
  background: #fff;
  border-radius: 64rpx;
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 16rpx 40rpx rgba(140, 107, 75, 0.08);
  border: 4rpx solid #FFF4DC;
  transition: transform 0.15s ease;
  height: 320rpx;
  box-sizing: border-box;
}

.action-card:active {
  transform: scale(0.97);
}

.action-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.08);
}

.icon-pink {
  background: #FFE5E5;
  color: #FF6B6B;
  transform: rotate(-3deg);
}

.icon-purple {
  background: #F3E5F5;
  color: #9C27B0;
  transform: rotate(3deg);
}

.icon-blue {
  background: #E3F2FD;
  color: #0288D1;
  transform: rotate(3deg);
}

.icon-orange {
  background: #FFF3E0;
  color: #FF9800;
  transform: rotate(-3deg);
}

.icon-img {
  width: 56rpx;
  height: 56rpx;
}

.action-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #5D4037;
  text-align: center;
}

.action-desc {
  font-size: 22rpx;
  font-weight: 700;
  color: #A1887F;
  text-align: center;
}

/* 魔法小课堂 */
.tutorial-zone {
  margin: 48rpx 32rpx 0;
}

.tutorial-header {
  margin-bottom: 24rpx;
}

.tutorial-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.title-bar {
  width: 6rpx;
  height: 40rpx;
  background: #FF6B6B;
  border-radius: 4rpx;
}

.tutorial-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5D4037;
}

.tutorial-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.tutorial-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(140, 107, 75, 0.05);
  border: 4rpx solid #FFF4DC;
  transition: transform 0.15s ease;
}

.tutorial-card:active {
  transform: scale(0.98);
}

.tutorial-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FF9800, #FFD54F);
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.tutorial-thumb-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
}

.tutorial-play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 56rpx;
  color: rgba(255, 255, 255, 0.9);
}

.tutorial-thumb-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.2);
}

.tutorial-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tutorial-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #5D4037;
  line-height: 1.4;
}

.tutorial-desc {
  font-size: 22rpx;
  color: #A1887F;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 底部占位 */
.bottom-space {
  height: 120rpx;
}

/* Loading */
.loading-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-box {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: #FACC15;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

/* 登录弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(93, 64, 55, 0.4);
  z-index: 999;
}

.login-modal {
  position: fixed;
  bottom: -100%;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 32rpx 48rpx 80rpx;
  z-index: 1000;
  transition: bottom 0.35s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  border-top: 8rpx solid #FFEBB5;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.login-modal--show {
  bottom: 0;
}

.modal-close {
  position: absolute;
  top: 32rpx;
  right: 40rpx;
  font-size: 36rpx;
  color: #D0B8A1;
  padding: 8rpx;
}

.modal-magic-icon {
  width: 120rpx;
  height: 120rpx;
  background: #FFF4DC;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  border: 8rpx solid #FFEBB5;
  margin-top: 24rpx;
}

.modal-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #5D4037;
  margin-top: 8rpx;
}

.modal-sub {
  font-size: 26rpx;
  color: #A1887F;
  margin-top: -8rpx;
  text-align: center;
}

.modal-wechat-btn {
  width: 100%;
  height: 104rpx;
  background: #07C160;
  border-radius: 52rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  border-bottom: 8rpx solid #05964B;
  margin-top: 8rpx;
}

.modal-wechat-btn:active {
  opacity: 0.85;
}

.modal-wechat-btn--ghost {
  background: #EAF9F0;
  color: #0F8F4D;
  box-shadow: none;
  border: 4rpx solid #BDECCF;
  border-bottom: 4rpx solid #8DD8AE;
}

.modal-wechat-btn--ghost .modal-spinner {
  border: 5rpx solid rgba(15, 143, 77, 0.18);
  border-top-color: #0F8F4D;
}

.btn-loading-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.modal-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.modal-skip-btn {
  width: 100%;
  height: 96rpx;
  background: #FFF9ED;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #8C6B4B;
}

.modal-skip-btn:active {
  background: #FFEBB5;
}

.modal-policy {
  font-size: 22rpx;
  color: #D0B8A1;
  text-align: center;
}

.policy-link {
  color: #FF9800;
}
