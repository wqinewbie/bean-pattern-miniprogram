/* home.wxss - 首页样式（对标图1） */

.container {
  min-height: 100vh;
  background: #FFF9ED;
  padding-bottom: 120rpx;
}

/* ─── 搜索栏（隐藏） ─── */
.search-bar {
  display: none;
}

.search-input-wrap {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.search-icon {
  font-size: 28rpx;
  color: #D0B8A1;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #5D4037;
  background: transparent;
  border: none;
  outline: none;
}

.search-placeholder {
  color: #D0B8A1;
}

.search-fire {
  width: 72rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

/* ─── Banner ─── */
.main-banner {
  margin: 0 32rpx 0;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  border-radius: 40rpx;
  height: 200rpx;
  padding: 36rpx;
  box-shadow: 0 16rpx 60rpx rgba(255,152,0,0.3);
  border: 4rpx solid #fff;
  overflow: hidden;
  position: relative;
}

.banner-bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.banner-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  position: relative;
  z-index: 2;
}

.banner-tag {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.2);
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  width: fit-content;
  margin-bottom: 8rpx;
}

.banner-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.banner-sub {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.85);
}

/* ─── 功能卡片 ─── */
.action-zone {
  padding: 26rpx 32rpx 0;
}

.card-grid-2x2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
}

.action-card {
  background: #fff;
  border-radius: 40rpx;
  height: 332rpx;
  box-sizing: border-box;
  padding: 18rpx 14rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-shadow: 0 12rpx 26rpx rgba(140,107,75,0.08);
  border: 3rpx solid #FFEBC8;
  transition: transform 0.15s ease;
}

.action-card:active {
  transform: scale(0.97);
}

.card-icon {
  width: 132rpx;
  height: 132rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-shadow: 0 8rpx 18rpx rgba(0,0,0,0.09);
  border: 2rpx solid rgba(255,255,255,0.7);
}

.card-tilt-left {
  transform: rotate(-3deg);
}

.card-tilt-right {
  transform: rotate(3deg);
}

.card-icon.pink    { background: linear-gradient(145deg, #FFE5E5, #FFD4D4); }
.card-icon.purple  { background: linear-gradient(145deg, #F3E5F5, #EAD1F0); }
.card-icon.blue    { background: linear-gradient(145deg, #E3F2FD, #D1E9FA); }
.card-icon.orange  { background: linear-gradient(145deg, #FFF3E0, #FFE7C7); }

.icon-img {
  width: 78rpx;
  height: 78rpx;
  display: block;
}

.icon-text {
  display: block;
  line-height: 1;
}

.card-title {
  display: block;
  font-size: 33rpx;
  font-weight: 800;
  color: #5A3E2A;
  text-align: center;
  letter-spacing: 0.3rpx;
}

.card-desc {
  display: block;
  font-size: 24rpx;
  color: #A1887F;
  font-weight: 650;
  text-align: center;
}

/* ─── 魔法小课堂 ─── */
.tutorial-zone {
  margin: 36rpx 32rpx 0;
}

.tutorial-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.tutorial-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.title-bar {
  width: 6rpx;
  height: 40rpx;
  background: #FF6B6B;
  border-radius: 4rpx;
}

.tutorial-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5D4037;
}

.tutorial-more { font-size: 24rpx; color: #A1887F; }

.tutorial-card {
  background: #fff;
  border-radius: 36rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(140,107,75,0.05);
  border: 2rpx solid #FFF4DC;
  margin-bottom: 20rpx;
}

.tutorial-card:active { transform: scale(0.98); }

.tutorial-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FF9800, #FFD54F);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tutorial-thumb.purple {
  background: linear-gradient(135deg, #9C27B0, #E040FB);
}

.tutorial-play {
  font-size: 48rpx;
  color: rgba(255,255,255,0.9);
}

.tutorial-thumb-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
}

.tutorial-info { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }

.tutorial-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #5D4037;
  line-height: 1.4;
}

.tutorial-desc {
  display: block;
  font-size: 20rpx;
  color: #A1887F;
  line-height: 1.5;
  overflow: hidden;
}

/* ─── Loading ─── */
.loading-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-box {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: #FACC15;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text { font-size: 28rpx; color: #666; font-weight: 500; }

/* ─── 登录弹窗 ─── */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(93,64,55,0.4);
  z-index: 999;
}

.login-modal {
  position: fixed;
  bottom: -100%;
  left: 0; right: 0;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 32rpx 48rpx 80rpx;
  z-index: 1000;
  transition: bottom 0.35s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  border-top: 4rpx solid #FFEBB5;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.login-modal--show { bottom: 0; }

.modal-close {
  position: absolute;
  top: 32rpx; right: 40rpx;
  font-size: 36rpx; color: #D0B8A1;
  padding: 8rpx;
}

.modal-magic-icon {
  width: 120rpx; height: 120rpx;
  background: #FFF4DC;
  border-radius: 40rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx;
  border: 4rpx solid #FFEBB5;
  margin-top: 24rpx;
}

.modal-title { font-size: 44rpx; font-weight: 700; color: #5D4037; margin-top: 8rpx; }
.modal-sub   { font-size: 26rpx; color: #A1887F; margin-top: -8rpx; text-align: center; }

.modal-wechat-btn {
  width: 100%;
  height: 104rpx;
  background: #07C160;
  border-radius: 52rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.3);
  border-bottom: 4rpx solid #05964B;
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  line-height: 1;
}

.modal-wechat-btn:active { opacity: 0.85; }

.modal-wechat-btn--ghost {
  background: #EAF9F0;
  color: #0F8F4D;
  box-shadow: none;
  border: 2rpx solid #BDECCF;
  border-bottom: 2rpx solid #8DD8AE;
}

.modal-wechat-btn--ghost .modal-spinner {
  border: 5rpx solid rgba(15,143,77,0.18);
  border-top-color: #0F8F4D;
}

.btn-loading-row { display: flex; align-items: center; gap: 16rpx; }

.modal-spinner {
  width: 40rpx; height: 40rpx;
  border: 5rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.modal-skip-btn {
  width: 100%;
  height: 96rpx;
  background: #FFF9ED;
  border-radius: 48rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700; color: #8C6B4B;
}

.modal-skip-btn:active { background: #FFEBB5; }

.modal-policy { font-size: 22rpx; color: #D0B8A1; text-align: center; }
.policy-link  { color: #FF9800; }

.modal-phone-btn {
  width: 100%;
  height: 104rpx;
  background: #07C160;
  border-radius: 52rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.3);
  border-bottom: 4rpx solid #05964B;
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  line-height: 1;
}

.modal-phone-btn:active { opacity: 0.85; }

.modal-avatar-btn {
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50% !important;
  background: #FFF4DC !important;
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
  box-sizing: border-box;
}

.modal-avatar-btn::after {
  border: none !important;
  border-radius: 50% !important;
}

.modal-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
}

.modal-avatar-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 48rpx;
}

.modal-avatar-hint {
  font-size: 20rpx;
  color: #A1887F;
  font-weight: 700;
}

.modal-nick-input {
  width: 100%;
  height: 96rpx;
  background: #FFF9ED;
  border-radius: 48rpx;
  padding: 0 40rpx;
  font-size: 30rpx;
  color: #5D4037;
  box-sizing: border-box;
  border: 2rpx solid #FFEBB5;
}
