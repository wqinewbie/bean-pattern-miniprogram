      </view>
      
      <!-- 右下角颜色栏触发按钮 -->
      <view class="toolbar-trigger bottom" bindtap="onToggleColorbar">
        <text class="trigger-icon">{{colorbarExpanded ? '✕' : '🎨'}}</text>
      </view>
xt>
