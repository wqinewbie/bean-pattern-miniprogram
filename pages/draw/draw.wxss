/* draw.wxss - 对标参考项目的画板风格 */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F5;
}

.top-bar {
  height: 88rpx;
  padding-top: 64rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
  padding-right: 20rpx;
  border-bottom: 1rpx solid #ECECEC;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.04);
}
.top-back, .top-search {
  width: 56rpx;
  text-align: center;
  font-size: 38rpx;
  color: #666;
}
.top-center-tabs {
  flex: 1;
  margin: 0 20rpx;
  background: #F1F1F1;
  border-radius: 18rpx;
  padding: 6rpx;
  display: flex;
  gap: 6rpx;
}
.top-tab {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #777;
  font-weight: 700;
  line-height: 44rpx;
  border-radius: 12rpx;
}
.top-tab--active {
  background: #fff;
  color: #222;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.toolbar {
  background: #fff;
  border-bottom: 1rpx solid #EFEFEF;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  overflow-x: auto;
}
.brand-picker {
  flex-shrink: 0;
}
.brand-picker-inner {
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #4A4A4A;
  background: #F2F2F2;
  font-weight: 700;
}
.color-count-badge {
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #FF9800;
  background: #FFF4DC;
  border: 1rpx solid #F7DFB3;
  font-weight: 700;
}
.color-count-badge--loading {
  color: #5C6BC0;
  background: #EAF0FF;
  border-color: #C8D8FF;
}

.toolbar-btn {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  background: #F7F7F7;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.toolbar-btn--disabled { opacity: 0.35; }
.toolbar-divider { width: 1rpx; height: 32rpx; background: #E6E6E6; margin: 0 6rpx; flex-shrink: 0; }
.toolbar-text-btn {
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
  background: #F7F7F7;
  font-weight: 700;
  flex-shrink: 0;
}
.toolbar-text-btn--danger { color: #E64B4B; }
.toolbar-spacer { flex: 1; }

.canvas-area {
  flex: 1;
  position: relative;
  overflow: hidden;
  background: #fff;
  background-image: linear-gradient(to right, #F0F0F0 1px, transparent 1px), linear-gradient(to bottom, #F0F0F0 1px, transparent 1px);
  background-size: 20px 20px;
}
.draw-canvas {
  position: absolute;
  left: 50%;
  top: 50%;
  background: #fff;
  border: 2rpx solid #ECECEC;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
}

.export-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1024px;
  height: 1024px;
}

.float-tools {
  position: absolute;
  right: 20rpx;
  top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.float-btn {
  width: 82rpx;
  height: 82rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.92);
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.float-btn--active {
  background: #1A1A1A;
}
.float-btn--active .float-icon,
.float-btn--active .float-label {
  color: #fff;
}
.float-icon { font-size: 28rpx; color: #555; line-height: 1; }
.float-label { font-size: 16rpx; color: #777; margin-top: 2rpx; }

.bottom-panel {
  background: #fff;
  border-radius: 34rpx 34rpx 0 0;
  box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.06);
  padding-bottom: calc(26rpx + env(safe-area-inset-bottom));
}
.tool-row {
  display: flex;
  justify-content: space-around;
  padding: 18rpx 20rpx 14rpx;
  border-bottom: 1rpx solid #F1F1F1;
}
.tool-btn {
  width: 120rpx;
  border-radius: 20rpx;
  padding: 12rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.tool-btn--active { background: #1A1A1A; }
.tool-btn-icon { font-size: 32rpx; color: #666; }
.tool-btn-label { font-size: 20rpx; color: #666; font-weight: 700; }
.tool-btn--active .tool-btn-icon,
.tool-btn--active .tool-btn-label { color: #fff; }

.size-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  border-bottom: 1rpx solid #F2F2F2;
}
.size-ctrl {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F3F3F3;
  border-radius: 40rpx;
  padding: 8rpx 18rpx;
}
.size-btn { font-size: 34rpx; color: #666; width: 36rpx; text-align: center; }
.size-val { font-size: 26rpx; font-weight: 800; color: #333; min-width: 28rpx; text-align: center; }
.size-extras { display: flex; gap: 16rpx; }
.extra-item { padding: 8rpx 12rpx; }
.extra-label { font-size: 22rpx; color: #777; font-weight: 700; }
.extra-label--on { color: #FF9800; }

.palette-scroll { white-space: nowrap; }
.palette-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx 6rpx;
}
.current-color-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-right: 10rpx;
}
.current-color {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E4E4E4;
}
.current-label { font-size: 18rpx; color: #666; font-weight: 800; }
.current-name { font-size: 16rpx; color: #999; max-width: 90rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.palette-item {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  border: 4rpx solid transparent;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.10);
}
.palette-item-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.palette-code {
  font-size: 16rpx;
  color: #888;
  max-width: 72rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.palette-item--active {
  border-color: #111;
  transform: scale(1.1);
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.42);
  z-index: 99;
}
.color-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 520rpx;
  background: #fff;
  border-radius: 26rpx;
  padding: 26rpx;
  z-index: 100;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.22);
}
.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #222;
  margin-bottom: 16rpx;
}
.modal-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #555;
  padding: 8rpx 0;
}
.modal-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}
.modal-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  background: #F1F1F1;
  color: #555;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-btn--save {
  background: #FF9800;
  color: #fff;
}
