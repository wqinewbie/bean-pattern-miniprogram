/* draw.wxss - 空白画板页面 */

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFF9ED;
}

/* ─── 顶部导航 ─── */
.top-bar {
  height: 88rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  padding-top: 80rpx;
  border-bottom: 2rpx solid #FFF4DC;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(140,107,75,0.05);
}

.top-back {
  font-size: 40rpx;
  color: #8C6B4B;
  width: 60rpx;
  text-align: center;
}

.top-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  flex: 1;
  text-align: center;
}

.top-search {
  font-size: 32rpx;
  width: 60rpx;
  text-align: center;
}

/* ─── 标签页 ─── */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 32rpx;
  border-bottom: 2rpx solid #FFF4DC;
  flex-shrink: 0;
}

.tab {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #A1887F;
  position: relative;
}

.tab--active {
  color: #5D4037;
}

.tab--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background: #FF9800;
  border-radius: 2rpx;
}

/* ─── 工具栏 ─── */
.toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid #FFF4DC;
  flex-shrink: 0;
  overflow-x: auto;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  transition: background 0.15s;
}

.tool-item:active { background: #FFF4DC; }

.tool-item--disabled {
  opacity: 0.4;
  pointer-events: none;
}

.tool-item--danger {
  color: #FF6B6B;
}

.tool-icon {
  font-size: 28rpx;
  line-height: 1;
}

.tool-label {
  font-size: 18rpx;
  font-weight: 700;
  color: #8C6B4B;
}

/* ─── 画布区域 ─── */
.canvas-area {
  flex: 1;
  position: relative;
  overflow: hidden;
  background-image: linear-gradient(to right, #E8E8E8 1px, transparent 1px),
                    linear-gradient(to bottom, #E8E8E8 1px, transparent 1px);
  background-size: 20px 20px;
  background-color: #FFF9ED;
}

.draw-canvas {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(140,107,75,0.1);
  border-radius: 12rpx;
}

/* ─── 右侧浮动工具 ─── */
.float-tools {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.float-btn {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(140,107,75,0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transition: transform 0.15s;
}

.float-btn:active { transform: scale(0.92); }

.float-icon {
  font-size: 36rpx;
  line-height: 1;
  color: #8C6B4B;
}

.float-label {
  font-size: 18rpx;
  color: #A1887F;
  font-weight: 700;
}

/* ─── 底部工具面板 ─── */
.bottom-panel {
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(140,107,75,0.08);
  flex-shrink: 0;
  padding-bottom: 40rpx;
  border-top: 4rpx solid #FFF4DC;
}

.tool-row {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx 16rpx;
  border-bottom: 2rpx solid #FFF9ED;
}

.tool-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  transition: background 0.15s;
}

.tool-btn:active { opacity: 0.7; }

.tool-btn--active {
  background: #1a1a1a;
}

.tool-btn--active .tool-icon,
.tool-btn--active .tool-label {
  color: #fff;
}

.tool-icon {
  font-size: 40rpx;
  line-height: 1;
  color: #8C6B4B;
}

.tool-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #A1887F;
}

.size-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  border-bottom: 2rpx solid #FFF9ED;
}

.size-ctrl {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #FFF9ED;
  border-radius: 40rpx;
  padding: 8rpx 24rpx;
}

.size-btn {
  font-size: 40rpx;
  color: #8C6B4B;
  font-weight: 700;
  width: 48rpx;
  text-align: center;
  line-height: 1;
}

.size-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #5D4037;
  width: 32rpx;
  text-align: center;
}

.size-extras {
  display: flex;
  gap: 24rpx;
}

.extra-item {
  padding: 8rpx 16rpx;
}

.extra-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #A1887F;
}

.extra-label--on {
  color: #FF9800;
}

.palette-scroll {
  white-space: nowrap;
}

.palette-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
}

.current-color-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.current-color {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  border: 4rpx solid #FFF4DC;
  box-shadow: 0 4rpx 12rpx rgba(140,107,75,0.1);
}

.current-label {
  font-size: 18rpx;
  color: #A1887F;
  font-weight: 700;
}

.palette-item {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(140,107,75,0.1);
  transition: transform 0.15s;
}

.palette-item:active { transform: scale(0.9); }

.palette-item--active {
  border-color: #5D4037;
  transform: scale(1.15);
}
