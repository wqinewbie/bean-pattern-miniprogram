/* ========================================
   简洁扁平化设计
   ======================================== */

page {
  height: 100vh;
  overflow: hidden;
  background: #1A1A2E;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #1A1A2E;
  color: #FFFFFF;
}

/* ========================================
   顶部导航
   ======================================== */
.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 60rpx 32rpx 0;
  background: #16213E;
}

.nav-left, .nav-right {
  width: 80rpx;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.nav-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2D2D44;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #FFFFFF;
}

.nav-icon.save {
  background: #4CAF50;
}

/* ========================================
   画布区域
   ======================================== */
.canvas-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  position: relative;
}

.canvas-area {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.canvas {
  display: block;
}

.grid-info {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ========================================
   工具栏
   ======================================== */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  background: #16213E;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.tool-group {
  display: flex;
  gap: 12rpx;
}

.tool {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2D2D44;
  border-radius: 18rpx;
  transition: all 0.2s;
}

.tool .icon {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.7);
}

.tool.active {
  background: #FF6B35;
}

.tool.active .icon {
  color: #FFFFFF;
}

.tool.small {
  width: 60rpx;
  height: 60rpx;
}

.tool.small .icon {
  font-size: 28rpx;
}

.divider-v {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.15);
}

/* 笔刷大小 */
.brush-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #2D2D44;
  border-radius: 20rpx;
}

.brush {
  width: 24rpx;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  transition: all 0.2s;
}

.brush.active {
  background: #FFFFFF;
  transform: scale(1.2);
}

.brush:nth-child(2) {
  width: 30rpx;
  height: 30rpx;
}

.brush:nth-child(3) {
  width: 36rpx;
  height: 36rpx;
}

/* 开关 */
.toggle-group {
  display: flex;
  gap: 8rpx;
}

.toggle {
  padding: 10rpx 16rpx;
  background: #2D2D44;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  transition: all 0.2s;
}

.toggle.active {
  background: #FF6B35;
  color: #FFFFFF;
}

/* ========================================
   颜色栏
   ======================================== */
.colorbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx;
  background: #16213E;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.current {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.color-swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.color-code {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
}

.palette {
  flex: 1;
  white-space: nowrap;
}

.colors {
  display: inline-flex;
  gap: 8rpx;
  padding: 4rpx;
}

.color {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.color.active {
  border-color: #FFFFFF;
  transform: scale(1.15);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

/* ========================================
   底部按钮
   ======================================== */
.bottom-bar {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #16213E;
}

.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.btn.secondary {
  background: #2D2D44;
  color: rgba(255, 255, 255, 0.8);
}

.btn.primary {
  background: #FF6B35;
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.4);
}

/* ========================================
   弹窗
   ======================================== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 99;
}

.modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #2D2D44;
  border-radius: 24rpx;
  padding: 32rpx;
  z-index: 100;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1A1A2E;
  border-radius: 50%;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.7);
}

.modal-body {
  margin-bottom: 32rpx;
}

.modal-color {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  margin: 0 auto 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

.modal-info {
  background: #1A1A2E;
  border-radius: 16rpx;
  padding: 20rpx;
}

.info-line {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-line .label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.info-line .value {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1A1A2E;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
}

.modal-btn.primary {
  background: #FF6B35;
  color: #FFFFFF;
}
