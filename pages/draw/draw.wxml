<view class="container">

  <!-- 顶部导航 -->
  <view class="top-bar">
    <view class="top-back" bindtap="onBack">←</view>
    <view class="top-title">空白画板</view>
    <view class="top-search" bindtap="onSearch">🔍</view>
  </view>

  <!-- 标签页 -->
  <view class="tab-bar">
    <view class="tab {{activeTab==='draw'?'tab--active':''}}" bindtap="onTabChange" data-tab="draw">拼豆</view>
    <view class="tab {{activeTab==='material'?'tab--active':''}}" bindtap="onTabChange" data-tab="material">素材</view>
  </view>

  <!-- 工具栏 -->
  <view class="toolbar">
    <view class="tool-item {{canUndo?'':'tool-item--disabled'}}" bindtap="onUndo">
      <text class="tool-icon">↶</text>
      <text class="tool-label">撤销</text>
    </view>
    <view class="tool-item {{canRedo?'':'tool-item--disabled'}}" bindtap="onRedo">
      <text class="tool-icon">↷</text>
      <text class="tool-label">重做</text>
    </view>
    <view class="tool-item" bindtap="onFinish">
      <text class="tool-icon">✓</text>
      <text class="tool-label">完成</text>
    </view>
    <view class="tool-item" bindtap="onDraft">
      <text class="tool-icon">📝</text>
      <text class="tool-label">草稿</text>
    </view>
    <view class="tool-item" bindtap="onPreview">
      <text class="tool-icon">👁</text>
      <text class="tool-label">预览</text>
    </view>
    <view class="tool-item" bindtap="onGrid">
      <text class="tool-icon">⊞</text>
      <text class="tool-label">圈</text>
    </view>
    <view class="tool-item tool-item--danger" bindtap="onClear">
      <text class="tool-icon">✕</text>
      <text class="tool-label">清空</text>
    </view>
  </view>

  <!-- 画布区域 -->
  <view class="canvas-area">
    <canvas canvas-id="draw-canvas" class="draw-canvas"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
    />

    <!-- 右侧浮动工具 -->
    <view class="float-tools">
      <view class="float-btn" bindtap="onCenter">
        <text class="float-icon">⊕</text>
        <text class="float-label">缩位</text>
      </view>
      <view class="float-btn" bindtap="onFlip">
        <text class="float-icon">⇅</text>
        <text class="float-label">翻转</text>
      </view>
      <view class="float-btn" bindtap="onGrab">
        <text class="float-icon">✋</text>
        <text class="float-label">抓手</text>
      </view>
    </view>
  </view>

  <!-- 底部工具面板 -->
  <view class="bottom-panel">

    <!-- 工具选择行 -->
    <view class="tool-row">
      <view class="tool-btn {{activeTool==='brush'?'tool-btn--active':''}}" bindtap="onToolTap" data-tool="brush">
        <text class="tool-icon">✏️</text>
        <text class="tool-label">画笔</text>
      </view>
      <view class="tool-btn {{activeTool==='eraser'?'tool-btn--active':''}}" bindtap="onToolTap" data-tool="eraser">
        <text class="tool-icon">⬜</text>
        <text class="tool-label">橡皮</text>
      </view>
      <view class="tool-btn {{activeTool==='fill'?'tool-btn--active':''}}" bindtap="onToolTap" data-tool="fill">
        <text class="tool-icon">🪣</text>
        <text class="tool-label">填充</text>
      </view>
      <view class="tool-btn {{activeTool==='picker'?'tool-btn--active':''}}" bindtap="onToolTap" data-tool="picker">
        <text class="tool-icon">🎨</text>
        <text class="tool-label">取色</text>
      </view>
    </view>

    <!-- 画笔大小行 -->
    <view class="size-row">
      <view class="size-ctrl">
        <view class="size-btn" bindtap="onSizeMinus">−</view>
        <text class="size-val">{{brushSize}}</text>
        <view class="size-btn" bindtap="onSizePlus">+</view>
      </view>
      <view class="size-extras">
        <view class="extra-item" bindtap="onSymmetry">
          <text class="extra-label {{symmetry?'extra-label--on':''}}">对称</text>
        </view>
        <view class="extra-item">
          <text class="extra-label">{{gridSize}}×{{gridSize}}</text>
        </view>
      </view>
    </view>

    <!-- 调色板行 -->
    <scroll-view scroll-x class="palette-scroll">
      <view class="palette-row">
        <view class="current-color-wrap">
          <view class="current-color" style="background:{{currentColor}}"></view>
          <text class="current-label">点击查看</text>
        </view>
        <view wx:for="{{colors}}" wx:key="*this"
          class="palette-item {{currentColor===item?'palette-item--active':''}}"
          style="background:{{item}}"
          bindtap="onColorTap" data-color="{{item}}">
        </view>
      </view>
    </scroll-view>

  </view>

</view>
