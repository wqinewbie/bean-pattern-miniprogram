<wxs module="gesture" src="./draw-gesture.wxs" />

<view class="page">
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar-inner" style="height: {{navBarHeight}}px;">
      <view class="top-bar-left">
        <view class="back-btn" bindtap="onBack">
          <image class="back-icon" src="/assets/icons/lucide-arrow-left-brown.svg" mode="aspectFit"/>
        </view>
        <view class="action-btn" bindtap="onExport">
          <text class="action-text">预览</text>
        </view>
        <view class="action-btn" bindtap="onSaveToBox">
          <text class="action-text">保存到图纸箱</text>
        </view>
        <view class="action-btn primary" bindtap="onSave">
          <text class="action-text">保存到草稿箱</text>
        </view>
      </view>
      <view class="top-bar-right">
        <view wx:if="{{backgroundImage && activeLayer == 'canvas'}}" class="layer-badge canvas-layer">画布</view>
        <view wx:elif="{{backgroundImage}}" class="layer-badge background-layer">背景</view>
      </view>
    </view>
  </view>

  <view class="main-area">
    <view class="left-toolbar-container {{showSettings ? 'settings-open' : ''}} {{settingsClosing ? 'settings-closing' : ''}}" style="--colorbar-height: {{colorbarHeight}}rpx;">
      <view wx:if="{{showSettings || settingsClosing}}" class="settings-panel {{settingsClosing ? 'closing' : ''}}" catchtap="stopPropagation">
        <view class="settings-header">
          <view class="settings-title">
            <text class="settings-icon">⚙</text>
            <text class="settings-text">画布设置</text>
          </view>
          <view class="settings-close" bindtap="onCloseSettings">
            <text class="close-icon">×</text>
          </view>
        </view>
        <view class="settings-body">
          <view class="setting-section">
            <view class="setting-label-text">画布尺寸</view>
            <view class="setting-dropdown {{sizeDropdownOpen?'open':''}}" bindtap="onToggleSizeDropdown">
              <text class="dropdown-value">{{isPresetSize ? gridSize + "x" + gridSize : customSize + "x" + customSize}}</text>
              <text class="dropdown-arrow">{{sizeDropdownOpen ? "^" : "v"}}</text>
            </view>
            <view wx:if="{{sizeDropdownOpen}}" class="dropdown-panel">
              <view class="dropdown-list">
                <view
                  wx:for="{{presetSizes}}"
                  wx:key="*this"
                  class="dropdown-item {{isPresetSize && gridSize==item?'active':''}}"
                  bindtap="onSelectPresetSize"
                  data-size="{{item}}"
                >
                  <text class="item-text">{{item}}x{{item}}</text>
                </view>
              </view>
            </view>
          </view>

          <view class="setting-section">
            <view class="setting-label-text">自定义尺寸</view>
            <view class="custom-size-input-wrapper">
              <input
                class="setting-custom-input {{!isPresetSize && customSize!=''?'active':''}}"
                type="number"
                value="{{customSize}}"
                placeholder="16~200"
                bindinput="onCustomSizeInput"
                bindconfirm="onCustomSizeConfirm"
              />
              <view class="custom-size-confirm-btn" bindtap="onCustomSizeConfirm">
                <text class="confirm-btn-text">确定</text>
              </view>
            </view>
          </view>

          <view class="setting-section">
            <view class="setting-label-text">品牌</view>
            <view class="setting-dropdown {{brandDropdownOpen?'open':''}}" bindtap="onToggleBrandDropdown">
              <text class="dropdown-value">{{brand}}</text>
              <text class="dropdown-arrow">{{brandDropdownOpen ? "^" : "v"}}</text>
            </view>
            <view wx:if="{{brandDropdownOpen}}" class="dropdown-panel">
              <view class="dropdown-list">
                <view
                  wx:for="{{brandList}}"
                  wx:key="*this"
                  class="dropdown-item {{brand==item?'active':''}}"
                  bindtap="onSelectBrand"
                  data-brand="{{item}}"
                >
                  <text class="item-text">{{item}}</text>
                  <text wx:if="{{brand==item}}" class="item-check">✓</text>
                </view>
              </view>
            </view>
          </view>

          <view class="setting-section">
            <view class="setting-label-text">色板</view>
            <view class="setting-dropdown {{paletteDropdownOpen?'open':''}}" bindtap="onTogglePaletteDropdown">
              <text class="dropdown-value">{{selectedKitName || (colors.length + " colors")}}</text>
              <text class="dropdown-arrow">{{paletteDropdownOpen ? "^" : "v"}}</text>
            </view>
            <view wx:if="{{paletteDropdownOpen}}" class="dropdown-panel">
              <view class="dropdown-list">
                <view
                  wx:for="{{kitList}}"
                  wx:key="id"
                  class="dropdown-item {{selectedKitId==item.id?'active':''}}"
                  bindtap="onSelectKit"
                  data-kit-id="{{item.id}}"
                  data-kit-name="{{item.name}}"
                >
                  <text class="item-text">{{item.name}}</text>
                  <text wx:if="{{selectedKitId==item.id}}" class="item-check">✓</text>
                </view>
              </view>
            </view>
          </view>

          <view class="setting-section">
            <view class="setting-label-text">背景图</view>
            <view wx:if="{{backgroundImage}}" class="bg-actions">
              <view class="bg-btn" bindtap="onChooseBackground">
                <text class="bg-btn-icon">+</text>
                <text class="bg-btn-text">更换图片</text>
              </view>
              <view class="bg-btn danger" bindtap="onClearBackground">
                <text class="bg-btn-icon">×</text>
              </view>
            </view>
            <view wx:else class="bg-upload" bindtap="onChooseBackground">
              <text class="upload-icon">+</text>
              <text class="upload-text">上传背景图</text>
            </view>
          </view>
        </view>
      </view>

      <scroll-view class="tools-rail" scroll-y="true" enable-flex="true">
        <view class="tool-icon {{showSettings?'active':''}}" bindtap="onToggleSettings">
          <image class="icon" src="/assets/icons/draw-settings.svg" mode="aspectFit" />
          <text class="label">设置</text>
        </view>
        <view class="tool-divider"></view>

        <view class="tool-icon {{activeLayer=='canvas'?'active':''}}" bindtap="onSetActiveLayer" data-layer="canvas">
          <image class="icon" src="/assets/icons/draw-grid.svg" mode="aspectFit" />
          <text class="label">画布</text>
        </view>

        <view class="tool-icon {{activeLayer=='background'?'active':''}} {{!backgroundImage?'disabled':''}}" bindtap="onSetActiveLayer" data-layer="background">
          <image class="icon" src="/assets/icons/draw-image.svg" mode="aspectFit" />
          <text class="label">背景</text>
        </view>

        <view class="tool-icon {{locked?'active':''}} {{!backgroundImage?'disabled':''}}" bindtap="onToggleLock">
          <image class="icon" src="{{locked?'/assets/icons/draw-lock.svg':'/assets/icons/draw-unlock.svg'}}" mode="aspectFit" />
          <text class="label">锁定</text>
        </view>
        <view class="tool-divider"></view>

        <view class="tool-icon {{tool=='drag'?'active':''}}" bindtap="onSelectTool" data-tool="drag">
          <image class="icon" src="/assets/icons/draw-hand.svg" mode="aspectFit" />
          <text class="label">拖拽</text>
        </view>

        <view class="tool-icon {{tool=='pen'?'active':''}} {{activeLayer=='background'?'disabled':''}}" bindtap="onSelectTool" data-tool="pen">
          <image class="icon" src="/assets/icons/draw-pen.svg" mode="aspectFit" />
          <text class="label">画笔</text>
        </view>

        <view class="tool-icon {{tool=='eraser'?'active':''}} {{activeLayer=='background'?'disabled':''}}" bindtap="onSelectTool" data-tool="eraser">
          <image class="icon" src="/assets/icons/draw-eraser.svg" mode="aspectFit" />
          <text class="label">橡皮</text>
        </view>

        <view class="tool-icon {{tool=='fill'?'active':''}} {{activeLayer=='background'?'disabled':''}}" bindtap="onSelectTool" data-tool="fill">
          <image class="icon" src="/assets/icons/draw-fill.svg" mode="aspectFit" />
          <text class="label">填充</text>
        </view>

        <view class="tool-icon {{tool=='picker'?'active':''}} {{activeLayer=='background'?'disabled':''}}" bindtap="onSelectTool" data-tool="picker">
          <image class="icon" src="/assets/icons/draw-eyedropper.svg" mode="aspectFit" />
          <text class="label">吸色</text>
        </view>
        <view class="tool-divider"></view>

        <view class="tool-icon {{activeLayer=='background'?'disabled':''}}" bindtap="onClear">
          <image class="icon" src="/assets/icons/draw-trash.svg" mode="aspectFit" />
          <text class="label">清空</text>
        </view>

        <view class="tool-icon {{!canUndo || activeLayer=='background'?'disabled':''}}" bindtap="onUndo">
          <image class="icon" src="/assets/icons/draw-undo.svg" mode="aspectFit" />
          <text class="label">撤回</text>
        </view>

        <view class="tool-icon {{!canRedo || activeLayer=='background'?'disabled':''}}" bindtap="onRedo">
          <image class="icon" src="/assets/icons/draw-redo.svg" mode="aspectFit" />
          <text class="label">重做</text>
        </view>
        <view class="tool-divider"></view>

        <view class="tool-icon {{symmetry && tool=='pen' && activeLayer=='canvas'?'active':''}} {{tool!='pen' || activeLayer=='background'?'disabled':''}}" bindtap="onToggleSymmetry">
          <image class="icon" src="/assets/icons/draw-symmetry.svg" mode="aspectFit" />
          <text class="label">对称</text>
        </view>

        <view class="tool-icon {{mirror?'active':''}} {{activeLayer=='canvas' && !hasPixels?'disabled':''}}" bindtap="onToggleMirror">
          <image class="icon" src="/assets/icons/draw-mirror.svg" mode="aspectFit" />
          <text class="label">镜像</text>
        </view>
      </scroll-view>
    </view>

    <view
      class="canvas-area"
      bindtap="onCanvasAreaTap"
      data-tool="{{tool}}"
    >
      <view
        wx:if="{{backgroundImage}}"
        id="backgroundLayer"
        class="background-layer"
        style="position: absolute; left: {{backgroundOffsetX}}px; top: {{backgroundOffsetY}}px; transform: scale({{backgroundScale}}); transform-origin: 0 0; z-index: 1;"
      >
        <image
          class="background-image"
          src="{{backgroundImage}}"
          mode="aspectFit"
          style="width: {{canvasWidth}}px; height: {{canvasHeight}}px; opacity: {{showBackground ? 1 : 0}}; transform: scaleX({{backgroundMirror ? -1 : 1}});"
        />
      </view>

      <view
        id="canvasLayer"
        class="canvas-layer {{activeLayer=='canvas'?'active-canvas':''}} {{activeLayer=='background'?'active-background':''}}"
        style="position: absolute; left: {{canvasOffsetX - boardInset * canvasScale}}px; top: {{canvasOffsetY - boardInset * canvasScale}}px; transform: scale({{canvasScale}}); transform-origin: 0 0; z-index: 2;"
      >
        <view class="canvas-wrapper" style="width: {{boardCanvasWidth}}px; height: {{boardCanvasHeight}}px;">
          <bead-canvas2d
            id="drawCanvas2d"
            canvas-id="drawCanvas"
            width="{{boardCanvasWidth}}"
            height="{{boardCanvasHeight}}"
            auto-init="{{true}}"
            style="background: {{backgroundImage ? 'transparent' : '#FFFFFF'}}; width: {{boardCanvasWidth}}px; height: {{boardCanvasHeight}}px;"
            bind:ready="onCanvasReady"
            bind:error="onCanvasError"
          />
        </view>
      </view>

      <view
        class="gesture-layer gesture-layer-full"
        catchtap="onCanvasAreaTap"
        catchtouchstart="{{gesture.touchstart}}"
        catchtouchmove="{{gesture.touchmove}}"
        catchtouchend="{{gesture.touchend}}"
        catchtouchcancel="{{gesture.touchend}}"
        data-canvas-offset-x="{{canvasOffsetX}}"
        data-canvas-offset-y="{{canvasOffsetY}}"
        data-canvas-scale="{{canvasScale}}"
        data-background-offset-x="{{backgroundOffsetX}}"
        data-background-offset-y="{{backgroundOffsetY}}"
        data-background-scale="{{backgroundScale}}"
        data-board-inset="{{boardInset}}"
        data-area-left="{{canvasAreaLeft}}"
        data-area-top="{{canvasAreaTop}}"
        data-min-scale="{{minCanvasScale}}"
        data-max-scale="{{maxCanvasScale}}"
        data-locked="{{locked}}"
        data-has-background="{{backgroundImage ? true : false}}"
        data-active-layer="{{activeLayer}}"
        data-tool="{{tool}}"
      />
    </view>
  </view>

  <view class="color-card {{colorbarExpanded ? 'expanded' : ''}}" style="height: {{colorbarHeight}}rpx; --colorbar-height: {{colorbarHeight}}rpx;">
    <view
      class="color-handle"
      bindtouchstart="onColorbarTouchStart"
      bindtouchmove="onColorbarTouchMove"
      bindtouchend="onColorbarTouchEnd"
    >
      <view class="handle-bar"></view>
    </view>

    <view
      class="used-colors-section"
      bindtouchstart="onColorbarTouchStart"
      bindtouchmove="onColorbarTouchMove"
      bindtouchend="onColorbarTouchEnd"
    >
      <view class="section-header">
        <text class="section-title">已使用颜色</text>
        <text class="section-count">{{usedColors.length}}种</text>
      </view>
      <scroll-view class="used-colors-scroll" scroll-x>
        <view class="used-colors-list">
          <view
            wx:for="{{usedColors}}"
            wx:key="hex"
            class="used-color-item {{currentColor==item.hex?'active':''}} {{dragTargetColor==item.hex?'drag-target':''}}"
            bindtap="onSelectColor"
            data-color="{{item.hex}}"
          >
            <view class="color-bead" style="background:{{item.hex}};">
              <view class="bead-info">
                <text class="bead-code">{{item.code}}</text>
                <text class="bead-count">x{{item.count}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="section-divider"></view>

    <view class="colors-section">
      <view class="section-header">
        <text class="section-title">{{brand}}</text>
        <text class="section-count">{{colors.length}}色</text>
      </view>

      <view wx:if="{{!colorbarExpanded}}" class="colors-compact-wrapper">
        <view class="current-color-fixed">
          <view class="current-color-bead" style="background:{{currentColor}};">
            <text class="bead-code-large">{{currentCode}}</text>
          </view>
          <text class="current-color-label">当前颜色</text>
        </view>

        <scroll-view class="colors-scroll-horizontal" scroll-x="{{!disableColorScroll}}" enable-flex>
          <view
            class="colors-grid-compact"
            bindtouchmove="onColorDragMove"
            bindtouchend="onColorDragEnd"
          >
            <view
              wx:for="{{colorsWithCode}}"
              wx:key="hex"
              class="color-item-compact {{currentColor==item.hex?'active':''}}"
              bindtap="onSelectColor"
              bindlongpress="onLongPressColor"
              data-color="{{item.hex}}"
            >
              <view class="color-bead-compact" style="background:{{item.hex}};">
                <text class="bead-code-compact">{{item.code}}</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <scroll-view
        wx:else
        class="colors-scroll-expanded"
        scroll-y
        bindscroll="onExpandedColorsScroll"
      >
        <view class="colors-grid-expanded" style="height: {{virtualColorsTotalHeight}}rpx; position: relative;">
          <view class="colors-grid-expanded-inner" style="position: absolute; left: 0; right: 0; top: {{virtualColorsOffsetTop}}rpx;">
            <view
              wx:for="{{virtualColorsWithCode}}"
              wx:key="hex"
              class="color-item-expanded {{currentColor==item.hex?'active':''}}"
              bindtap="onSelectColor"
              bindlongpress="onLongPressColor"
              data-color="{{item.hex}}"
            >
              <view class="color-bead-expanded" style="background:{{item.hex}};">
                <text class="bead-code-expanded">{{item.code}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="safe-area-bottom"></view>
  </view>

  <view
    wx:if="{{showSettings || settingsClosing || colorbarExpanded}}"
    class="panel-mask"
    catchtouchmove="stopPropagation"
    catchtap="onCanvasAreaTap"
  ></view>

  <view
    wx:if="{{isDraggingColor}}"
    class="dragging-color-block"
    style="left: {{dragX}}px; top: {{dragY}}px; background: {{draggingColor}};"
  >
    <text class="drag-code">{{draggingColorCode}}</text>
  </view>

  <view wx:if="{{showMagnifier}}" class="magnifier" style="left: {{magnifierX}}px; top: {{magnifierY}}px;">
    <view class="magnifier-circle">
      <canvas type="2d" id="magnifierCanvas" class="magnifier-canvas"></canvas>
    </view>
    <view class="magnifier-label">{{magnifierColor}}</view>
  </view>

  <view wx:if="{{showColorModal}}" class="modal-overlay" bindtap="onCloseColorModal">
    <view class="modal-container" catchtap="stopPropagation">
      <view class="modal-icon-wrapper">
        <text class="modal-icon">i</text>
        <view class="modal-icon-badge">
          <text class="badge-icon">色</text>
        </view>
      </view>
      <view class="modal-title">颜色详情</view>
      <view class="modal-subtitle">长按颜色可查看详情，拖动颜色到已使用颜色上可替换画布颜色。</view>
      <view class="modal-color-preview" style="background:{{currentColor}};"></view>
      <view class="modal-info-card">
        <view class="info-row">
          <text class="info-label">色号</text>
          <text class="info-value">{{currentCode}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">HEX</text>
          <text class="info-value">{{currentColor}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">已使用</text>
          <text class="info-value">{{colorCount}}颗</text>
        </view>
      </view>
      <view class="modal-actions">
        <view class="modal-btn secondary" bindtap="onCloseColorModal">关闭</view>
        <view class="modal-btn primary" bindtap="onSave">保存</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-overlay">
    <view class="loading-container">
      <view class="loading-spinner"></view>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>

  <view wx:if="{{showColorReplaceModal}}" class="color-replace-modal">
    <view class="modal-mask" bindtap="onCloseColorReplaceModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">替换颜色</text>
        <text class="modal-close" bindtap="onCloseColorReplaceModal">×</text>
      </view>
      <view class="modal-body">
        <view class="replace-target">
          <text class="label">替换为</text>
          <view class="color-bead" style="background:{{replaceTargetColor}};"></view>
          <text class="color-code">{{replaceTargetColor}}</text>
        </view>
        <view class="replace-divider"></view>
        <view class="replace-source-title">
          <text>选择要被替换的已使用颜色</text>
        </view>
        <scroll-view class="used-colors-grid" scroll-y>
          <view
            wx:for="{{usedColors}}"
            wx:key="hex"
            class="replace-color-item"
            bindtap="onReplaceColor"
            data-color="{{item.hex}}"
          >
            <view class="color-bead" style="background:{{item.hex}};"></view>
            <text class="color-code">{{item.code}}</text>
            <text class="color-count">x{{item.count}}</text>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <view wx:if="{{showReplaceModal}}" class="replace-confirm-modal">
    <view class="modal-mask" bindtap="onCancelReplaceColor"></view>
    <view class="modal-content-center">
      <view class="modal-header">
        <text class="modal-title">确认替换颜色？</text>
      </view>
      <view class="modal-body-center">
        <view class="replace-info">
          <text class="info-label">原颜色</text>
          <view class="color-display">
            <view class="color-swatch" style="background:{{replaceSourceColor}};"></view>
            <view class="color-text">
              <text class="color-code-text">{{replaceSourceCode}}</text>
              <text class="color-hex-text">{{replaceSourceColor}}</text>
            </view>
          </view>
        </view>
        <view class="replace-arrow">→</view>
        <view class="replace-info">
          <text class="info-label">新颜色</text>
          <view class="color-display">
            <view class="color-swatch" style="background:{{replaceTargetColor}};"></view>
            <view class="color-text">
              <text class="color-code-text">{{replaceTargetCode}}</text>
              <text class="color-hex-text">{{replaceTargetColor}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="onCancelReplaceColor">
          <text>取消</text>
        </view>
        <view class="modal-btn confirm" bindtap="onConfirmReplaceColor">
          <text>确认替换</text>
        </view>
      </view>
    </view>
  </view>
</view>

<canvas type="2d" id="tempCanvas2d" style="position: fixed; left: -9999px; top: -9999px; width: 1px; height: 1px;"></canvas>
<canvas type="2d" id="compositeCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 1px; height: 1px;"></canvas>
