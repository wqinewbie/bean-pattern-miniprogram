<view class="page">
  <!-- 顶部导航 -->
  <view class="nav">
    <view class="nav-left">
      <view class="nav-icon" bindtap="onBack">
        <text>←</text>
      </view>
    </view>
    <view class="nav-center">
      <text class="nav-title">空白画板</text>
    </view>
    <view class="nav-right">
      <view class="nav-icon save" bindtap="onSave">
        <text>✓</text>
      </view>
    </view>
  </view>

  <!-- 画布区域 -->
  <view class="canvas-section">
    <view class="canvas-area">
      <canvas canvas-id="drawCanvas" class="canvas" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;" bindtouchstart="handleTouchStart" bindtouchmove="handleTouchMove" bindtouchend="handleTouchEnd" />
    </view>
    <!-- 网格大小指示 -->
    <view class="grid-info">
      <text>{{gridSize}}×{{gridSize}}</text>
    </view>
  </view>

  <!-- 工具栏 -->
  <view class="toolbar">
    <!-- 工具组 -->
    <view class="tool-group">
      <view class="tool {{tool==='pen'?'active':''}}" bindtap="onSelectTool" data-tool="pen">
        <text class="icon">✎</text>
      </view>
      <view class="tool {{tool==='eraser'?'active':''}}" bindtap="onSelectTool" data-tool="eraser">
        <text class="icon">⌫</text>
      </view>
      <view class="tool {{tool==='fill'?'active':''}}" bindtap="onSelectTool" data-tool="fill">
        <text class="icon">◧</text>
      </view>
      <view class="tool {{tool==='picker'?'active':''}}" bindtap="onSelectTool" data-tool="picker">
        <text class="icon">⊕</text>
      </view>
    </view>

    <view class="divider-v"></view>

    <!-- 操作组 -->
    <view class="tool-group">
      <view class="tool small" bindtap="onUndo">
        <text class="icon">↩</text>
      </view>
      <view class="tool small" bindtap="onRedo">
        <text class="icon">↪</text>
      </view>
    </view>

    <view class="divider-v"></view>

    <!-- 笔刷大小 -->
    <view class="brush-group">
      <view class="brush {{brushSize===1?'active':''}}" bindtap="onBrushSize" data-size="1"></view>
      <view class="brush {{brushSize===2?'active':''}}" bindtap="onBrushSize" data-size="2"></view>
      <view class="brush {{brushSize===3?'active':''}}" bindtap="onBrushSize" data-size="3"></view>
    </view>

    <view class="divider-v"></view>

    <!-- 开关 -->
    <view class="toggle-group">
      <view class="toggle {{showGrid?'active':''}}" bindtap="onToggleGrid">格</view>
      <view class="toggle {{symmetry?'active':''}}" bindtap="onToggleSymmetry">对称</view>
    </view>
  </view>

  <!-- 颜色栏 -->
  <view class="colorbar">
    <view class="current" bindtap="onOpenColorDetail">
      <view class="color-swatch" style="background:{{currentColor}};"></view>
      <text class="color-code">{{currentCode}}</text>
    </view>
    <scroll-view class="palette" scroll-x>
      <view class="colors">
        <view wx:for="{{colors}}" wx:key="*this" class="color {{currentColor===item?'active':''}}" style="background:{{item}};" bindtap="onSelectColor" data-color="{{item}}"></view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <view class="btn secondary" bindtap="onClear">
      <text>清空</text>
    </view>
    <view class="btn primary" bindtap="onExport">
      <text>导出图纸</text>
    </view>
  </view>

  <!-- 颜色详情弹窗 -->
  <view wx:if="{{showColorModal}}" class="modal-mask" bindtap="onCloseColorModal"></view>
  <view wx:if="{{showColorModal}}" class="modal">
    <view class="modal-header">
      <text>当前颜色</text>
      <view class="modal-close" bindtap="onCloseColorModal">×</view>
    </view>
    <view class="modal-body">
      <view class="modal-color" style="background:{{currentColor}};"></view>
      <view class="modal-info">
        <view class="info-line"><text class="label">色号</text><text class="value">{{currentCode}}</text></view>
        <view class="info-line"><text class="label">HEX</text><text class="value">{{currentColor}}</text></view>
        <view class="info-line"><text class="label">用量</text><text class="value">{{colorCount}}颗</text></view>
      </view>
    </view>
    <view class="modal-footer">
      <view class="modal-btn" bindtap="onCloseColorModal">关闭</view>
      <view class="modal-btn primary" bindtap="onSaveColor">保存</view>
    </view>
  </view>
</view>
