<view class="convert-page">
  <!-- 标题区 -->
  <view class="convert-header" style="padding-top:{{statusBarHeight + 24}}px">
    <view class="header-icon-card">
      <image class="header-icon-img" src="/assets/icons/convert-icon-white-uhd.png" mode="aspectFit"/>
    </view>
    <view class="header-texts">
      <text class="header-title">图片转图纸</text>
      <text class="header-sub">魔法变变变，一键生成像素风</text>
    </view>
  </view>

  <!-- 主体 -->
  <view class="convert-body">
    <view class="upload-card" bindtap="onChooseImage">
      <view class="deco deco-tr"></view>
      <view class="deco deco-bl"></view>

      <view class="upload-icon-wrap">
        <text class="upload-icon">☁</text>
      </view>

      <view class="upload-texts">
        <text class="upload-title">点击上传图片</text>
        <text class="upload-sub">支持相册 / 拍照上传</text>
      </view>
    </view>

    <view class="info-card">
      <text class="info-icon">i</text>
      <text class="info-text">建议上传背景干净、轮廓清晰的图片，转换效果更佳哦！</text>
    </view>
  </view>
  <login-modal id="login-modal" />
</view>
