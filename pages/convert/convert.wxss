/* convert.wxss */
.convert-page {
  min-height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.convert-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  margin-bottom: 64rpx;
}

.header-icon-card {
  width: 80rpx;
  height: 80rpx;
  background: #FF6B6B;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 107, 0.3);
  border-bottom: 8rpx solid #E55A5A;
  transform: rotate(-6deg);
  flex-shrink: 0;
  box-sizing: border-box;
}

.header-icon-img {
  width: 54rpx;
  height: 54rpx;
}

.header-texts {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.header-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #5D4037;
  letter-spacing: 1rpx;
}

.header-sub {
  font-size: 24rpx;
  line-height: 1.4;
  color: #A1887F;
  font-weight: 700;
}

.convert-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 160rpx;
}

.upload-card {
  width: 600rpx;
  height: 600rpx;
  background: #ffffff;
  border-radius: 96rpx;
  border: 8rpx solid #FFE5E5;
  box-shadow: 0 16rpx 60rpx rgba(255, 107, 107, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  transition: transform 0.3s ease, border-color 0.3s ease;
}

.upload-card:active {
  transform: scale(0.95);
  border-color: #FFB7B7;
}

.deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  opacity: 0.5;
}

.deco-tr {
  width: 256rpx;
  height: 256rpx;
  background: #FFF4DC;
  top: -80rpx;
  right: -80rpx;
}

.deco-bl {
  width: 192rpx;
  height: 192rpx;
  background: #E8F5E9;
  bottom: -80rpx;
  left: -80rpx;
}

.upload-icon-wrap {
  width: 192rpx;
  height: 192rpx;
  background: #FFF0F0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 4rpx 16rpx rgba(255, 107, 107, 0.1);
  position: relative;
  z-index: 1;
}

.upload-icon {
  font-size: 88rpx;
  line-height: 1;
  color: #FF6B6B;
}

.upload-texts {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.upload-title {
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #5D4037;
}

.upload-sub {
  font-size: 26rpx;
  line-height: 1.4;
  color: #A1887F;
  font-weight: 500;
}

.info-card {
  width: 600rpx;
  margin-top: 80rpx;
  background: #FFF4DC;
  border: 4rpx solid #FFEBB5;
  border-radius: 32rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  box-sizing: border-box;
}

.info-icon {
  font-size: 36rpx;
  line-height: 1;
  color: #FF9800;
  font-weight: 800;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.info-text {
  font-size: 24rpx;
  line-height: 1.625;
  color: #8C6B4B;
  font-weight: 500;
}
