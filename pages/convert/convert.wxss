/* convert.wxss */
.container {
  min-height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
}

/* 标题区 */
.header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 0 60rpx;
}

.header-icon {
  width: 80rpx; height: 80rpx;
  background: #FF6B6B;
  border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(255,107,107,0.3);
  border-bottom: 4rpx solid #E55A5A;
  transform: rotate(-6deg);
  flex-shrink: 0;
}

.header-texts { display: flex; flex-direction: column; gap: 6rpx; }
.header-title { font-size: 44rpx; font-weight: 700; color: #5D4037; }
.header-sub   { font-size: 24rpx; color: #A1887F; font-weight: 500; }

/* 主体居中 */
.body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 160rpx;
  gap: 40rpx;
}

/* 上传卡片 */
.upload-card {
  width: 560rpx;
  height: 560rpx;
  background: #fff;
  border-radius: 60rpx;
  border: 4rpx solid #FFE5E5;
  box-shadow: 0 16rpx 60rpx rgba(255,107,107,0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  position: relative;
  overflow: hidden;
}

.upload-card:active { transform: scale(0.96); }

.deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  opacity: 0.5;
}

.deco-tr {
  width: 256rpx; height: 256rpx;
  background: #FFF4DC;
  top: -80rpx; right: -80rpx;
}

.deco-bl {
  width: 192rpx; height: 192rpx;
  background: #E8F5E9;
  bottom: -60rpx; left: -60rpx;
}

.upload-icon-wrap {
  width: 192rpx; height: 192rpx;
  background: #FFF0F0;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 4rpx 16rpx rgba(255,107,107,0.1);
  position: relative; z-index: 1;
}

.upload-icon { font-size: 80rpx; color: #FF6B6B; }

.upload-texts {
  display: flex; flex-direction: column;
  align-items: center; gap: 12rpx;
  position: relative; z-index: 1;
}

.upload-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #5D4037;
}

.upload-sub {
  font-size: 26rpx;
  color: #A1887F;
  font-weight: 500;
}

/* 提示卡片 */
.info-card {
  width: 560rpx;
  background: #FFF4DC;
  border: 2rpx solid #FFEBB5;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.info-icon {
  font-size: 32rpx;
  color: #FF9800;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.info-text {
  font-size: 24rpx;
  color: #8C6B4B;
  line-height: 1.6;
}
