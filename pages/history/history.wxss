/* history.wxss */

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFF9ED;
  overflow: hidden;
}

/* ─── 右侧操作按钮（组件 slot） ─── */
.nav-clear {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF6B6B;
  padding: 8rpx 16rpx;
  line-height: 1;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* ─── 提示文字 ─── */
.hint {
  padding: 16rpx 32rpx;
  font-size: 20rpx;
  color: #A1887F;
  background: #FFF9ED;
}

/* ─── 内容区 ─── */
.scroll-body {
  flex: 1;
  overflow-y: auto;
  background: #FFF9ED;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 50vh;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  line-height: 1;
}

.empty-text {
  font-size: 26rpx;
  color: #A1887F;
}

.list {
  padding: 24rpx 32rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(140,107,75,0.06);
}

.item-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: #FFF4DC;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-ph {
  font-size: 48rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #5D4037;
}

.item-time {
  font-size: 20rpx;
  color: #A1887F;
}

.item-btn {
  background: #FF9800;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* ─── 底部导航 ─── */
.bottom-nav {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 0 40rpx;
  background: #fff;
  border-top: 2rpx solid #FFF4DC;
  flex-shrink: 0;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(140,107,75,0.08);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  color: #D0B8A1;
  transition: color 0.15s;
}

.nav-item:active { opacity: 0.7; }

.nav-icon {
  font-size: 40rpx;
  line-height: 1;
}

.nav-label {
  font-size: 20rpx;
  font-weight: 700;
}
