<view class="container">

  <!-- 顶部导航 -->
  <page-nav-bar title="时光机" nav-top="{{navTop}}" bind:back="onBack">
    <view slot="right" class="nav-clear" bindtap="onClear">清空</view>
  </page-nav-bar>

  <text class="hint">只保留近30天的魔法记忆哦</text>

  <scroll-view scroll-y class="scroll-body">
    <view wx:if="{{history.length===0}}" class="empty-state">
      <text class="empty-icon">🕐</text>
      <text class="empty-text">还没有生成记录哦</text>
    </view>

    <view class="list">
      <view wx:for="{{history}}" wx:key="id" class="history-item">
        <view class="item-thumb" bindtap="onItemTap" data-item="{{item}}">
          <view class="thumb-ph">{{item.gridSize || 64}}x{{item.gridSize || 64}}</view>
        </view>
        <view class="item-info" bindtap="onItemTap" data-item="{{item}}">
          <text class="item-title">{{item.name || ('记录#'+item.id)}}</text>
          <text class="item-meta">{{item.brand || ''}} · {{item.colorCount || 0}}色 · {{item.createdAt}}</text>
        </view>
        <view class="item-actions">
          <view class="item-save {{item.boxId ? 'saved' : ''}}" bindtap="onSaveToBox" data-item="{{item}}">
            {{item.boxId ? '已保存' : '保存'}}
          </view>
          <view class="item-del" bindtap="onDelete" data-id="{{item.id}}">🗑</view>
        </view>
      </view>
    </view>
    <view style="height:120rpx"></view>
  </scroll-view>

  <!-- 统一底部 TabBar -->
  <app-tab-bar id="appTabBar" />

</view>
