<view class="edit-profile-page">
  <!-- 渐变导航栏 -->
  <view class="edit-nav-gradient">
    <page-nav-bar title="个人资料" bgColor="transparent" showBack="{{true}}" bind:back="onBack" />
  </view>

  <!-- Content -->
  <scroll-view scroll-y class="edit-scroll">
    <!-- 头像区域 -->
    <view class="avatar-section">
      <view class="avatar-box-edit">
        <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="avatar-placeholder">👤</view>
        </button>
      </view>
      <text class="avatar-tip">点击更换头像</text>
    </view>

    <!-- 信息字段 -->
    <view class="fields-container">
      <view class="field-card">
        <text class="field-label">昵称</text>
        <input class="field-input" type="nickname" maxlength="20" value="{{nickName}}" bindinput="onNickNameInput" placeholder="请输入昵称"/>
      </view>

      <view class="field-card">
        <text class="field-label">手机号</text>
        <view class="phone-field-wrap">
          <text wx:if="{{phone}}" class="phone-value">{{phone}}</text>
          <text wx:else class="phone-placeholder">点击获取手机号</text>
          <button class="phone-hit-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber"></button>
        </view>
      </view>
    </view>

    <!-- 保存按钮 -->
    <view wx:if="{{isEditing}}" class="save-btn" bindtap="onSubmit">
      {{submitting ? '保存中...' : '保存修改'}}
    </view>

    <view style="height: 80rpx;"></view>
  </scroll-view>
  <login-modal id="login-modal" />
</view>
