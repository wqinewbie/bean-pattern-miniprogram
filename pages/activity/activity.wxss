/* 活动详情页样式 */
.activity-page {
  min-height: 100vh;
  background: #FFF9ED;
  padding-bottom: 120rpx;
}

/* 加载中 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #FFD54F;
  border-top-color: #FF9800;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #8C6B4B;
}

/* 错误提示 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FFE0E0;
  color: #FF6B6B;
  font-size: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.error-text {
  font-size: 28rpx;
  color: #8C6B4B;
  margin-bottom: 48rpx;
}

.retry-button {
  background: #FF9800;
  color: white;
  font-size: 28rpx;
  font-weight: 800;
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  border: none;
}

/* 活动内容 */
.activity-content {
}

.cover-image {
  width: 100%;
  height: 400rpx;
  display: block;
}

.activity-header {
  padding: 32rpx;
  background: white;
  border-bottom: 2rpx solid #FFEBB5;
}

.activity-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #5D4037;
  display: block;
  margin-bottom: 16rpx;
}

.quota-info {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #FFF9ED 0%, #FFEBB5 100%);
  border-radius: 16rpx;
  border: 2rpx solid #FFD54F;
}

.quota-text {
  font-size: 24rpx;
  color: #8C6B4B;
  font-weight: 600;
}

.quota-number {
  font-size: 28rpx;
  font-weight: 800;
  color: #FF9800;
}

/* 组件容器 */
.sections-container {
  background: white;
}

.activity-rich-text {
  display: block;
  padding: 32rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #5D4037;
  box-sizing: border-box;
}

/* ========== 组件样式 ========== */

/* 1. 头部Banner组件 */
.hero-banner {
  position: relative;
  padding: 64rpx 48rpx 80rpx;
  text-align: center;
  overflow: hidden;
  background: linear-gradient(135deg, #FFB347 0%, #FF8C42 100%);
}

.peas-icon {
  font-size: 112rpx;
  display: block;
  margin-bottom: 24rpx;
  filter: drop-shadow(4rpx 12rpx 24rpx rgba(0,0,0,0.2));
}

.hero-title {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: #FFFFFF;
  text-shadow: 6rpx 6rpx 0 rgba(201, 90, 15, 0.8);
  display: block;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 28rpx;
  background: rgba(0,0,0,0.2);
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 120rpx;
  color: #FFF8E7;
  font-weight: 500;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24rpx;
  margin-top: 40rpx;
}

.badge {
  background: #FFEED6;
  padding: 12rpx 28rpx;
  border-radius: 80rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #C25D00;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.badge-icon {
  font-size: 28rpx;
}

.badge-text {
  font-size: 24rpx;
}

/* 2. 图片组件 */
.section-image {
  width: 100%;
  display: block;
}

/* 3. 标题组件 */
.section-title {
  font-size: 48rpx;
  font-weight: 700;
  margin: 32rpx 32rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-left: 16rpx solid #FF914D;
  padding-left: 28rpx;
  color: #4B2E14;
}

.title-icon {
  font-size: 48rpx;
}

.title-text {
  font-size: 48rpx;
}

/* 4. 文本组件 */
.section-text {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #5D4037;
}

/* 5. 规则列表组件 */
.rule-list-container {
  padding: 0 32rpx 32rpx;
}

.rule-list {
  background: #FFF8F0;
  border-radius: 32rpx;
  padding: 32rpx 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.03);
}

.rule-item {
  margin-bottom: 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.rule-item:last-child {
  margin-bottom: 0;
}

.rule-num {
  background: #FFB347;
  width: 48rpx;
  height: 48rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-weight: bold;
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.rule-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #4A3724;
  line-height: 1.6;
}

/* 6. 奖品网格组件 */
.prize-grid-container {
  padding: 0 32rpx 32rpx;
}

.prize-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  justify-content: space-between;
}

.prize-item {
  background: white;
  flex: 1;
  min-width: 150rpx;
  max-width: 48%;
  border-radius: 32rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #FFE1B3;
}

.prize-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.prize-name {
  font-weight: 800;
  font-size: 28rpx;
  color: #3A2C1F;
  display: block;
  margin-bottom: 8rpx;
}

.prize-desc {
  font-size: 24rpx;
  color: #a0815c;
}

/* 7. 倒计时组件 */
.countdown-wrap {
  background: #FFEEDB;
  border-radius: 32rpx;
  padding: 32rpx 36rpx;
  text-align: center;
  margin: 32rpx;
}

.countdown-label {
  font-size: 28rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  color: #BA6A2C;
  display: block;
  margin-bottom: 24rpx;
}

.countdown-timer {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  font-weight: 800;
}

.time-block {
  background: rgba(255, 255, 255, 0.85);
  padding: 16rpx 24rpx;
  border-radius: 40rpx;
  min-width: 100rpx;
  box-shadow: inset 0 2rpx 0 white, 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.time-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #D45A1C;
  line-height: 1;
  display: block;
}

.time-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: #794F26;
  display: block;
  margin-top: 4rpx;
}

.countdown-tip {
  font-size: 24rpx;
  color: #8C6B4B;
  margin-top: 24rpx;
  display: block;
}

/* 8. 图标画廊组件 */
.gallery-container {
  padding: 0 32rpx 32rpx;
}

.gallery-preview {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  background: #FDF2E3;
  border-radius: 48rpx;
  padding: 32rpx 40rpx;
}

.bean-dot {
  background: #F7C56E;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 8rpx 16rpx rgba(0,0,0,0.05);
}

.gallery-tip {
  font-size: 24rpx;
  text-align: center;
  margin-top: 24rpx;
  color: #AF8A60;
  display: block;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: white;
  border-top: 2rpx solid #FFEBB5;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.action-button {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 800;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-button.active {
  background: linear-gradient(135deg, #FF9800 0%, #FF6B00 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(255, 152, 0, 0.4);
}

.action-button.active::after {
  border: none;
}

.action-button.disabled {
  background: #E0E0E0;
  color: #9E9E9E;
}

.action-button.disabled::after {
  border: none;
}
