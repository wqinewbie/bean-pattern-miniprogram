@import "../result/result.wxss";

.container--ai {
  background: #050505;
  color: #E0E0E0;
  position: relative;
  overflow: hidden;
}

.container--ai::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(156, 39, 176, 0.15) 0%, transparent 70%);
  filter: blur(100rpx);
  pointer-events: none;
  z-index: 0;
}

.container--ai::after {
  content: '';
  position: absolute;
  bottom: 20%;
  left: -60rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(199, 125, 255, 0.1) 0%, transparent 70%);
  filter: blur(80rpx);
  pointer-events: none;
  z-index: 0;
}

.container--ai .preview-card {
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(40rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 40rpx 100rpx rgba(0, 0, 0, 0.5);
  position: relative;
  z-index: 10;
}

.container--ai .preview-wrap {
  background: #000000;
  border: 2rpx solid rgba(156, 39, 176, 0.3);
  box-shadow: 0 0 80rpx rgba(156, 39, 176, 0.2), 0 0 40rpx rgba(255, 152, 0, 0.1);
}

.container--ai .preview-placeholder {
  background: rgba(5, 5, 5, 0.8);
  backdrop-filter: blur(26rpx);
}

.container--ai .preview-placeholder-dot {
  background: linear-gradient(135deg, #C77DFF, #9C27B0);
  box-shadow: 0 0 20rpx rgba(199, 125, 255, 0.5);
}

.container--ai .preview-placeholder-text {
  color: #C77DFF;
  letter-spacing: 0;
}

.container--ai .tab-bar {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.container--ai .tab {
  color: rgba(224, 224, 224, 0.5);
}

.container--ai .tab--active {
  background: linear-gradient(135deg, #FFD54F 0%, #FF9800 100%);
  color: #3E2723;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.3);
}

.container--ai .vip-ribbon {
  position: absolute;
  top: 0;
  right: 28rpx;
  min-width: 80rpx;
  max-width: 160rpx;
  background: linear-gradient(180deg, #FFD54F 0%, #FF9800 50%, #D68400 100%);
  padding: 18rpx 20rpx 24rpx;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 152, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.container--ai .vip-text {
  color: #3E2723;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.container--ai .vip-style {
  max-width: 120rpx;
  margin-top: 6rpx;
  font-size: 18rpx;
  letter-spacing: 0;
}

.container--ai .action-stack {
  gap: 16rpx;
  margin-top: 24rpx;
}

.container--ai .action-btn {
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  color: #FFD54F;
  border: 2rpx solid rgba(255, 213, 79, 0.5);
  border-bottom: 2rpx solid rgba(255, 213, 79, 0.5);
  box-shadow: none;
  font-size: 28rpx;
  font-weight: 700;
}

.container--ai .action-btn:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.98);
}

.container--ai .action-btn--disabled {
  opacity: 0.5;
}

.container--ai .stats-card {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3);
  position: relative;
  z-index: 10;
}

.container--ai .stats-header {
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.08);
}

.container--ai .stats-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #FFD54F 0%, #FFB74D 48%, #FF9800 100%);
  box-shadow: 0 0 14rpx rgba(255, 183, 77, 0.45);
}

.container--ai .stats-title {
  color: #E0E0E0;
  font-weight: 300;
  letter-spacing: 0;
}

.container--ai .stats-count {
  color: rgba(255, 255, 255, 0.4);
  background: transparent;
  border: 0;
}

.container--ai .stat-item {
  background: linear-gradient(135deg, rgba(255, 213, 79, 0.055) 0%, rgba(255, 255, 255, 0.018) 100%);
  padding: 22rpx 24rpx;
  border: 2rpx solid rgba(255, 213, 79, 0.1);
  border-radius: 20rpx;
}

.container--ai .stat-idx {
  color: rgba(255, 255, 255, 0.4);
  min-width: 40rpx;
}

.container--ai .stat-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(5, 5, 5, 0.9), 0 0 18rpx rgba(0, 0, 0, 0.65);
  border: 2rpx solid rgba(255, 213, 79, 0.35);
}

.container--ai .stat-id {
  color: #E0E0E0;
  font-weight: 500;
}

.container--ai .stat-count {
  color: #FFD54F;
}

.container--ai .bottom-actions {
  background: linear-gradient(180deg, transparent 0%, rgba(5, 5, 5, 0.8) 50%, #050505 100%);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.5);
}

.container--ai .bottom-btn {
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.container--ai .bottom-btn--album {
  background: rgba(255, 255, 255, 0.05);
  color: #E0E0E0;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: none;
}

.container--ai .bottom-btn--box {
  background: linear-gradient(90deg, #FFD54F 0%, #FFB74D 50%, #FF9800 100%);
  color: #3E2723;
  border: 0;
  box-shadow: 0 20rpx 60rpx rgba(255, 152, 0, 0.25);
}

.container--ai .btn-spinner {
  border-color: rgba(224, 224, 224, 0.3);
  border-top-color: #E0E0E0;
}

.container--ai .btn-loading-text {
  color: #E0E0E0;
}

.container--ai .name-mask {
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(20rpx);
}

.container--ai .name-modal {
  background: linear-gradient(135deg, rgba(20, 20, 20, 0.95) 0%, rgba(10, 10, 10, 0.98) 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 40rpx 120rpx rgba(0, 0, 0, 0.8);
}

.container--ai .name-title {
  color: #FFD54F;
}

.container--ai .name-input {
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  color: #E0E0E0;
}

.container--ai .name-hint {
  color: rgba(224, 224, 224, 0.6);
}

.container--ai .name-btn--ghost {
  background: rgba(255, 255, 255, 0.05);
  color: rgba(224, 224, 224, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.container--ai .name-btn--main {
  background: linear-gradient(135deg, #FFD54F 0%, #FF9800 100%);
  color: #3E2723;
  box-shadow: 0 8rpx 24rpx rgba(255, 152, 0, 0.4);
}

.container--ai .result-initial-overlay {
  background: rgba(5, 5, 5, 0.95);
  backdrop-filter: blur(20rpx);
}

.container--ai .result-initial-card {
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.container--ai .result-initial-spinner {
  border-color: rgba(255, 183, 77, 0.2);
  border-top-color: #FFD54F;
}

.container--ai .result-initial-title {
  color: #FFD54F;
}

.container--ai .result-initial-sub,
.container--ai .ph-text {
  color: rgba(224, 224, 224, 0.6);
}
