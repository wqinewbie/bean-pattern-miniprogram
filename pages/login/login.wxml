<view class="container">
  <view class="card">
    <text class="page-title">完善信息并绑定手机号</text>
    <text class="page-sub">优先推荐微信一键绑定，失败可用短信验证码</text>

    <view class="avatar-wrap">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <text class="avatar-icon">👤</text>
          <text class="avatar-hint">点击选择头像</text>
        </view>
      </button>
      <text class="avatar-tip">可同步微信头像</text>
    </view>

    <view class="input-wrap">
      <text class="input-label">昵称</text>
      <input class="nick-input" type="nickname" placeholder="输入昵称，或一键使用微信名" value="{{nickName}}" bindinput="onNickNameInput" maxlength="20" />
    </view>

    <button class="btn-confirm" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" style="margin-bottom:12px;background:#10b981;color:#fff;">
      {{ wxPhoneBound ? '✅ 已一键绑定手机号' : '📱 微信一键绑定手机号' }}
    </button>

    <view class="input-wrap">
      <text class="input-label">手机号（手动兜底）</text>
      <input class="nick-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="input-wrap" wx:if="{{!wxPhoneBound}}">
      <text class="input-label">短信验证码</text>
      <view class="code-row">
        <input class="nick-input code-input" type="number" maxlength="6" placeholder="请输入6位验证码" value="{{smsCode}}" bindinput="onSmsCodeInput" />
        <button class="code-btn" bindtap="onSendSmsCode" disabled="{{sendingCode || codeCountdown>0}}">
          {{ codeCountdown>0 ? (codeCountdown + 's') : '发送验证码' }}
        </button>
      </view>
    </view>

    <button class="btn-confirm" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '保存中...' : '确认绑定并进入'}}
    </button>
  </view>
</view>
