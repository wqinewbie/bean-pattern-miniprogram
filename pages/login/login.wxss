/* 登录页样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(160deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.card {
  width: 100%;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  backdrop-filter: blur(10px);
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.page-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.45);
  margin-top: -24rpx;
}

/* 头像区域 */
.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  background: rgba(255,255,255,0.1);
  border: 3rpx solid rgba(255,255,255,0.2);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.avatar-icon { font-size: 60rpx; }

.avatar-hint {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

.avatar-tip {
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
}

/* 昵称输入 */
.input-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.input-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
}

.nick-input {
  width: 100%;
  height: 88rpx;
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #ffffff;
  box-sizing: border-box;
}

/* 确认按钮 */
.btn-confirm {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #007AFF, #5AC8FA);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 8rpx;
}

.btn-confirm[disabled] { opacity: 0.5; }

/* 跳过 */
.skip {
  font-size: 26rpx;
  color: rgba(255,255,255,0.35);
  padding: 10rpx 40rpx;
  margin-top: -16rpx;
}
