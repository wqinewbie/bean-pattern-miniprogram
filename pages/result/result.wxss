/* result.wxss - 图纸预览页样式 */

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFF9ED;
}

/* ─── 滚动区 ─── */
.scroll-body {
  flex: 1;
  overflow: hidden;
}

/* ─── 图纸大图预览卡片 ─── */
.preview-card {
  margin: 28rpx 32rpx 0;
  background: #fff;
  border-radius: 48rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(140,107,75,0.06);
  border: 4rpx solid #FFF4DC;
}

.preview-wrap {
  width: 100%;
  aspect-ratio: 1;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 24rpx;
  z-index: 1;
}

.preview-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: #F7F3EA;
  z-index: 1;
}

.preview-placeholder-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #FFB74D;
  animation: pulse 1.1s ease-in-out infinite;
}

.preview-placeholder-text {
  font-size: 24rpx;
  color: #8C6B4B;
  font-weight: 600;
}

@keyframes pulse {
  0%, 100% { transform: scale(0.85); opacity: 0.7; }
  50% { transform: scale(1.15); opacity: 1; }
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
}

.preview-img--pattern {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 32rpx;
}

.preview-img--mirror {
  transform: scaleX(-1);
}

.result-canvas {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none;
  opacity: 1;
  transition: opacity 0.2s ease-out;
}

.result-canvas.canvas-rendering {
  opacity: 0;
}

.image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.ph-icon { font-size: 80rpx; }
.ph-text  { font-size: 28rpx; color: #aaa; }

/* 加载遮罩 */
.preview-loading {
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border-radius: 32rpx;
  z-index: 5;
}
.preview-spinner {
  width: 64rpx; height: 64rpx;
  border: 8rpx solid #FFF4DC;
  border-top-color: #FF9800;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.preview-loading-text { font-size: 26rpx; font-weight: 700; color: #8C6B4B; }

/* 结果页首屏加载遮罩 */
.result-initial-overlay {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: #FFF9ED;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-initial-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 52rpx 64rpx;
  background: #fff;
  border-radius: 40rpx;
  border: 4rpx solid #FFF4DC;
  box-shadow: 0 16rpx 48rpx rgba(140,107,75,0.08);
}

.result-initial-spinner {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 6rpx solid #FFF4DC;
  border-top-color: #FF9800;
  animation: spin 0.8s linear infinite;
}

.result-initial-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #5D4037;
}

.result-initial-sub {
  font-size: 24rpx;
  font-weight: 700;
  color: #A1887F;
}

/* ─── 标签切换 ─── */
.tab-bar {
  position: relative;
  z-index: 20;
  display: flex;
  background: #FFF9ED;
  border-radius: 24rpx;
  padding: 8rpx;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #A1887F;
  border-radius: 18rpx;
  transition: all 0.2s;
}

.tab--active {
  background: #fff;
  color: #5D4037;
  box-shadow: 0 4rpx 12rpx rgba(140,107,75,0.1);
}

/* ─── Figma Preview 按钮样式（硬对齐） ─── */
.action-stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
  margin-bottom: 4rpx;
}

.action-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.action-btn--edit {
  background: #B6E0FD;
  color: #1E3A5F;
  box-shadow: 0 8rpx 24rpx rgba(182, 224, 253, 0.20);
  border-bottom: 6rpx solid #8AC6FD;
}

.action-btn--immersive {
  background: #FFD271;
  color: #6D4C41;
  box-shadow: 0 8rpx 24rpx rgba(255, 210, 113, 0.20);
  border-bottom: 6rpx solid #FFC048;
}

.action-btn--disabled {
  background: #E0E0E0;
  color: #9E9E9E;
  border-bottom-color: #BDBDBD;
  box-shadow: none;
}

.action-btn:active {
  transform: translateY(2rpx);
  border-bottom-width: 2rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #FFF9ED 70%, rgba(255,249,237,0) 100%);
}

.bottom-actions-inner {
  display: flex;
  gap: 12rpx;
}

.bottom-btn-slot {
  min-width: 0;
  overflow: hidden;
  border-radius: 999rpx;
  transition: flex-basis 520ms cubic-bezier(0.22, 1, 0.36, 1), max-width 520ms cubic-bezier(0.22, 1, 0.36, 1), opacity 420ms ease, transform 420ms ease, margin 520ms cubic-bezier(0.22, 1, 0.36, 1);
}

.bottom-btn-slot--album {
  flex: 1 1 50%;
}

.bottom-btn-slot--album-expanded {
  flex: 1 1 100%;
}

.bottom-btn-slot--box {
  flex: 1 1 50%;
  opacity: 1;
  transform: scale(1);
}

.bottom-btn-slot--box-hidden {
  flex: 0 0 0;
  max-width: 0;
  opacity: 0;
  transform: scale(0.92);
  margin-left: -12rpx;
  pointer-events: none;
}

.bottom-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.bottom-btn--album {
  background: #A1CC1A;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(161, 204, 26, 0.20);
  border: 2rpx solid #8EB81A;
  border-bottom: 6rpx solid #7BA40A;
}

.bottom-btn--box {
  background: #FFC048;
  color: #3E2723;
  box-shadow: 0 12rpx 40rpx rgba(255,152,0,0.30);
  border: 0;
  border-bottom: 8rpx solid #FF9800;
}


.bottom-btn:active {
  transform: translateY(2rpx);
  border-bottom-width: 2rpx;
}

/* ─── 色号清单 ─── */
.stats-card {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 48rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(140,107,75,0.06);
  border: 4rpx solid #FFF4DC;
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.stats-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stats-bar {
  width: 6rpx;
  height: 36rpx;
  background: #FF9800;
  border-radius: 3rpx;
}

.stats-title { font-size: 30rpx; font-weight: 800; color: #5D4037; }
.stats-count {
  font-size: 22rpx;
  font-weight: 700;
  color: #FF9800;
  background: #FFF4DC;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx 40rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed #FFF4DC;
}

.stat-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stat-idx  { font-size: 20rpx; color: #D0B8A1; width: 28rpx; font-weight: 700; }

.stat-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  flex-shrink: 0;
}

.stat-info { display: flex; flex-direction: column; gap: 2rpx; }
.stat-id   { font-size: 26rpx; font-weight: 800; color: #5D4037; }

.stat-count {
  font-size: 24rpx;
  font-weight: 800;
  color: #8C6B4B;
  background: #FFF9ED;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  border: 2rpx solid #FFF4DC;
}

/* ─── 图纸命名弹框 ─── */
.name-mask {
  position: fixed;
  inset: 0;
  background: rgba(93,64,55,0.42);
  z-index: 70;
}

.name-modal {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: -520rpx;
  background: #fff;
  border-radius: 36rpx;
  border: 3rpx solid #FFEBC8;
  box-shadow: 0 20rpx 60rpx rgba(140,107,75,0.22);
  padding: 28rpx;
  z-index: 71;
  transition: bottom 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.name-modal--show {
  bottom: calc(34rpx + env(safe-area-inset-bottom));
}

.name-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 20rpx;
}

.name-input {
  height: 84rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFE3B2;
  background: #FFF9ED;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #5D4037;
}

.name-placeholder {
  color: #C9A98A;
}

.name-hint {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #A1887F;
}

.name-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.name-btn {
  flex: 1;
  height: 82rpx;
  border-radius: 41rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.name-btn--ghost {
  background: #FFF4DC;
  color: #8C6B4B;
}

.name-btn--main {
  background: linear-gradient(135deg, #FFD54F, #FF9800);
  color: #3E2723;
  border-bottom: 6rpx solid #F57C00;
}

/* ─── 结果页内置生成遮罩 ─── */
.generating-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFF9ED;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1200;
}

.generating-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
}

.generating-anim-wrap {
  width: 256rpx;
  height: 256rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
}

.generating-ring {
  position: absolute;
  border-radius: 50%;
  background: #FFE082;
}

.generating-ring1 {
  width: 256rpx;
  height: 256rpx;
  opacity: 0.2;
  animation: ping 1.5s cubic-bezier(0,0,0.2,1) infinite;
}

.generating-ring2 {
  width: 192rpx;
  height: 192rpx;
  opacity: 0.3;
  animation: pulse 2s cubic-bezier(0.4,0,0.6,1) infinite;
}

.generating-center-box {
  width: 128rpx;
  height: 128rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.generating-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 8rpx solid #FFF4DC;
  border-top-color: #FFD54F;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.generating-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #5D4037;
  margin-bottom: 16rpx;
  text-align: center;
}

.generating-sub {
  display: block;
  font-size: 26rpx;
  color: #A1887F;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 60rpx;
}

.generating-btn-row {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.generating-btn-outline {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  border: 2rpx solid #E0E0E0;
  background: #fff;
  color: #5D4037;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.generating-btn-primary {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  background: #FFD54F;
  color: #3E2723;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255,213,79,0.4);
}

.generating-btn-outline:active,
.generating-btn-primary:active {
  opacity: 0.85;
}

@keyframes ping {
  0% { transform: scale(0.8); opacity: 0.3; }
  80%, 100% { transform: scale(1.2); opacity: 0; }
}



/* ─── 按钮加载状态 ─── */
.bottom-btn--loading {
  opacity: 0.8;
  pointer-events: none;
}

.btn-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.btn-loading-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFFFF;
}
