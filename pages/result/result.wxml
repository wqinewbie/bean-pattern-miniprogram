<view class="container">

  <!-- 顶部导航 -->
  <page-nav-bar title="图纸预览" subtitle="{{brandName}} · {{currentSize}}×{{currentSize}}" nav-top="{{navTop}}" bind:back="onBack"/>

  <scroll-view scroll-y class="scroll-body">

    <!-- 图纸大图预览区 -->
    <view class="preview-card">
      <view class="preview-wrap">
        <image wx:if="{{currentPreviewUrl}}" class="preview-img" src="{{currentPreviewUrl}}" mode="aspectFit" bindtap="onPreviewImage"/>
        <view wx:else class="image-placeholder">
          <text class="ph-icon">🖼️</text>
          <text class="ph-text">暂无图片</text>
        </view>
        <!-- 生成中遮罩 -->
        <view wx:if="{{saving}}" class="preview-loading">
          <view class="preview-spinner"></view>
          <text class="preview-loading-text">处理中...</text>
        </view>
      </view>

      <!-- 标签切换 -->
      <view class="tab-bar">
        <view class="tab {{activeTab==='original'?'tab--active':''}}" bindtap="onTabChange" data-tab="original">原图</view>
        <view class="tab {{activeTab==='result'?'tab--active':''}}" bindtap="onTabChange" data-tab="result">效果图</view>
        <view class="tab {{activeTab==='pattern'?'tab--active':''}}" bindtap="onTabChange" data-tab="pattern">色号图</view>
      </view>

      <!-- 保存到相册 -->
      <view class="save-img-btn" bindtap="onSaveImage">保存当前图片</view>

      <!-- 沉浸拼豆模式 -->
      <view class="focus-mode-btn" bindtap="onEnterFocusMode">进入沉浸拼豆模式</view>
    </view>

    <!-- 色号清单 -->
    <view wx:if="{{colorStats.length>0}}" class="stats-card">
      <view class="stats-header">
        <view class="stats-title-row">
          <view class="stats-bar"></view>
          <text class="stats-title">所需色号清单</text>
        </view>
        <text class="stats-count">共 {{colorStats.length}} 色 / {{totalBeads}} 颗</text>
      </view>
      <view class="stats-grid">
        <view wx:for="{{colorStats}}" wx:key="id" class="stat-item" bindtap="onColorTap"
          data-name="{{item.name}}" data-id="{{item.id}}" data-count="{{item.count}}">
          <view class="stat-left">
            <text class="stat-idx">{{index+1}}.</text>
            <view class="stat-dot" style="background:rgb({{item.r}},{{item.g}},{{item.b}})"></view>
            <view class="stat-info">
              <text class="stat-id">{{item.id}}</text>
              <text class="stat-name">{{item.name}}</text>
            </view>
          </view>
          <text class="stat-count">x{{item.count}}</text>
        </view>
      </view>
    </view>

    <view style="height:200rpx"></view>
  </scroll-view>

  <!-- 命名弹框 -->
  <view wx:if="{{showNameModal}}" class="name-mask" bindtap="onCloseNameModal"></view>
  <view class="name-modal {{showNameModal?'name-modal--show':''}}" catchtap="noop">
    <view class="name-title">给图纸起个名字</view>
    <input class="name-input" type="text" maxlength="20" value="{{patternNameInput}}" bindinput="onNameInput" placeholder="例如：柴犬像素摆件" placeholder-class="name-placeholder"/>
    <view class="name-hint">不填则自动命名为 魔法图纸#任务号</view>
    <view class="name-actions">
      <view class="name-btn name-btn--ghost" bindtap="onCloseNameModal">取消</view>
      <view class="name-btn name-btn--main" bindtap="onConfirmSavePattern">保存</view>
    </view>
  </view>

</view>
