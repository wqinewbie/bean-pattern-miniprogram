/* generate.wxss - Figma Crop 风格 */
.generate-page {
  min-height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.reselect-bar {
  padding: 18rpx 40rpx 8rpx;
  background: #FFF9ED;
  flex-shrink: 0;
}

.btn-reselect-top {
  width: 100%;
  height: 84rpx;
  background: #ffffff;
  border: 4rpx solid #FFEBB5;
  border-radius: 32rpx;
  color: #FF9800;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(140, 107, 75, 0.04);
  box-sizing: border-box;
}

.btn-reselect-top:active {
  transform: scale(0.98);
}

.reselect-icon {
  width: 36rpx;
  height: 36rpx;
}

.preview-zone {
  flex: 1;
  min-height: 500rpx;
  padding: 4rpx 40rpx 12rpx;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.zoom-hint {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 20rpx;
  margin: 0 0 8rpx;
  border-radius: 999rpx;
  border: 2rpx solid #FFEBB5;
  background: rgba(255, 255, 255, 0.5);
  color: #A1887F;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
  box-sizing: border-box;
}

.zoom-hint-icon {
  color: #FF9800;
  font-size: 28rpx;
}

.preview-box {
  width: 640rpx;
  height: 640rpx;
  position: relative;
  background: #ffffff;
  border: 8rpx solid #FFF4DC;
  border-radius: 64rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 60rpx rgba(140, 107, 75, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.preview-interact {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.preview-image-layer {
  position: absolute;
  transform-origin: center center;
  will-change: transform;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: #FFF9ED;
}

.ph-icon {
  font-size: 80rpx;
}

.ph-text {
  font-size: 28rpx;
  color: #A1887F;
  font-weight: 700;
}

.grid-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}

.grid-line {
  position: absolute;
  background: rgba(255, 152, 0, 0.12);
}

.grid-line.h {
  left: 0;
  right: 0;
  height: 2rpx;
}

.grid-line.v {
  top: 0;
  bottom: 0;
  width: 2rpx;
}

.settings-panel {
  background: #ffffff;
  border-radius: 80rpx 80rpx 0 0;
  padding: 48rpx 48rpx 192rpx;
  flex-shrink: 0;
  box-shadow: 0 -20rpx 80rpx rgba(140, 107, 75, 0.08);
  border-top: 6rpx solid #FFF4DC;
  box-sizing: border-box;
  z-index: 10;
}

.setting-section {
  margin-bottom: 40rpx;
}

.setting-label-row,
.mini-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.label-bar {
  width: 12rpx;
  height: 32rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.label-bar--yellow { background: #FFD54F; }
.label-bar--red { background: #FF6B6B; }

.setting-label {
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #5D4037;
}

.size-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
  width: 100%;
}

.size-row > picker,
.size-row > view {
  flex: 1;
  min-width: 0;
}

.size-picker-wrap {
  display: block;
}

.size-picker-wrap .size-half-box {
  width: 100%;
}

.size-half-box {
  width: 100%;
  min-width: 0;
  height: 88rpx;
  border-radius: 24rpx;
  border: 4rpx solid #F5E6D3;
  background: #ffffff;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.size-half-box--active {
  border-color: #FFD54F;
  background: #FFF4DC;
}

.size-custom-btn {
  justify-content: center;
  color: #A1887F;
  font-size: 30rpx;
  font-weight: 800;
}

.size-custom-btn.size-half-box--active {
  color: #5D4037;
}

.picker-val {
  font-size: 28rpx;
  color: #5D4037;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  font-size: 28rpx;
  color: #A1887F;
  flex-shrink: 0;
}

.custom-size-input {
  width: 100%;
  height: 100%;
  background: transparent;
  border: none;
  color: #5D4037;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
}

.color-style-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.color-style-card {
  min-width: 0;
  height: 120rpx;
  border-radius: 38rpx;
  border: 4rpx solid #F5E6D3;
  background: #ffffff;
  color: #A1887F;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
}

.color-style-card--active {
  background: #FFE5E5;
  border-color: #FF6B6B;
  color: #E55A5A;
}

.color-style-title {
  max-width: 100%;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.color-style-sub {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
  opacity: 0.8;
}

.setting-row-3col {
  display: flex;
  gap: 24rpx;
  margin-bottom: 36rpx;
}

.setting-col {
  flex: 1.2;
  min-width: 0;
}

.setting-col--small {
  flex: 0.9;
}

.mini-label-row {
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.mini-label-bar {
  width: 12rpx;
  height: 24rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.mini-label-bar--green { background: #4CAF50; }
.mini-label-bar--purple { background: #9C27B0; }
.mini-label-bar--blue { background: #0288D1; }

.mini-label {
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #5D4037;
}

.picker-row {
  height: 88rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 4rpx solid #F5E6D3;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.threshold-card {
  padding: 24rpx 24rpx 18rpx;
  border-radius: 32rpx;
  background: #FFF4DC;
  border: 2rpx solid #FFEBB5;
  box-sizing: border-box;
}

.threshold-card--inline {
  margin-top: 0;
}

.setting-label-row .threshold-value {
  margin-left: auto;
}

.threshold-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.threshold-title {
  font-size: 26rpx;
  color: #5D4037;
  font-weight: 800;
}

.threshold-value {
  font-size: 28rpx;
  color: #FF9800;
  font-weight: 900;
}

.threshold-hint {
  display: block;
  font-size: 22rpx;
  color: #A1887F;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.threshold-slider {
  margin: 0;
}

.threshold-scale {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-top: -4rpx;
}

.threshold-scale text {
  font-size: 20rpx;
  line-height: 1;
  color: #C48724;
  font-weight: 800;
}

.mirror-btn {
  height: 88rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 4rpx solid #F5E6D3;
  color: #A1887F;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.mirror-btn--on {
  background: #E3F2FD;
  border-color: #0288D1;
  color: #0288D1;
}

.generate-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding: 18rpx 48rpx calc(8rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -12rpx 36rpx rgba(140, 107, 75, 0.08);
  box-sizing: border-box;
}

.btn-generate {
  width: 100%;
  height: 104rpx;
  background: linear-gradient(90deg, #FFD54F 0%, #FF9800 100%);
  border: 8rpx solid #FFEBB5;
  border-radius: 48rpx;
  color: #5D4037;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(255, 152, 0, 0.3);
  box-sizing: border-box;
}

.btn-generate:active {
  transform: scale(0.95);
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(93, 64, 55, 0.4);
  z-index: 50;
}

.color-sheet {
  position: fixed;
  bottom: -100%;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 80rpx 80rpx 0 0;
  padding: 32rpx 64rpx calc(64rpx + env(safe-area-inset-bottom));
  z-index: 51;
  transition: bottom 0.3s ease;
  box-shadow: 0 -40rpx 80rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

.color-sheet--show {
  bottom: 0;
}

.sheet-handle {
  width: 96rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #F5E6D3;
  margin: 0 auto 48rpx;
}

.sheet-title {
  text-align: center;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 48rpx;
}

.sheet-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.sheet-item {
  width: 100%;
  min-height: 96rpx;
  border-radius: 32rpx;
  border: 4rpx solid #F5E6D3;
  background: #ffffff;
  color: #A1887F;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.sheet-item--active {
  background: #FFF4DC;
  border-color: #FFD54F;
  color: #5D4037;
}

.sheet-btn-cancel {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: #F5E6D3;
  color: #A1887F;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.offscreen-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
}

.loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-box {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #FFF4DC;
  border-top-color: #FF9800;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #A1887F;
  font-weight: 600;
}
