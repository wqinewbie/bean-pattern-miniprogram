/* generate.wxss - 暖色调风格 */

.container {
  min-height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
}

/* ─── 重选按钮 ─── */
.reselect-bar {
  padding: 16rpx 32rpx 16rpx;
  background: #FFF9ED;
}

.btn-reselect-top {
  width: 100%;
  height: 88rpx;
  background: #fff;
  border: 2rpx solid #FFE0B2;
  border-radius: 24rpx;
  color: #FF9800;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-reselect-top:active { opacity: 0.7; }

/* ─── 图片预览区 ─── */
.preview-zone {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  min-height: 420rpx;
  background: #FFF9ED;
}

.preview-box {
  width: 100%;
  max-width: 560rpx;
  aspect-ratio: 1;
  position: relative;
  background: #fff;
  border: 4rpx solid #FFE0B2;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(140,107,75,0.12);
}

.preview-img { width: 100%; height: 100%; }

.preview-placeholder {
  width: 100%; height: 100%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 20rpx;
  background: #FFF9ED;
}

.ph-icon { font-size: 80rpx; }
.ph-text  { font-size: 28rpx; color: #A1887F; }

.grid-overlay {
  position: absolute; inset: 0;
  pointer-events: none;
}

.grid-line { position: absolute; background: rgba(255,152,0,0.15); }
.grid-line.h { left: 0; right: 0; height: 2rpx; }
.grid-line.v { top: 0; bottom: 0; width: 2rpx; }

/* ─── 设置面板 ─── */
.settings-panel {
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 24rpx 40rpx 60rpx;
  flex-shrink: 0;
  box-shadow: 0 -10rpx 40rpx rgba(140,107,75,0.08);
  border-top: 2rpx solid #FFE0B2;
}

.panel-handle {
  width: 80rpx; height: 8rpx;
  background: #FFE0B2;
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}

.setting-section { margin-bottom: 32rpx; }

.setting-label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #A1887F;
  margin-bottom: 16rpx;
}

/* ─── 三列设置行（色号+算法+镜像）─── */
.setting-row-3col {
  display: grid;
  grid-template-columns: 1fr 1fr 0.7fr;
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.setting-col { display: flex; flex-direction: column; }

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  background: #FFF9ED;
  border-radius: 20rpx;
  padding: 0 20rpx;
  border: 2rpx solid #FFE0B2;
}

.picker-val   { font-size: 24rpx; color: #5D4037; }
.picker-arrow { font-size: 24rpx; color: #A1887F; }

/* 镜像开关 */
.mirror-btn {
  height: 80rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFE0B2;
  background: #FFF9ED;
  color: #A1887F;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mirror-btn--on {
  border-color: #FF9800;
  background: rgba(255,152,0,0.1);
  color: #FF9800;
}

/* ─── 生成按钮 ─── */
.btn-generate {
  width: 100%;
  height: 104rpx;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  border-radius: 52rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(255,152,0,0.35);
}

.btn-generate:active { transform: scale(0.97); }

/* ─── 离屏画布 ─── */
.offscreen-canvas { position: fixed; left: -9999px; top: 0; }

/* ─── 辅助提示行 ─── */
.hints-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 32rpx 0;
  background: #FFF9ED;
}

.hint-gray  { font-size: 22rpx; color: #A1887F; font-weight: 700; }
.hint-orange { font-size: 22rpx; color: #FF9800; font-weight: 700; }
.hint-blue   { font-size: 22rpx; color: #0288D1; font-weight: 700; }
.hints-right { display: flex; gap: 24rpx; }

.nav-dot {
  width: 24rpx; height: 24rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid #5D4037;
  outline: 2rpx solid #fff;
}

/* ─── 色号底部弹窗 ─── */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  z-index: 50;
}

.color-sheet {
  position: fixed;
  bottom: -100%;
  left: 0; right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 48rpx 60rpx;
  z-index: 51;
  transition: bottom 0.3s ease;
}

.color-sheet--show { bottom: 0; }

.sheet-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-bottom: 48rpx;
}

.sheet-item {
  width: 100%;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #A1887F;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #FFF4DC;
}

.sheet-item--active { color: #5D4037; font-size: 36rpx; }
.sheet-item:active { background: #FFF9ED; }

.sheet-btns {
  display: flex;
  gap: 24rpx;
}

.sheet-btn-cancel {
  flex: 1; height: 88rpx;
  background: #FFF4DC;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; color: #A1887F;
}

.sheet-btn-confirm {
  flex: 1; height: 88rpx;
  background: #FF9800;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; color: #fff;
}

/* ─── 加载蒙层 ─── */
.loading-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
  z-index: 999;
}

.loading-box {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 80rpx;
  display: flex; flex-direction: column;
  align-items: center; gap: 28rpx;
}

.loading-spinner {
  width: 64rpx; height: 64rpx;
  border: 6rpx solid #FFF4DC;
  border-top-color: #FF9800;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text { font-size: 28rpx; color: #A1887F; font-weight: 500; }

/* ── 尺寸picker行 ── */
.size-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  width: 100%;
}

.size-picker {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFE0B2;
  background: #FFF9ED;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.size-picker .picker-val {
  font-size: 26rpx;
  color: #5D4037;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.size-picker--active {
  border-color: #FF9800;
  background: rgba(255,152,0,0.1);
}

.size-custom-btn {
  flex: 1;
  flex-shrink: 0;
  height: 80rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFE0B2;
  background: #FFF9ED;
  color: #A1887F;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.size-custom-btn.size-btn--active {
  border-color: #FF9800;
  background: rgba(255,152,0,0.1);
  color: #FF9800;
}

/* size-half-box: 两个框各半 */
.size-half-box {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFE0B2;
  background: #FFF9ED;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.size-confirm-btn {
  justify-content: center;
  color: #A1887F;
  font-size: 26rpx;
  font-weight: 700;
  cursor: pointer;
}

.size-confirm-btn.size-picker--active {
  border-color: #FF9800;
  background: rgba(255,152,0,0.1);
  color: #FF9800;
}

.size-half-box .custom-size-input {
  flex: 1;
  width: 100%;
  height: 100%;
  background: transparent;
  border: none;
  font-size: 26rpx;
  font-weight: 700;
  color: #FF9800;
  text-align: center;
}

/* ─── 尺寸按钮（4列）─── */
.size-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.size-btn {
  height: 80rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFE0B2;
  background: #FFF9ED;
  color: #A1887F;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.size-btn:active { opacity: 0.7; }
.size-btn--active { border-color: #FF9800; background: rgba(255,152,0,0.1); color: #FF9800; }

.custom-size-input {
  width: 80rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #FF9800;
  background: transparent;
  border: none;
}
