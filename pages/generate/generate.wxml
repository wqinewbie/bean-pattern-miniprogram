<view class="generate-page">
  <page-nav-bar title="魔法参数设置" showBack="{{true}}" bind:back="onBack" />

  <scroll-view scroll-y class="generate-scroll" scroll-top="{{scrollTop}}" scroll-with-animation="{{true}}">
  <view class="generate-scroll-content">
  <!-- 重新选择图片 -->
  <view class="reselect-bar">
    <view class="btn-reselect-top" bindtap="onChooseImage">
      <image class="reselect-icon" src="/assets/icons/convert-icon-red-uhd.png" mode="aspectFit"/>
      <text>重新选择图片</text>
    </view>
  </view>

  <!-- 图片预览区-->
  <view class="preview-zone">
    <view class="zoom-hint">
      <text class="zoom-hint-icon"></text>
      <text>支持双指缩放调整图片</text>
    </view>

    <view class="preview-box">
      <view wx:if="{{imageUrl}}" class="preview-interact" catchtouchstart="onPreviewTouchStart" catchtouchmove="onPreviewTouchMove" catchtouchend="onPreviewTouchEnd" catchtouchcancel="onPreviewTouchEnd">
        <view class="preview-image-layer" style="left:{{previewLeft}}px;top:{{previewTop}}px;width:{{previewBaseW}}px;height:{{previewBaseH}}px;transform:translate3d({{previewX}}px,{{previewY}}px,0) scale({{previewScale}});">
          <image class="preview-img" src="{{imageUrl}}" mode="scaleToFill"/>
        </view>
      </view>
      <view wx:else class="preview-placeholder" bindtap="onChooseImage">
        <text class="ph-icon">🖼</text>
        <text class="ph-text">点击选择图片</text>
      </view>
      <view wx:if="{{imageUrl}}" class="grid-overlay">
        <view class="grid-line h" style="top:33.3%"></view>
        <view class="grid-line h" style="top:66.6%"></view>
        <view class="grid-line v" style="left:33.3%"></view>
        <view class="grid-line v" style="left:66.6%"></view>
      </view>
    </view>
  </view>

  <!-- 设置面板 -->
  <view class="settings-panel">
    <!-- 尺寸选择 -->
    <view class="setting-section">
      <view class="setting-label-row">
        <view class="label-bar label-bar--yellow"></view>
        <text class="setting-label">图纸尺寸</text>
      </view>
      <view class="size-row">
        <app-select id="genSizeSelect" custom-class="gen-dropdown gen-dropdown--size" style="flex:1 1 0;min-width:0;" value="{{gridSizeIndex}}" title="{{gridSizeOptions[gridSizeIndex].label}}" options="{{sizeOptionsSelect}}" placement="bottom" bind:change="onSizeDropdownChange" bind:open="onSizeDropdownOpen" />
        <view class="size-half-box {{customMode || customConfirmed ? 'size-half-box--active' : ''}}" style="flex:1 1 0;min-width:0;" bindtap="onEditCustom">
          <input class="custom-size-input" type="number"
            value="{{customSizeVal}}" bindinput="onCustomSizeInput" bindblur="onCustomSizeBlur"
            focus="{{customMode}}" placeholder="自定义"/>
        </view>
      </view>
    </view>

    <!-- 颜色合并阈值-->
    <view class="setting-section">
      <view class="setting-label-row">
        <view class="label-bar label-bar--red"></view>
        <text class="setting-label">颜色合并阈值</text>
        <text class="threshold-value">{{similarityThreshold}}</text>
      </view>
      <view class="threshold-card threshold-card--inline">
        <text class="threshold-hint">值越大，相近色号合并越多</text>
        <slider class="threshold-slider" min="0" max="100" value="{{similarityThreshold}}" bindchange="onSimilarityThresholdChange" activeColor="#FF9800" backgroundColor="#F5E6D3" block-color="#FFD54F" />
        <view class="threshold-scale">
          <text>精细</text>
          <text>简化</text>
          <text>极简</text>
        </view>
      </view>
    </view>

    <!-- 品牌 + 色号 + 风格 -->
    <view class="setting-row-3col">
      <view class="setting-col">
        <view class="mini-label-row">
          <view class="mini-label-bar mini-label-bar--green"></view>
          <text class="mini-label">拼豆品牌</text>
        </view>
        <app-select id="genBrandSelect" custom-class="gen-dropdown gen-dropdown--brand" value="{{brandIndex}}" title="{{brandDisplayTitle}}" options="{{brandOptionsSelect}}" placement="top" bind:change="onBrandDropdownChange" bind:open="onBrandDropdownOpen" />
      </view>
      <view class="setting-col">
        <view class="mini-label-row">
          <view class="mini-label-bar mini-label-bar--purple"></view>
          <text class="mini-label">指定色号</text>
        </view>
        <app-select id="genColorSelect" custom-class="gen-dropdown gen-dropdown--color" value="{{colorCountValue}}" title="{{colorCountLabel}}" options="{{colorCountOptionsSelect}}" placement="top" bind:change="onColorCountDropdownChange" bind:open="onColorCountDropdownOpen" />
      </view>
      <view class="setting-col setting-col--small">
        <view class="mini-label-row">
          <view class="mini-label-bar mini-label-bar--blue"></view>
          <text class="mini-label">镜像</text>
        </view>
        <view class="mirror-btn {{mirrorOn ? 'mirror-btn--on' : ''}}" bindtap="onMirrorToggle">
          <text>{{mirrorOn ? '开' : '关'}}</text>
        </view>
      </view>
    </view>

  </view>
  </view>
  </scroll-view>

  <!-- 生成按钮 -->
  <view class="generate-bottom-bar">
    <view class="btn-generate" bindtap="onGenerate">立即生成图纸</view>
  </view>

  <!-- 离屏 Canvas -->
  <canvas type="2d" id="genCropCanvas" class="offscreen-canvas" style="width:640px;height:640px;"/>

  <!-- 加载蒙层 -->
  <view wx:if="{{loading}}" class="loading-mask">
    <view class="loading-box">
      <view class="loading-spinner"></view>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>
</view>
