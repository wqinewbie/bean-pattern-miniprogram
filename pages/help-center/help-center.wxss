page {
  height: 100vh;
  background: #FFF9ED;
  overflow: hidden;
}

.standalone-page {
  height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}


.sub-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.help-page {
  padding: 40rpx 40rpx calc(120rpx + env(safe-area-inset-bottom));
}

.help-section {
  margin-bottom: 48rpx;
}

.help-section-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.help-section-bar {
  width: 6rpx;
  height: 40rpx;
  background: #FF9800;
  border-radius: 999rpx;
}

.help-section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
}

.help-faq-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.help-faq-item {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(140,107,75,0.06);
  border: 4rpx solid #FFF4DC;
}

.help-faq-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.help-faq-question {
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
  line-height: 1.5;
}

.help-faq-arrow {
  font-size: 36rpx;
  color: #D0B8A1;
  font-weight: 800;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.help-faq-answer {
  font-size: 26rpx;
  color: #A1887F;
  line-height: 1.6;
  font-weight: 700;
}

.help-contact-card {
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  border-radius: 32rpx;
  padding: 48rpx;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(255,152,0,0.25);
}

.help-contact-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
}

.help-contact-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 700;
  margin-bottom: 32rpx;
}

.help-contact-btn {
  background: #fff;
  color: #FF9800;
  font-size: 28rpx;
  font-weight: 800;
  padding: 24rpx 48rpx;
  border-radius: 999rpx;
  display: inline-block;
  margin: 0;
  border: none;
  line-height: 1.5;
}

.help-contact-btn::after {
  border: none;
}

.help-contact-btn:active {
  transform: scale(0.95);
  background: #fff;
}
