.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #121212;
  color: #fff;
}

.top-bar {
  padding: 0 24rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
  background: #121212;
}
.back {
  width: 64rpx;
  font-size: 40rpx;
  color: #9E9E9E;
}
.top-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.action-btn {
  background: #2C2C2E;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFD54F;
}
.action-btn:active {
  opacity: 0.8;
}
.hint {
  background: #2C2C2E;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #BDBDBD;
}
.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #1C1C1E;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}
.nav-btn {
  background: #5C6BC0;
  color: #fff;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  font-size: 24rpx;
  font-weight: 700;
}
.nav-center {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.color-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(255,255,255,0.25);
}
.nav-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.nav-id { font-size: 24rpx; font-weight: 800; color: #fff; }
.nav-count { font-size: 18rpx; color: #BDBDBD; }
.nav-progress { font-size: 18rpx; color: #888; }

.canvas-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 16rpx;
}
.focus-canvas {
  width: 680rpx;
  height: 680rpx;
  border: 1rpx solid rgba(255,255,255,0.12);
  box-shadow: 0 0 40rpx rgba(0,0,0,0.55);
  transform-origin: center center;
}
.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 340px;
  height: 340px;
}

.bottom {
  padding: 14rpx 20rpx calc(26rpx + env(safe-area-inset-bottom));
}
.chips-wrap { margin-bottom: 16rpx; }
.chip-list { white-space: nowrap; }
.chips { display: inline-flex; gap: 10rpx; padding-right: 20rpx; }
.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 24rpx;
  background: #252525;
  border: 2rpx solid #333;
}
.chip--active { border-color: #FFD54F; background: #2E2A1B; }
.chip--done { opacity: 0.45; }
.chip-dot { width: 16rpx; height: 16rpx; border-radius: 50%; border: 2rpx solid #fff; }
.chip-id { font-size: 22rpx; color: #F2F2F2; font-weight: 700; }

.finish-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: #00E676;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 6rpx solid #00C853;
}
.finish-btn--done {
  background: #2C2C2E;
  border-bottom-color: #1C1C1E;
  color: #9E9E9E;
}
