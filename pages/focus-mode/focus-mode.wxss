page {
  height: 100vh;
  overflow: hidden;
  background: #FFF9ED;
  width: 100%;
  box-sizing: border-box;
}

.page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFF9ED;
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

.focus-reset-fab {
  position: absolute;
  right: 24rpx;
  top: 16rpx;
  padding: 0 24rpx;
  height: 72rpx;
  background: #FFFFFF;
  border: 4rpx solid #FFEBB5;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(140, 107, 75, 0.08);
  z-index: 20;
}

.focus-reset-fab:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 28rpx;
  color: #8C6B4B;
}

.fab-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #8C6B4B;
}

.main-area {
  flex: 1;
  min-height: 0;
  width: 100%;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  touch-action: none;
}

.grid-preview {
  width: 100%;
  height: 100%;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: visible;
}

.canvas-container {
  background: transparent;
  border-radius: 0;
  border: 0;
  box-shadow: none;
  overflow: visible;
  position: relative;
  touch-action: none;
}

.canvas-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}

.focus-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: #FFFFFF;
  border-top: 4rpx solid #FFEBB5;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 28rpx rgba(140, 107, 75, 0.14);
  display: flex;
  flex-direction: column;
  transition: height 0.12s ease-out;
  overflow: hidden;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.focus-panel-handle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0 10rpx;
  flex-shrink: 0;
}

.panel-handle-bar {
  width: 84rpx;
  height: 8rpx;
  background: #E0CFB5;
  border-radius: 999rpx;
}

.focus-panel-content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.contrast-section {
  padding: 0 24rpx 14rpx;
  flex-shrink: 0;
}

.contrast-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  border: 4rpx solid #FFF4DC;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(140, 107, 75, 0.04);
}

.contrast-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #5D4037;
  flex-shrink: 0;
}

.contrast-slider {
  flex: 1;
}

.contrast-value {
  font-size: 22rpx;
  font-weight: 800;
  color: #FF9800;
  width: 72rpx;
  text-align: right;
}

.tabs-section {
  padding: 0 24rpx 14rpx;
  flex-shrink: 0;
}

.tabs-card {
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 6rpx;
  display: flex;
  border: 4rpx solid #FFF4DC;
  box-shadow: 0 4rpx 12rpx rgba(140, 107, 75, 0.04);
  position: relative;
}

.tab-item {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  transition: all 0.2s;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-item--active {
  background: linear-gradient(135deg, #FFB74D, #FF9800);
  box-shadow: 0 6rpx 18rpx rgba(255, 152, 0, 0.35);
}

.tab-icon {
  font-size: 24rpx;
  color: #8C6B4B;
}

.tab-item--active .tab-icon {
  color: #FFFFFF;
}

.tab-label {
  font-size: 20rpx;
  font-weight: 800;
  color: #8C6B4B;
}

.tab-item--active .tab-label {
  color: #FFFFFF;
}

.hint-section {
  padding: 8rpx 24rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.hint-divider {
  flex: 1;
  height: 2rpx;
  background: #FFEBB5;
}

.hint-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #FF9800;
}

.cards-section {
  padding: 0 24rpx 28rpx;
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
}

.cards-section--compact {
  flex: 0 0 116rpx;
  min-height: 116rpx;
  padding-bottom: 24rpx;
}

.cards-section--expanded {
  flex: 1;
  min-height: 0;
}

.cards-grid {
  gap: 16rpx;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
}

.cards-grid--compact {
  display: flex;
  flex-wrap: nowrap;
  width: max-content;
  min-width: 100%;
  align-items: center;
}

.cards-grid--expanded {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 14rpx;
  padding: 4rpx 0 28rpx;
  white-space: normal;
}

.card-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx;
  border: 4rpx solid #FFF4DC;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(140, 107, 75, 0.03);
  transition: all 0.2s;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.cards-grid--compact .card-item {
  width: 80rpx;
  min-width: 80rpx;
  height: 80rpx;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  justify-content: center;
  flex-shrink: 0;
}

.cards-grid--compact .card-info {
  display: none;
}

.card-item:active {
  transform: scale(0.95);
}

.card-item--active {
  border-color: #FF9800;
  box-shadow: 0 6rpx 16rpx rgba(255, 152, 0, 0.2);
  transform: scale(1.02);
}

.card-item--done {
  /* 去掉整体变灰，改用 bead 级别的橙色边框 + 微深背景 */
}

.card-item--done.card-item--active {
  /* 完成态选中时保留橙色边框，仅缩放反馈 */
  transform: scale(0.97);
  border-color: #FF9800;
}

.card-item--done .card-bead {
  border-color: #FF9800;
  border-width: 5rpx;
  box-shadow: inset 0 0 0 1000rpx rgba(0, 0, 0, 0.12);
}

/* 展开模式 - 色号图底部颜色汇总风格 */
.cards-grid--expanded .card-item {
  aspect-ratio: 1;
  padding: 0;
  border: none;
  border-radius: 12rpx;
  background: transparent;
  box-shadow: none;
  overflow: visible;
}

.cards-grid--expanded .card-item:active {
  transform: scale(0.93);
}

.cards-grid--expanded .card-item--active {
  transform: scale(1.06);
  box-shadow: none;
  border-color: transparent;
}

.cards-grid--expanded .card-item--active .card-bead {
  box-shadow: 0 0 0 4rpx #FF9800, 0 4rpx 16rpx rgba(255, 152, 0, 0.3);
}

.cards-grid--expanded .card-item--done.card-item--active .card-bead {
  box-shadow: inset 0 0 0 1000rpx rgba(0, 0, 0, 0.12);
}

.cards-grid--expanded .card-item--done {
  /* 去掉整体变灰 */
}

.cards-grid--expanded .card-bead {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: none;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.cards-grid--expanded .card-item--done .card-bead {
  border: 4rpx solid #FF9800;
  box-shadow: inset 0 0 0 1000rpx rgba(0, 0, 0, 0.12);
}

.cards-grid--expanded .card-id {
  font-size: 24rpx;
  font-weight: 800;
  text-shadow: none;
  line-height: 1.2;
}

.cards-grid--expanded .card-count-badge {
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
}

.cards-grid--expanded .card-info {
  display: none;
}

.cards-grid--expanded .card-check {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: auto;
  height: auto;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.35);
}

.card-bead {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  position: relative;
}

.cards-grid--compact .card-bead {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  border-width: 3rpx;
}

.cards-grid--compact .card-item--done .card-bead {
  border-color: #FF9800;
  border-width: 4rpx;
  box-shadow: inset 0 0 0 1000rpx rgba(0, 0, 0, 0.12);
}

.card-id {
  font-size: 24rpx;
  font-weight: 800;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.card-check {
  font-size: 26rpx;
  font-weight: 800;
  color: #FFFFFF;
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: auto;
  height: auto;
  background: transparent;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.35);
  box-shadow: none;
}

.cards-grid--compact .card-check {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: auto;
  height: auto;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  color: #FFFFFF;
  font-size: 22rpx;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.35);
}

.card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}

.card-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #5D4037;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-count {
  font-size: 20rpx;
  font-weight: 800;
  color: #A1887F;
}

.loading-overlay {
  position: fixed;
  inset: 0;
  background: rgba(93, 64, 55, 0.6);
  backdrop-filter: blur(8rpx);
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.loading-container {
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 64rpx 80rpx;
  border: 8rpx solid #FFEBB5;
  box-shadow: 0 24rpx 80rpx rgba(93, 64, 55, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid #FFEBB5;
  border-top-color: #FF9800;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
}
