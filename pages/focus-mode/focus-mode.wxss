/* Figma 风格 - 沉浸式拼豆页面（像素级移植） */

page {
  height: 100vh;
  overflow: hidden;
  background: #FFF9ED;
  width: 100%;
  box-sizing: border-box;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFF9ED;
  width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* ========== 顶部导航栏 ========== */
.top-bar {
  background: rgba(255, 235, 181, 0.9);
  backdrop-filter: blur(20rpx);
  border-bottom: 4rpx solid #FFEBB5;
  box-shadow: 0 8rpx 30rpx rgba(255, 160, 0, 0.08);
  flex-shrink: 0;
  z-index: 100;
}

.top-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFEBB5;
  box-shadow: 0 4rpx 12rpx rgba(140, 107, 75, 0.08);
}

.back-btn:active {
  transform: scale(0.95);
}

.back-icon {
  font-size: 36rpx;
  color: #8C6B4B;
  font-weight: bold;
}

.title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #5D4037;
}

.size-badge {
  padding: 4rpx 12rpx;
  background: #FFF4DC;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #A1887F;
}

.top-bar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  /* margin-right 由 JS 动态计算 */
}

.action-btn {
  padding: 0 24rpx;
  height: 72rpx;
  background: #FFFFFF;
  border: 4rpx solid #FFEBB5;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(140, 107, 75, 0.08);
}

.action-btn:active {
  transform: scale(0.95);
}

.action-icon {
  font-size: 28rpx;
  color: #8C6B4B;
}

.action-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #8C6B4B;
}

/* ========== 主内容区 ========== */
.main-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

/* ========== 网格预览区 ========== */
.grid-preview {
  padding: 32rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.canvas-container {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 4rpx solid #FFF4DC;
  box-shadow: 0 8rpx 20rpx rgba(140, 107, 75, 0.05);
  overflow: hidden;
  position: relative;
  touch-action: none;
}

.canvas-wrapper {
  width: 100%;
  height: 100%;
  transition: transform 0.1s ease-out;
  will-change: transform;
}

/* ========== 对比度滑块 ========== */
.contrast-section {
  padding: 0 32rpx 16rpx;
  flex-shrink: 0;
}

.contrast-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  border: 4rpx solid #FFF4DC;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(140, 107, 75, 0.04);
}

.contrast-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #5D4037;
  flex-shrink: 0;
}

.contrast-slider {
  flex: 1;
}

.contrast-value {
  font-size: 22rpx;
  font-weight: 800;
  color: #FF9800;
  width: 72rpx;
  text-align: right;
}

/* ========== Tab 切换 ========== */
.tabs-section {
  padding: 0 32rpx 16rpx;
  flex-shrink: 0;
}

.tabs-card {
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 6rpx;
  display: flex;
  border: 4rpx solid #FFF4DC;
  box-shadow: 0 4rpx 12rpx rgba(140, 107, 75, 0.04);
  position: relative;
}

.tab-item {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  transition: all 0.2s;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-item--active {
  background: linear-gradient(135deg, #FFB74D, #FF9800);
  box-shadow: 0 6rpx 18rpx rgba(255, 152, 0, 0.35);
}

.tab-icon {
  font-size: 24rpx;
  color: #8C6B4B;
}

.tab-item--active .tab-icon {
  color: #FFFFFF;
}

.tab-label {
  font-size: 20rpx;
  font-weight: 800;
  color: #8C6B4B;
}

.tab-item--active .tab-label {
  color: #FFFFFF;
}

/* ========== 提示文字 ========== */
.hint-section {
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.hint-divider {
  flex: 1;
  height: 2rpx;
  background: #FFEBB5;
}

.hint-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #FF9800;
}

/* ========== 卡片列表 ========== */
.cards-section {
  padding: 0 32rpx 32rpx;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  width: 100%;
  box-sizing: border-box;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
}

.card-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx;
  border: 4rpx solid #FFF4DC;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(140, 107, 75, 0.03);
  transition: all 0.2s;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.card-item:active {
  transform: scale(0.95);
}

.card-item--active {
  border-color: #FF9800;
  box-shadow: 0 6rpx 16rpx rgba(255, 152, 0, 0.2);
  transform: scale(1.02);
}

.card-item--done {
  opacity: 0.6;
  filter: grayscale(0.2);
}

.card-bead {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  position: relative;
}

.card-id {
  font-size: 24rpx;
  font-weight: 800;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.card-check {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 56rpx;
  height: 56rpx;
  background: #22c55e;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(34, 197, 94, 0.5);
}

.card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}

.card-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #5D4037;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-count {
  font-size: 20rpx;
  font-weight: 800;
  color: #A1887F;
}

/* ========== 加载蒙层 ========== */
.loading-overlay {
  position: fixed;
  inset: 0;
  background: rgba(93, 64, 55, 0.6);
  backdrop-filter: blur(8rpx);
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.loading-container {
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 64rpx 80rpx;
  border: 8rpx solid #FFEBB5;
  box-shadow: 0 24rpx 80rpx rgba(93, 64, 55, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid #FFEBB5;
  border-top-color: #FF9800;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
}
