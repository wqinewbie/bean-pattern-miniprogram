<view class="focus-page">
  <page-nav-bar title="沉浸拼豆" nav-top="{{navTop}}" bind:back="onBack">
    <view slot="right" class="nav-actions">
      <view class="nav-action" bindtap="onShowList">列表</view>
      <view class="nav-action {{keepScreenOn?'nav-action--active':''}}" bindtap="onToggleKeepScreen">常亮</view>
      <view class="nav-action" bindtap="onSaveProgress">保存</view>
      <view class="nav-reset" bindtap="onResetAll">重置</view>
    </view>
  </page-nav-bar>

  <!-- 图纸列表弹窗 -->
  <view class="list-modal {{showListModal?'list-modal--show':''}}" wx:if="{{showListModal}}">
    <view class="list-modal-overlay" bindtap="onCloseList"></view>
    <view class="list-modal-content">
      <view class="list-modal-header">
        <text class="list-modal-title">图纸列表</text>
        <view class="list-modal-close" bindtap="onCloseList">✕</view>
      </view>
      <scroll-view class="list-modal-scroll" scroll-y>
        <view class="box-list">
          <view 
            class="box-item {{item.id===boxId?'box-item--active':''}}"
            wx:for="{{boxList}}"
            wx:key="id"
            bindtap="onSelectBox"
            data-id="{{item.id}}"
          >
            <view class="box-info">
              <text class="box-name">{{item.name || '未命名图纸'}}</text>
              <text class="box-meta">{{item.brand}} · {{item.gridSize}}x{{item.gridSize}} · {{item.colorCount}}色</text>
            </view>
            <view class="box-check" wx:if="{{item.id===boxId}}">✓</view>
          </view>
          <view class="box-empty" wx:if="{{boxList.length===0}}">
            <text>暂无图纸</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 进度提示 -->
  <view class="progress-bar" wx:if="{{doneCount > 0}}">
    <text class="progress-text">已完成 {{doneCount}} 色 / {{palette.length}} 色</text>
    <text class="progress-percent">{{Math.floor(doneCount / palette.length * 100)}}%</text>
  </view>

  <view class="summary" wx:if="{{currentColor}}">
    <view class="summary-btn" bindtap="onPrevColor">← 上一色</view>
    <view class="summary-center">
      <view class="summary-dot" style="background:rgb({{currentColor.r}},{{currentColor.g}},{{currentColor.b}})"></view>
      <view class="summary-meta">
        <text class="summary-id">{{currentColor.id}}</text>
        <text class="summary-count">{{currentIndex + 1}} / {{palette.length}} · {{currentColor.count}}颗</text>
      </view>
    </view>
    <view class="summary-btn" bindtap="onNextColor">下一色 →</view>
  </view>

  <view class="board-wrap">
    <canvas canvas-id="focus-canvas" class="focus-canvas" style="width: {{boardPx}}px; height: {{boardPx}}px;" />
    <canvas canvas-id="focus-base-canvas" class="hidden-canvas" style="width: {{boardPx}}px; height: {{boardPx}}px;" />
  </view>

  <card-shell variant="warm" animated="{{true}}" custom-class="bottom-panel {{panelExpanded ? 'panel-open' : 'panel-close'}} panel-slide-in">
    <view class="panel-handle" bindtap="onTogglePanel">
      <view wx:if="{{panelExpanded}}" class="handle-icon">⌄</view>
      <view wx:else class="handle-icon">⌃</view>
    </view>

    <view wx:if="{{panelExpanded}}" class="panel-body">
      <view class="control-row">
        <text class="control-label">对比度</text>
        <slider
          class="contrast-slider"
          min="20"
          max="100"
          step="10"
          value="{{contrast}}"
          activeColor="#d97706"
          backgroundColor="#ffffff"
          block-color="#ffffff"
          block-size="18"
          bindchange="onContrastChange"
        />
        <text class="control-value">{{contrast}}%</text>
      </view>

      <view class="mode-capsule">
        <view class="mode-indicator mode-indicator--{{mode}}"></view>
        <view class="mode-item {{mode==='colorId'?'mode-item--active':''}}" data-mode="colorId" bindtap="onModeChange">色号</view>
        <view class="mode-item {{mode==='horizontal'?'mode-item--active':''}}" data-mode="horizontal" bindtap="onModeChange">横向计数</view>
        <view class="mode-item {{mode==='vertical'?'mode-item--active':''}}" data-mode="vertical" bindtap="onModeChange">竖向计数</view>
      </view>

      <view class="divider"></view>

      <scroll-view class="palette-scroll" scroll-x>
        <view class="palette-row">
          <view
            wx:for="{{palette}}"
            wx:key="id"
            class="palette-item"
          >
            <view
              class="bead {{currentColorId===item.id?'bead--active':''}} {{completedMap[item.id]?'bead--done':''}}"
              style="background:rgb({{item.r}},{{item.g}},{{item.b}})"
              bindtap="onPickColor"
              bindlongpress="onToggleDone"
              data-id="{{item.id}}"
            >
              <text class="bead-id">{{item.id}}</text>
            </view>
            <text class="bead-count">{{item.count}}颗</text>
          </view>
        </view>
      </scroll-view>

      <text class="hint">点击高亮 · 长按标记完成</text>
    </view>
  </card-shell>
</view>
