<view class="page">
  <!-- 顶部导航栏 - Figma 风格 -->
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar-inner" style="height: {{navHeight}}px; padding-top: {{navTop - statusBarHeight}}px;">
      <view class="top-bar-left">
        <view class="back-btn" bindtap="onBack">
          <text class="back-icon">←</text>
        </view>
        <view class="title-group">
          <text class="title-text">沉浸式拼豆</text>
          <view class="size-badge">{{gridSize}}²</view>
        </view>
      </view>
      <view class="top-bar-right" style="margin-right: {{capsuleWidth + capsuleRight * 2 + 16}}px;">
        <view class="action-btn" bindtap="onResetAll">
          <text class="action-icon">↻</text>
          <text class="action-text">重置</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 主内容区 -->
  <view class="main-area">
    <!-- 网格预览区 -->
    <view class="grid-preview">
      <view 
        class="canvas-container" 
        style="width:{{canvasSize}}px;height:{{canvasSize}}px;"
        bindtouchstart="handleTouchStart"
        bindtouchmove="handleTouchMove"
        bindtouchend="handleTouchEnd"
        bindtouchcancel="handleTouchEnd"
      >
        <view 
          class="canvas-wrapper"
          style="transform: translate({{offsetX}}px, {{offsetY}}px) scale({{scale}}); transform-origin: center center;"
        >
          <bead-canvas2d 
            id="immersiveCanvas"
            canvas-id="immersive-canvas" 
            width="{{canvasSize}}"
            height="{{canvasSize}}"
            auto-init="{{true}}"
            bind:ready="onCanvasReady"
            bind:error="onCanvasError"
          />
        </view>
      </view>
    </view>

    <!-- 对比度滑块 -->
    <view class="contrast-section">
      <view class="contrast-card">
        <text class="contrast-label">对比度</text>
        <slider
          class="contrast-slider"
          min="0"
          max="100"
          step="10"
          value="{{contrast}}"
          activeColor="#FF9800"
          backgroundColor="#FFF4DC"
          block-color="#FF9800"
          block-size="18"
          bindchange="onContrastChange"
        />
        <text class="contrast-value">{{contrast}}%</text>
      </view>
    </view>

    <!-- Tab 切换 -->
    <view class="tabs-section">
      <view class="tabs-card">
        <view 
          class="tab-item {{tab==='color'?'tab-item--active':''}}"
          bindtap="onTabChange"
          data-tab="color"
        >
          <text class="tab-icon">#</text>
          <text class="tab-label">按色号</text>
        </view>
        <view 
          class="tab-item {{tab==='row'?'tab-item--active':''}}"
          bindtap="onTabChange"
          data-tab="row"
        >
          <text class="tab-icon">⇄</text>
          <text class="tab-label">按横排</text>
        </view>
        <view 
          class="tab-item {{tab==='col'?'tab-item--active':''}}"
          bindtap="onTabChange"
          data-tab="col"
        >
          <text class="tab-icon">⇅</text>
          <text class="tab-label">按竖排</text>
        </view>
      </view>
    </view>

    <!-- 提示文字 -->
    <view class="hint-section">
      <view class="hint-divider"></view>
      <text class="hint-text">点击卡片高亮 · 长按标记完成</text>
      <view class="hint-divider"></view>
    </view>

    <!-- 卡片列表 -->
    <scroll-view class="cards-section" scroll-y>
      <!-- 色号卡片（固定显示，不随 Tab 切换） -->
      <view class="cards-grid">
        <view 
          wx:for="{{palette}}" 
          wx:key="id"
          class="card-item {{highlightId===item.id?'card-item--active':''}} {{completedMap[item.id]?'card-item--done':''}}"
          bindtap="onCardTap"
          bindlongpress="onCardLongPress"
          data-type="color"
          data-value="{{item.id}}"
        >
          <view 
            class="card-bead" 
            style="background:rgb({{item.r}},{{item.g}},{{item.b}})"
          >
            <text wx:if="{{completedMap[item.id]}}" class="card-check">✓</text>
            <text wx:else class="card-id" style="color:{{item.textColor}}">{{item.id}}</text>
          </view>
          <view class="card-info">
            <text class="card-name">{{item.name || item.id}}</text>
            <text class="card-count">剩余 {{remainingByColor[item.id] || 0}} 颗</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 加载蒙层 -->
  <view wx:if="{{loading}}" class="loading-overlay">
    <view class="loading-container">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>
