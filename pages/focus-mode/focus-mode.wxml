<view class="focus-page">
  <!-- 顶部导航 -->
  <page-nav-bar title="沉浸拼豆" nav-top="{{navTop}}" bind:back="onBack">
    <view slot="right" class="nav-actions">
      <view class="nav-action" bindtap="onShowList">列表</view>
      <view class="nav-action {{keepScreenOn?'nav-action--active':''}}" bindtap="onToggleKeepScreen">常亮</view>
      <view class="nav-action" bindtap="onSaveProgress">保存</view>
      <view class="nav-reset" bindtap="onResetAll">重置</view>
    </view>
  </page-nav-bar>

  <!-- 图纸列表弹窗 -->
  <view class="list-modal {{showListModal?'list-modal--show':''}}" wx:if="{{showListModal}}">
    <view class="list-modal-overlay" bindtap="onCloseList"></view>
    <view class="list-modal-content">
      <view class="list-modal-header">
        <text class="list-modal-title">图纸列表</text>
        <view class="list-modal-close" bindtap="onCloseList">✕</view>
      </view>
      <scroll-view class="list-modal-scroll" scroll-y>
        <view class="box-list">
          <view 
            class="box-item {{item.id===boxId?'box-item--active':''}}"
            wx:for="{{boxList}}"
            wx:key="id"
            bindtap="onSelectBox"
            data-id="{{item.id}}"
          >
            <view class="box-info">
              <text class="box-name">{{item.name || '未命名图纸'}}</text>
              <text class="box-meta">{{item.brand}} · {{item.gridSize}}x{{item.gridSize}} · {{item.colorCount}}色</text>
            </view>
            <view class="box-check" wx:if="{{item.id===boxId}}">✓</view>
          </view>
          <view class="box-empty" wx:if="{{boxList.length===0}}">
            <text>暂无图纸</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 进度提示 -->
  <view class="progress-bar" wx:if="{{doneCount > 0}}">
    <text class="progress-text">已完成 {{doneCount}} 色 / {{palette.length}} 色</text>
    <text class="progress-percent">{{Math.floor(doneCount / palette.length * 100)}}%</text>
  </view>

  <view class="summary" wx:if="{{currentColor}}">
    <view class="summary-btn" bindtap="onPrevColor">← 上一色</view>
    <view class="summary-center">
      <view class="summary-dot" style="background:rgb({{currentColor.r}},{{currentColor.g}},{{currentColor.b}})"></view>
      <view class="summary-meta">
        <text class="summary-id">{{currentColor.id}}</text>
        <text class="summary-count">{{currentIndex + 1}} / {{palette.length}} · {{currentColor.count}}颗</text>
      </view>
    </view>
    <view class="summary-btn" bindtap="onNextColor">下一色 →</view>
  </view>

  <!-- 画板区域 -->
  <view 
    class="canvas-area"
    bindtouchstart="onBoardTouchStart"
    bindtouchmove="onBoardTouchMove"
    bindtouchend="onBoardTouchEnd"
  >
    <view 
      class="board-viewport"
      style="width: {{boardPx}}px; height: {{boardPx}}px;"
    >
      <view 
        class="board-canvas-wrap"
        style="width: {{canvasSize}}px; height: {{canvasSize}}px; left: {{canvasLeft}}px; top: {{canvasTop}}px;"
      >
        <canvas 
          canvas-id="focus-canvas" 
          style="width: {{canvasSize}}px; height: {{canvasSize}}px;"
        />
      </view>
      <!-- 加载遮罩 -->
      <view class="board-cover" wx:if="{{isRendering}}">
        <view class="render-spinner"></view>
      </view>
    </view>
    <!-- 隐藏画布：用于提取颜色 -->
    <canvas canvas-id="focus-base-canvas" class="hidden-canvas" style="width: {{boardPx}}px; height: {{boardPx}}px;" />
  </view>

  <!-- 底部面板：使用 cover-view 覆盖在 canvas 之上 -->
  <cover-view class="bottom-panel">
    <cover-view class="panel-handle" bindtap="onTogglePanel">
      <cover-view wx:if="{{panelExpanded}}" class="handle-icon">⌄</cover-view>
      <cover-view wx:else class="handle-icon">⌃</cover-view>
    </cover-view>

    <cover-view wx:if="{{panelExpanded}}" class="panel-body">
      <cover-view class="control-row">
        <cover-view class="control-label">对比度</cover-view>
        <slider
          class="contrast-slider"
          min="20"
          max="100"
          step="10"
          value="{{contrast}}"
          activeColor="#d97706"
          backgroundColor="#ffffff"
          block-color="#ffffff"
          block-size="18"
          bindchange="onContrastChange"
        />
        <cover-view class="control-value">{{contrast}}%</cover-view>
      </cover-view>

      <cover-view class="control-row zoom-row">
        <cover-view class="control-label">缩放</cover-view>
        <cover-view class="zoom-btns">
          <cover-view class="zoom-btn-mini" bindtap="onZoomOut">−</cover-view>
          <cover-view class="zoom-text">{{Math.floor(scale * 100)}}%</cover-view>
          <cover-view class="zoom-btn-mini" bindtap="onZoomIn">+</cover-view>
          <cover-view class="zoom-btn-mini reset" bindtap="onZoomReset">⟲</cover-view>
        </cover-view>
      </cover-view>

      <cover-view class="mode-capsule">
        <cover-view class="mode-indicator mode-indicator--{{mode}}"></cover-view>
        <cover-view class="mode-item {{mode==='colorId'?'mode-item--active':''}}" data-mode="colorId" bindtap="onModeChange">色号</cover-view>
        <cover-view class="mode-item {{mode==='horizontal'?'mode-item--active':''}}" data-mode="horizontal" bindtap="onModeChange">横向计数</cover-view>
        <cover-view class="mode-item {{mode==='vertical'?'mode-item--active':''}}" data-mode="vertical" bindtap="onModeChange">竖向计数</cover-view>
      </cover-view>

      <!-- 引导模式选择 -->
      <cover-view class="guidance-row">
        <cover-view class="guidance-label">引导:</cover-view>
        <cover-view class="guidance-btns">
          <cover-view 
            class="guidance-btn {{guidanceMode==='nearest'?'guidance-btn--active':''}}" 
            data-mode="nearest" 
            bindtap="onGuidanceModeChange"
          >最近</cover-view>
          <cover-view 
            class="guidance-btn {{guidanceMode==='largest'?'guidance-btn--active':''}}" 
            data-mode="largest" 
            bindtap="onGuidanceModeChange"
          >最大</cover-view>
          <cover-view 
            class="guidance-btn {{guidanceMode==='edge'?'guidance-btn--active':''}}" 
            data-mode="edge" 
            bindtap="onGuidanceModeChange"
          >边缘</cover-view>
        </cover-view>
      </cover-view>

      <cover-view class="divider"></cover-view>

      <scroll-view class="palette-scroll" scroll-x>
        <cover-view class="palette-row">
          <cover-view
            wx:for="{{palette}}"
            wx:key="id"
            class="palette-item"
          >
            <cover-view
              class="bead {{currentColorId===item.id?'bead--active':''}} {{completedMap[item.id]?'bead--done':''}}"
              style="background:rgb({{item.r}},{{item.g}},{{item.b}})"
              bindtap="onPickColor"
              bindlongpress="onToggleDone"
              data-id="{{item.id}}"
            >
              <cover-view class="bead-id">{{item.id}}</cover-view>
              <cover-view wx:if="{{completedMap[item.id]}}" class="bead-check">✓</cover-view>
            </cover-view>
            <cover-view class="bead-count">{{item.count}}颗</cover-view>
          </cover-view>
        </cover-view>
      </scroll-view>

      <cover-view class="hint">点击高亮 · 长按标记完成</cover-view>
    </cover-view>
  </cover-view>
</view>
