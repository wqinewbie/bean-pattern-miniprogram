page {
  height: 100vh;
  background: #FFF9ED;
  overflow: hidden;
}

.standalone-page {
  height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sub-header {
  position: relative;
  padding: 0 28rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #FFF4DC;
  background: #FFF9ED;
  flex-shrink: 0;
}

.sub-back {
  font-size: 42rpx;
  color: #8C6B4B;
  width: 96rpx;
  text-align: left;
  z-index: 2;
}

.sub-title-wrap {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  max-width: calc(100% - 240rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.sub-title {
  max-width: 100%;
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub-action {
  width: 96rpx;
  text-align: right;
  z-index: 2;
}

.sub-add--hidden {
  visibility: hidden;
}

.sub-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.privacy-page {
  padding: 40rpx 40rpx calc(120rpx + env(safe-area-inset-bottom));
}

.privacy-content {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(140,107,75,0.06);
  border: 4rpx solid #FFF4DC;
}

.privacy-section {
  margin-bottom: 48rpx;
}

.privacy-section:last-child {
  margin-bottom: 0;
}

.privacy-section-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 16rpx;
  text-align: center;
}

.privacy-update-time {
  display: block;
  font-size: 22rpx;
  color: #A1887F;
  text-align: center;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.privacy-subtitle {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 24rpx;
  padding-left: 24rpx;
  border-left: 6rpx solid #FF9800;
}

.privacy-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #8C6B4B;
  font-weight: 500;
  margin-bottom: 20rpx;
  text-align: justify;
}

.privacy-text:last-child {
  margin-bottom: 0;
}

.privacy-footer {
  margin-top: 64rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #FFF4DC;
  text-align: center;
}

.privacy-footer-text {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #FF9800;
}
