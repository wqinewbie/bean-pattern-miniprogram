page {
  height: 100vh;
  background: #FFF9ED;
  overflow: hidden;
}

.standalone-page {
  height: 100vh;
  background: #FFF9ED;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}


.sub-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.privacy-page {
  padding: 40rpx 40rpx calc(120rpx + env(safe-area-inset-bottom));
}

.privacy-content {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(140,107,75,0.06);
  border: 4rpx solid #FFF4DC;
}

.privacy-section {
  margin-bottom: 48rpx;
}

.privacy-section:last-child {
  margin-bottom: 0;
}

.privacy-section-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 16rpx;
  text-align: center;
}

.privacy-update-time {
  display: block;
  font-size: 22rpx;
  color: #A1887F;
  text-align: center;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.privacy-subtitle {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 24rpx;
  padding-left: 24rpx;
  border-left: 6rpx solid #FF9800;
}

.privacy-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #8C6B4B;
  font-weight: 500;
  margin-bottom: 20rpx;
  text-align: justify;
}

.privacy-text:last-child {
  margin-bottom: 0;
}

.privacy-footer {
  margin-top: 64rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #FFF4DC;
  text-align: center;
}

.privacy-footer-text {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #FF9800;
}
