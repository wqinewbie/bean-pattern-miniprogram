/* vip.wxss - VIP页面样式 */

.vip-page {
  height: 100vh;
  background: #1C1A1A;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ─── 导航栏 ─── */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #1C1A1A;
  flex-shrink: 0;
}

.nav-back {
  width: 72rpx;
  display: flex;
  align-items: center;
}

.nav-back-icon {
  font-size: 44rpx;
  color: rgba(255,255,255,0.7);
}

.nav-tabs {
  display: flex;
  background: rgba(0,0,0,0.4);
  border-radius: 40rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
}

.nav-tab {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.6);
  border-radius: 32rpx;
  transition: all 0.3s;
}

.nav-tab--active {
  background: linear-gradient(135deg, #FFD54F, #FF9800);
  color: #3E2723;
  box-shadow: 0 4rpx 16rpx rgba(255,152,0,0.3);
}

/* ─── 滚动区域 ─── */
.scroll-body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.tab-content {
  padding: 32rpx;
}

/* ─── 会员卡 Banner ─── */
.hero-banner {
  background: linear-gradient(135deg, #FFD54F, #FFB74D, #FF9800);
  border-radius: 48rpx;
  padding: 48rpx;
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.hero-crown {
  position: absolute;
  right: -24rpx;
  bottom: -24rpx;
  font-size: 240rpx;
  opacity: 0.2;
  transform: rotate(-15deg);
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #3E2723;
  display: block;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.hero-sub {
  font-size: 26rpx;
  font-weight: 500;
  color: #3E2723;
  opacity: 0.9;
  display: block;
  position: relative;
  z-index: 1;
}

/* ─── 次卡 Banner ─── */
.cards-banner {
  background: #2A2A2A;
  border-radius: 48rpx;
  padding: 48rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
}

.cards-banner-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFD54F;
  display: block;
  margin-bottom: 12rpx;
}

.cards-banner-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  display: block;
  margin-bottom: 24rpx;
}

.cards-vip-tip {
  display: inline-flex;
  align-items: center;
  background: rgba(255,213,79,0.2);
  border: 1rpx solid rgba(255,213,79,0.3);
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
}

.cards-vip-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFD54F;
}

/* ─── 套餐选择 ─── */
.plans-zone {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.plan-item {
  background: rgba(255,255,255,0.05);
  border: 6rpx solid rgba(255,255,255,0.1);
  border-radius: 32rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  transition: all 0.3s;
}

.plan-item--active {
  border-color: #FFD54F;
  background: rgba(255,213,79,0.1);
  transform: translateY(-4rpx);
  box-shadow: 0 16rpx 40rpx rgba(255,213,79,0.15);
}

.plan-tag {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #FF9800;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.plan-item:not(.plan-item--active) .plan-tag {
  background: rgba(255,255,255,0.2);
}

.plan-name {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.8);
  margin-bottom: 12rpx;
}

.plan-item--active .plan-name {
  color: #FFD54F;
}

.plan-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 4rpx;
}

.plan-unit {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

.plan-price {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.plan-item--active .plan-price {
  color: #FFD54F;
}

.plan-original {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  text-decoration: line-through;
}

.plan-limit {
  font-size: 20rpx;
  color: rgba(255,255,255,0.62);
  margin-top: 8rpx;
}

.plan-item--disabled {
  opacity: 0.45;
}

.plan-item--disabled.plan-item--active {
  transform: none;
  box-shadow: none;
  border-color: rgba(255,255,255,0.1);
  background: rgba(255,255,255,0.05);
}

.plan-disabled-tag {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255,255,255,0.25);
  color: rgba(255,255,255,0.9);
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

/* 会员价样式 */
.plan-price-row--vip {
  margin-bottom: 0;
}

.plan-vip-tag {
  background: #FFD54F;
  color: #3E2723;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.plan-price--vip {
  color: #FFD54F;
}

.plan-item--active .plan-price--vip {
  color: #FFD54F;
}

.plan-price--strikethrough {
  font-size: 32rpx;
  color: rgba(255,255,255,0.4);
  text-decoration: line-through;
}

.plan-regular-label {
  font-size: 18rpx;
  color: rgba(255,255,255,0.35);
  margin-left: 6rpx;
}

.plan-check {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 32rpx;
  height: 32rpx;
  background: #FFD54F;
  color: #3E2723;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}

/* ─── 优惠券选择 ─── */
.coupon-zone {
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.coupon-label {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
  margin-bottom: 16rpx;
}

.coupon-picker {
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.15);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.2s;
}

.coupon-picker-text {
  font-size: 26rpx;
  color: #FFD54F;
  font-weight: 500;
}

/* AppSelect Dropdown 覆盖样式 - VIP 暗色主题 */
.vip-dropdown {
  width: 100%;
}

.vip-dropdown .app-select__trigger {
  min-height: 76rpx;
  padding: 0 32rpx;
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.15);
}

.vip-dropdown .app-select__value {
  color: #FFD54F;
  font-size: 26rpx;
  font-weight: 500;
}

.vip-dropdown .app-select__arrow {
  color: rgba(255,255,255,0.5);
}

.vip-dropdown .app-select__panel {
  background: #2A2A2A;
  border-color: rgba(255,255,255,0.12);
}

.vip-dropdown .app-select__option:active,
.vip-dropdown .app-select__option--active {
  background: rgba(255,213,79,0.12);
}

.vip-dropdown .app-select__option-text {
  color: rgba(255,255,255,0.82);
}

.vip-dropdown .app-select__arrow {
  width: 14rpx;
  height: 14rpx;
  color: rgba(255,255,255,0.5);
  margin-left: auto;
  position: static;
}

/* ─── 权益对比表 ─── */
.privilege-table {
  background: rgba(255,255,255,0.05);
  border-radius: 32rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255,255,255,0.1);
  margin-bottom: 32rpx;
}

.privilege-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: rgba(255,255,255,0.05);
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
}

.privilege-row {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}

.privilege-row:last-child {
  border-bottom: none;
}

.privilege-col-title {
  flex: 1;
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.9);
}

.privilege-col {
  width: 140rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.5);
  text-align: center;
}

.privilege-col-vip {
  color: #FFD54F;
  font-weight: 700;
}

/* ─── 次卡说明 ─── */
.cards-notice {
  background: #2A2A2A;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
}

.notice-item {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  line-height: 1.8;
  display: block;
  margin-bottom: 12rpx;
}

.notice-item:last-child {
  margin-bottom: 0;
}

/* ─── 订单提示 ─── */
.orders-tip {
  background: rgba(255,152,0,0.2);
  border: 1rpx solid rgba(255,152,0,0.3);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.orders-tip-icon {
  font-size: 28rpx;
  color: #FF9800;
  flex-shrink: 0;
}

.orders-tip-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
}

.orders-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: rgba(255,255,255,0.3);
}

/* ─── 订单列表 ─── */
.orders-list {
  margin-bottom: 32rpx;
}

.order-item {
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
  margin-bottom: 24rpx;
}

.order-type {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-type-icon {
  font-size: 32rpx;
}

.order-type-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.order-status {
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.order-status-success {
  background: rgba(76,175,80,0.2);
  color: #4CAF50;
}

.order-status-gift {
  background: rgba(255,152,0,0.2);
  color: #FF9800;
}

.order-status-pending {
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.5);
}

.order-detail {
  margin-bottom: 24rpx;
}

.order-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-row:last-child {
  margin-bottom: 0;
}

.order-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}

.order-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.1);
}

.order-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFD54F;
}

.orders-footnote {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  padding-bottom: 40rpx;
}

/* ─── 底部支付栏 ─── */
.pay-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  background: #1C1A1A;
  border-top: 1rpx solid rgba(255,255,255,0.05);
  flex-shrink: 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.3);
}

.pay-price-info {
  display: flex;
  flex-direction: column;
}

.pay-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 4rpx;
}

.pay-amount-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.pay-original-price {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.4);
  text-decoration: line-through;
}

.pay-unit {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFD54F;
}

.pay-amount {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFD54F;
  line-height: 1;
}

.pay-vip-tip {
  font-size: 20rpx;
  color: rgba(255,213,79,0.7);
  background: rgba(255,213,79,0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
  display: inline-block;
}

.pay-coupon-tip {
  font-size: 20rpx;
  color: rgba(76,175,80,0.9);
  background: rgba(76,175,80,0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
  display: inline-block;
}

.pay-btn {
  background: linear-gradient(135deg, #FFD54F, #FF9800);
  color: #3E2723;
  font-size: 32rpx;
  font-weight: 700;
  padding: 24rpx 60rpx;
  border-radius: 48rpx;
  box-shadow: 0 12rpx 40rpx rgba(255,152,0,0.25);
}

.pay-btn--loading {
  opacity: 0.7;
}

.pay-btn--disabled {
  opacity: 0.45;
  box-shadow: none;
}
