/* vip.wxss */
.container {
  height: 100vh;
  background: #1A1A1A;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  flex-shrink: 0;
}

.nav-back {
  width: 72rpx; height: 72rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}

.nav-back-icon {
  font-size: 56rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1;
  margin-top: -4rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFD54F;
  letter-spacing: 2rpx;
}

/* 滚动区 */
.scroll-body {
  flex: 1;
  height: 0;
}

/* 顶部 Hero Banner */
.hero-banner {
  margin: 16rpx 32rpx 0;
  background: linear-gradient(135deg, #FFD54F, #FF9800);
  border-radius: 48rpx;
  padding: 56rpx 48rpx;
  position: relative;
  overflow: hidden;
  border-bottom: 6rpx solid #E65100;
}

.hero-crown {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 20rpx;
  position: relative; z-index: 1;
}

.hero-texts { position: relative; z-index: 1; }

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #3E2723;
  margin-bottom: 12rpx;
}

.hero-sub {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(62,39,35,0.7);
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
}

.hero-deco1 {
  width: 300rpx; height: 300rpx;
  right: -80rpx; top: -80rpx;
}

.hero-deco2 {
  width: 180rpx; height: 180rpx;
  right: 60rpx; bottom: -60rpx;
}

/* 特权列表 */
.benefits-zone {
  padding: 40rpx 32rpx 0;
}

.benefits-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.benefit-item {
  background: rgba(255,255,255,0.06);
  border: 2rpx solid rgba(255,213,79,0.2);
  border-radius: 32rpx;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.benefit-icon {
  font-size: 48rpx;
  line-height: 1;
}

.benefit-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFD54F;
}

.benefit-desc {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.5);
  line-height: 1.4;
}

/* 套餐选择 */
.plans-zone {
  padding: 40rpx 32rpx 0;
}

.plans-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: rgba(255,255,255,0.9);
  margin-bottom: 24rpx;
}

.plans-list {
  display: flex;
  gap: 20rpx;
}

.plan-item {
  flex: 1;
  background: rgba(255,255,255,0.06);
  border: 3rpx solid rgba(255,255,255,0.12);
  border-radius: 36rpx;
  padding: 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
}

.plan-item--active {
  background: rgba(255,213,79,0.12);
  border-color: #FFD54F;
  transform: translateY(-8rpx);
  box-shadow: 0 16rpx 40rpx rgba(255,213,79,0.2);
}

.plan-tag {
  position: absolute;
  top: -20rpx;
  background: #FF6B6B;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  padding: 6rpx 18rpx;
  border-radius: 40rpx;
}

.plan-name {
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(255,255,255,0.8);
}

.plan-price-row {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  margin-top: 8rpx;
}

.plan-unit {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFD54F;
  line-height: 1.6;
}

.plan-price {
  font-size: 56rpx;
  font-weight: 900;
  color: #FFD54F;
  line-height: 1;
}

.plan-period {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.4);
}

.plan-check {
  position: absolute;
  top: 20rpx; right: 20rpx;
  width: 36rpx; height: 36rpx;
  background: #FFD54F;
  border-radius: 50%;
  color: #3E2723;
  font-size: 22rpx;
  font-weight: 900;
  display: flex; align-items: center; justify-content: center;
}

/* 权益说明 */
.notice-zone {
  padding: 32rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.notice-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  font-weight: 600;
  line-height: 1.6;
}

/* 底部支付栏 */
.pay-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #212121;
  border-top: 2rpx solid rgba(255,213,79,0.2);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pay-price-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pay-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  font-weight: 600;
}

.pay-amount {
  font-size: 40rpx;
  font-weight: 900;
  color: #FFD54F;
}

.pay-btn {
  flex: 1;
  height: 96rpx;
  background: linear-gradient(135deg, #FFD54F, #FF9800);
  border-radius: 48rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #3E2723;
  border-bottom: 4rpx solid #E65100;
  box-shadow: 0 8rpx 24rpx rgba(255,152,0,0.4);
}

.pay-btn:active {
  transform: translateY(4rpx);
  border-bottom-width: 0;
}
