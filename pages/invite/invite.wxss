.page.invite-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffefbf 0rpx, #fff9ed 240rpx, #fffdf7 100%);
  box-sizing: border-box;
}

.safe-area {
  width: 100%;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 24rpx;
  box-sizing: border-box;
  position: relative;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.nav-back-icon {
  width: 38rpx;
  height: 38rpx;
}

.nav-title-abs {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  max-width: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5d4037;
  text-align: center;
}

.nav-right-spacer {
  height: 72rpx;
  flex-shrink: 0;
  margin-left: auto;
}

.page-body {
  padding: 12rpx 24rpx 40rpx;
}

.warm-panel,
.section-card {
  background: linear-gradient(180deg, #ffffff 0%, #fffaf0 100%);
  border-radius: 30rpx;
  border: 2rpx solid #fff0c8;
  box-shadow: 0 14rpx 36rpx rgba(255, 180, 64, 0.12);
  box-sizing: border-box;
}

.hero-card {
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.hero-card::after {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 213, 79, 0.22);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 168rpx;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff4dc;
  color: #b7791f;
  font-size: 22rpx;
  font-weight: 800;
  position: relative;
  z-index: 1;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #5d4037;
  position: relative;
  z-index: 1;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #9b7b5b;
  position: relative;
  z-index: 1;
}

.hero-highlight {
  margin-top: 26rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fffbef 0%, #fff3d1 100%);
  border: 2rpx solid #ffe1a0;
  position: relative;
  z-index: 1;
}

.hero-highlight-label,
.invite-code-label,
.input-label {
  display: block;
  font-size: 22rpx;
  color: #a1887f;
  font-weight: 700;
}

.hero-highlight-code,
.invite-code-value {
  display: block;
  margin-top: 10rpx;
  font-size: 52rpx;
  line-height: 1.1;
  font-weight: 900;
  color: #ff9800;
  letter-spacing: 8rpx;
}

.section-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.section-head--compact {
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #5d4037;
}

.section-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #a1887f;
}

.section-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff3cf 0%, #ffe1a0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.section-icon--purple {
  background: linear-gradient(135deg, #f3ecff 0%, #dfd3ff 100%);
}

.section-icon--orange {
  background: linear-gradient(135deg, #fff3db 0%, #ffd7a0 100%);
}

.invite-code-box,
.input-panel {
  padding: 24rpx 26rpx;
  background: #fffdf8;
  border-radius: 24rpx;
  border: 2rpx solid #fff0d2;
}

.btn-row {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.primary-btn,
.ghost-btn,
.outline-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  border: none;
  padding: 0;
}

.primary-btn::after,
.ghost-btn::after,
.outline-btn::after {
  border: none;
}

.primary-btn,
.ghost-btn {
  flex: 1;
}

.primary-btn {
  background: linear-gradient(135deg, #ffb74d 0%, #ff9800 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(255, 152, 0, 0.24);
}

.ghost-btn {
  background: #fff4dc;
  color: #8c6b4b;
}

.outline-btn {
  width: 100%;
  background: #ffffff;
  color: #c77700;
  border: 2rpx solid #ffe1a0;
}

.full-btn {
  margin-top: 20rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #fff7e8;
  color: #5d4037;
  font-size: 28rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #fffdf8;
  border: 2rpx solid #fff2db;
}

.tip-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffb300;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.75;
  color: #8c6b4b;
}
