.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff6da 0%, #f7f8fa 240rpx);
  padding: 28rpx;
  box-sizing: border-box;
}
.hero-card,
.code-card,
.manual-card,
.tips-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.06);
}
.hero-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}
.hero-desc,
.tip {
  display: block;
  font-size: 24rpx;
  color: #86909c;
  margin-top: 12rpx;
  line-height: 1.7;
}
.label,
.tips-title {
  display: block;
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 12rpx;
}
.code {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #ff9800;
  letter-spacing: 6rpx;
}
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.primary-btn,
.ghost-btn {
  flex: 1;
  border-radius: 999rpx;
}
.primary-btn {
  background: #ff9800;
  color: #fff;
}
.ghost-btn {
  background: #fff7e8;
  color: #c77700;
}
.full {
  margin-top: 20rpx;
}
.input {
  height: 88rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
