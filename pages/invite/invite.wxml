<view class="page invite-page">
  <page-nav-bar title="我的邀请码" bind:back="onBack"></page-nav-bar>

  <view class="page-body">
    <view class="hero-card warm-panel">
      <view class="hero-badge">好友同行计划</view>
      <text class="hero-title">邀请好友一起玩拼豆</text>
      <text class="hero-desc">好友使用你的邀请码登录后，可参与邀请注册与邀请充值任务，一起解锁更多奖励。</text>
    </view>

    <view class="section-card code-card">
      <view class="section-head">
        <view>
          <text class="section-title">分享邀请码</text>
          <text class="section-subtitle">复制或分享给好友，绑定后即可统计邀请进度</text>
        </view>
        <view class="section-icon">✨</view>
      </view>

      <view class="invite-code-box">
        <text class="invite-code-label">我的邀请码</text>
        <text class="invite-code-value">{{inviteCode || '加载中...'}}</text>
      </view>

      <view class="btn-row">
        <button class="ghost-btn" bindtap="onCopyCode">复制邀请码</button>
        <button class="primary-btn" bindtap="onShareInvite">立即邀请</button>
      </view>

      <button class="outline-btn full-btn" bindtap="onOpenRecords">查看邀请记录</button>
    </view>

    <view class="section-card manual-card">
      <view class="section-head section-head--compact">
        <view>
          <text class="section-title">手动填写邀请码</text>
          <text class="section-subtitle">如果你是被邀请用户，未绑定过邀请关系时可补填邀请码</text>
        </view>
        <view class="section-icon section-icon--purple">🎫</view>
      </view>

      <view class="input-panel">
        <text class="input-label">好友邀请码</text>
        <input class="input" maxlength="12" placeholder="请输入好友邀请码" value="{{inputCode}}" bindinput="onInputCode" />
      </view>

      <button class="ghost-btn full-btn" bindtap="onSaveInputCode">立即绑定邀请码</button>
    </view>

    <view class="section-card stats-card">
      <view class="section-head section-head--compact">
        <view>
          <text class="section-title">邀请进度</text>
          <text class="section-subtitle">邀请好友注册与首充均可获得奖励</text>
        </view>
        <view class="section-icon section-icon--orange">📌</view>
      </view>

      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-value">{{registeredCount}}</text>
          <text class="stat-label">已邀请注册</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{paidCount}}</text>
          <text class="stat-label">已邀请首充</text>
        </view>
      </view>

      <view wx:if="{{nextReward}}" class="reward-tip">
        <text class="reward-tip-text">{{nextReward.description}}</text>
        <text wx:if="{{nextReward.rewardText}}" class="reward-tip-highlight">{{nextReward.rewardText}}</text>
      </view>
    </view>
  </view>
</view>
