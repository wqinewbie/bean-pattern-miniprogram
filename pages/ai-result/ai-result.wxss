/* ai-result.wxss - AI 结果页样式（黑金高端风 - Figma配色） */

page {
  background: #050505;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #050505;
  color: #E0E0E0;
  position: relative;
  overflow: hidden;
}

/* 紫色环境光 - 右上角 */
.container::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(156, 39, 176, 0.15) 0%, transparent 70%);
  filter: blur(100rpx);
  pointer-events: none;
  z-index: 0;
}

/* 紫色环境光 - 左下角 */
.container::after {
  content: '';
  position: absolute;
  bottom: 20%;
  left: -60rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(199, 125, 255, 0.1) 0%, transparent 70%);
  filter: blur(80rpx);
  pointer-events: none;
  z-index: 0;
}

/* 状态栏和导航栏 */
.status-bar {
  width: 100%;
  flex-shrink: 0;
  position: relative;
  z-index: 10;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 10;
}

.header-back {
  position: absolute;
  left: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
}

.back-icon-svg {
  width: 48rpx;
  height: 48rpx;
}

.header-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 0.4em;
  color: #FFD54F;
}

.header-subtitle {
  font-size: 20rpx;
  color: rgba(255, 213, 79, 0.7);
  letter-spacing: 0.6em;
}

/* 滚动区 */
.scroll-body {
  flex: 1;
  overflow: hidden;
}

/* 预览卡片 */
.preview-card {
  margin: 28rpx 32rpx 0;
  border-radius: 48rpx;
  padding: 28rpx;
  box-shadow: 0 40rpx 100rpx rgba(0, 0, 0, 0.5);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(40rpx);
  position: relative;
  z-index: 10;
}

.preview-wrap {
  width: 100%;
  aspect-ratio: 1;
  background: #000000;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(156, 39, 176, 0.3);
  box-shadow: 0 0 80rpx rgba(156, 39, 176, 0.2), 0 0 40rpx rgba(255, 152, 0, 0.1);
}

/* 加载占位 */
.preview-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: rgba(5, 5, 5, 0.8);
  backdrop-filter: blur(26rpx);
  z-index: 1;
}

.preview-placeholder-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C77DFF, #9C27B0);
  box-shadow: 0 0 20rpx rgba(199, 125, 255, 0.5);
  animation: pulse 1.1s ease-in-out infinite;
}

.preview-placeholder-text {
  font-size: 24rpx;
  color: #C77DFF;
  font-weight: 600;
  letter-spacing: 0.3em;
}

@keyframes pulse {
  0%, 100% { transform: scale(0.85); opacity: 0.7; }
  50% { transform: scale(1.15); opacity: 1; }
}

/* 图片显示 */
.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  object-fit: contain;
  transition: opacity 0.2s ease;
}

.preview-img--hidden {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.preview-img--mirror {
  transform: scaleX(-1);
}

/* Tab 切换栏 */
.tab-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 8rpx;
  gap: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(224, 224, 224, 0.5);
  border-radius: 18rpx;
  transition: all 0.2s;
}

.tab--active {
  background: linear-gradient(135deg, #FFD54F 0%, #FF9800 100%);
  color: #3E2723;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.3);
}

/* VIP 标签 */
.vip-ribbon {
  position: absolute;
  top: 0;
  right: 28rpx;
  min-width: 80rpx;
  max-width: 160rpx;
  background: linear-gradient(180deg, #FFD54F 0%, #FF9800 50%, #D68400 100%);
  padding: 16rpx 20rpx 24rpx;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 152, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.vip-icon {
  font-size: 20rpx;
  margin-bottom: 8rpx;
}

.vip-text {
  color: #3E2723;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.3em;
}

.vip-style {
  max-width: 120rpx;
  margin-top: 6rpx;
  color: #3E2723;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
  letter-spacing: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 操作按钮 */
.action-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.3s;
}

.action-btn--edit {
  background: rgba(255, 255, 255, 0.05);
  color: #FFD54F;
  border: 2rpx solid rgba(255, 213, 79, 0.5);
  font-weight: 700;
}

.action-btn--edit:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.98);
}

.action-btn--primary {
  background: rgba(255, 255, 255, 0.05);
  color: #FFD54F;
  border: 2rpx solid rgba(255, 213, 79, 0.5);
  font-weight: 700;
  position: relative;
  overflow: hidden;
}

.action-btn--primary:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.98);
}

.action-btn--primary.action-btn--disabled {
  opacity: 0.5;
}

/* 色号清单卡片 */
.stats-card {
  margin: 32rpx;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20rpx);
  border-radius: 48rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  position: relative;
  z-index: 10;
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.08);
}

.stats-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stats-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #FFD54F 0%, #FFB74D 48%, #FF9800 100%);
  box-shadow: 0 0 14rpx rgba(255, 183, 77, 0.45);
}

.stats-title {
  font-size: 32rpx;
  font-weight: 300;
  color: #E0E0E0;
  letter-spacing: 0.2em;
}

.stats-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 600;
  letter-spacing: 0.1em;
}

/* 色号网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(255, 213, 79, 0.055) 0%, rgba(255, 255, 255, 0.018) 100%);
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 213, 79, 0.1);
  transition: all 0.3s;
}

.stat-item:hover {
  background: linear-gradient(135deg, rgba(255, 213, 79, 0.08) 0%, rgba(255, 255, 255, 0.03) 100%);
  border-color: rgba(255, 213, 79, 0.18);
}

.stat-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.stat-idx {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 600;
  min-width: 40rpx;
}

.stat-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 0 6rpx rgba(5, 5, 5, 0.9), 0 0 18rpx rgba(0, 0, 0, 0.65);
  border: 2rpx solid rgba(255, 213, 79, 0.35);
}

.stat-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.stat-id {
  font-size: 26rpx;
  font-weight: 500;
  color: #E0E0E0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


.stat-count {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFD54F;
  flex-shrink: 0;
}

/* 底部操作栏 */
.footer {
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 24rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(5, 5, 5, 0.8) 50%, #050505 100%);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.5);
  flex-shrink: 0;
  align-items: center;
}

.footer-btn-slot {
  flex: 1 1 0;
  min-width: 0;
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.footer-btn-slot--album {
  flex: 1 1 0;
}

.footer-btn-slot--album-expanded {
  flex: 2 1 0;
}

.footer-btn-slot--box {
  flex: 1 1 0;
}

.footer-btn-slot--box-hidden {
  flex: 0 0 0;
  opacity: 0;
  overflow: hidden;
  width: 0;
  margin: 0;
}

.footer-btn {
  width: 100%;
  height: 96rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  transition: all 0.3s;
  overflow: hidden;
  box-sizing: border-box;
}

.footer-btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  color: #E0E0E0;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  font-weight: 700;
}

.footer-btn-secondary:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.95);
}

.footer-btn--loading {
  pointer-events: none;
  opacity: 0.7;
}

.btn-loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.btn-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(224, 224, 224, 0.3);
  border-top-color: #E0E0E0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.btn-loading-text {
  font-size: 24rpx;
  color: #E0E0E0;
}

.footer-btn-primary {
  background: linear-gradient(90deg, #FFD54F 0%, #FFB74D 50%, #FF9800 100%);
  color: #3E2723;
  font-weight: 700;
  box-shadow: 0 20rpx 60rpx rgba(255, 152, 0, 0.25);
  position: relative;
  overflow: hidden;
}

.footer-btn-primary:active {
  transform: scale(0.95);
}

.footer-btn-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.footer-btn-text {
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}

/* 命名弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(20rpx);
}

.modal-content {
  position: relative;
  width: 100%;
  max-width: 560rpx;
  background: linear-gradient(135deg, rgba(20, 20, 20, 0.95) 0%, rgba(10, 10, 10, 0.98) 100%);
  border-radius: 48rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 40rpx 120rpx rgba(0, 0, 0, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  z-index: 1001;
}

.modal-glow {
  position: absolute;
  top: -100rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(199, 125, 255, 0.3) 0%, transparent 70%);
  filter: blur(80rpx);
  pointer-events: none;
}

.modal-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.modal-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD54F 0%, #FF9800 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 152, 0, 0.4);
}

.modal-icon {
  font-size: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFD54F;
  letter-spacing: 0.2em;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 24rpx;
  color: rgba(224, 224, 224, 0.6);
  text-align: center;
  line-height: 1.6;
  letter-spacing: 0.05em;
}

.modal-input {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #E0E0E0;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.modal-input::placeholder {
  color: rgba(224, 224, 224, 0.3);
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.3s;
}

.modal-btn-cancel {
  background: rgba(255, 255, 255, 0.05);
  color: rgba(224, 224, 224, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.modal-btn-cancel:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.98);
}

.modal-btn-confirm {
  background: linear-gradient(135deg, #FFD54F 0%, #FF9800 100%);
  color: #3E2723;
  box-shadow: 0 8rpx 24rpx rgba(255, 152, 0, 0.4);
}

.modal-btn-confirm:active {
  transform: scale(0.98);
}
