/* generating.wxss */
.container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #1C1A17 0%, #2A231C 50%, #1C1A17 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.2;
}

.bg-glow-1 {
  width: 320rpx;
  height: 320rpx;
  background: #FFD54F;
  top: 25%;
  right: -80rpx;
}

.bg-glow-2 {
  width: 320rpx;
  height: 320rpx;
  background: #FF9800;
  bottom: 25%;
  left: -80rpx;
}

.main {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  position: relative;
  z-index: 10;
}

/* 魔法阵动画 */
.magic-circle {
  width: 288rpx;
  height: 288rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 80rpx;
}

.magic-ring {
  position: absolute;
  border-radius: 50%;
  border-style: solid;
}

.magic-ring-1 {
  width: 288rpx;
  height: 288rpx;
  border: 6rpx solid rgba(255, 213, 79, 0.3);
  animation: rotate-ring 4s linear infinite;
}

.magic-ring-2 {
  width: 216rpx;
  height: 216rpx;
  border: 6rpx dashed rgba(255, 152, 0, 0.5);
  animation: rotate-ring-reverse 5s linear infinite;
}

.magic-ring-3 {
  width: 144rpx;
  height: 144rpx;
  background: linear-gradient(135deg, rgba(255, 213, 79, 0.2) 0%, transparent 100%);
  border: none;
  animation: pulse-glow 2s ease-in-out infinite;
}

@keyframes rotate-ring {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes rotate-ring-reverse {
  from { transform: rotate(360deg); }
  to { transform: rotate(0deg); }
}

@keyframes pulse-glow {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(1.1); }
}

.magic-center {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #3E2723 0%, #212121 100%);
  border-radius: 50%;
  box-shadow: 0 0 60rpx rgba(255, 213, 79, 0.3);
  border: 4rpx solid rgba(255, 213, 79, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 10;
}

.magic-icon {
  font-size: 64rpx;
  animation: bounce-icon 2s ease-in-out infinite;
}

@keyframes bounce-icon {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* 闪烁的星星 */
.sparkle {
  position: absolute;
  font-size: 32rpx;
  color: #FFD54F;
  animation: sparkle-blink 1.5s ease-in-out infinite;
}

.sparkle-1 {
  top: 0;
  left: 32rpx;
}

.sparkle-2 {
  bottom: 16rpx;
  right: 16rpx;
  animation-delay: 0.5s;
}

.sparkle-3 {
  top: 50%;
  left: -16rpx;
  animation-delay: 1s;
}

@keyframes sparkle-blink {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.8); }
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FFD54F 0%, #FF9800 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 24rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 213, 79, 0.2);
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10rpx);
  margin-bottom: 48rpx;
}

.spinner-small {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(255, 213, 79, 0.3);
  border-top-color: #FFD54F;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.status-text {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 213, 79, 0.8);
}

.sub {
  display: block;
  font-size: 26rpx;
  color: #D0B8A1;
  text-align: center;
  line-height: 1.8;
  margin-bottom: 80rpx;
  max-width: 520rpx;
}

.btn-row {
  display: none;
  gap: 24rpx;
  width: 100%;
  max-width: 560rpx;
}

.btn-outline {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  border: 4rpx solid rgba(255, 213, 79, 0.3);
  background: transparent;
  color: #FFD54F;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.btn-outline:active {
  opacity: 0.7;
  background: rgba(255, 213, 79, 0.1);
}

.btn-primary {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFD54F 0%, #FF9800 100%);
  color: #3E2723;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 152, 0, 0.3);
  transition: all 0.3s;
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-icon {
  font-size: 32rpx;
}
