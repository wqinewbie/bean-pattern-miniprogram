<view class="container">

  <!-- 背景装饰 -->
  <view class="bg-decoration bg-glow-1"></view>
  <view class="bg-decoration bg-glow-2"></view>

  <view wx:if="{{!isTimeout}}" class="main">
    <!-- 魔法阵动画 -->
    <view class="magic-circle">
      <view class="magic-ring magic-ring-1"></view>
      <view class="magic-ring magic-ring-2"></view>
      <view class="magic-ring magic-ring-3"></view>

      <view class="magic-center">
        <text class="magic-icon">✨</text>
      </view>

      <!-- 周围闪烁的星星 -->
      <text class="sparkle sparkle-1">✦</text>
      <text class="sparkle sparkle-2">✦</text>
      <text class="sparkle sparkle-3">✦</text>
    </view>

    <text class="title">魔法阵列启动中...</text>

    <view class="status-badge">
      <view class="spinner-small"></view>
      <text class="status-text">正在注入魔法能量</text>
    </view>

    <text class="sub">AI正在为您精心绘制像素图纸\n请耐心等待，见证奇迹时刻✨</text>
  </view>

  <view wx:else class="main">
    <!-- 魔法阵动画 -->
    <view class="magic-circle">
      <view class="magic-ring magic-ring-1"></view>
      <view class="magic-ring magic-ring-2"></view>
      <view class="magic-ring magic-ring-3"></view>

      <view class="magic-center">
        <text class="magic-icon">✨</text>
      </view>

      <text class="sparkle sparkle-1">✦</text>
      <text class="sparkle sparkle-2">✦</text>
      <text class="sparkle sparkle-3">✦</text>
    </view>

    <text class="title">魔法仍在凝结</text>
    <text class="sub">图片细节较为丰富，魔法师正在全力施法。\n您可先去别处逛逛，稍后在时光机查看生成结果。</text>

    <view class="btn-row">
      <view class="btn-outline" bindtap="onKeepWaiting">继续守护</view>
      <view class="btn-primary" bindtap="onGoHistory">
        <text class="btn-icon">✨</text>
        <text>去时光机</text>
      </view>
    </view>
  </view>

</view>
