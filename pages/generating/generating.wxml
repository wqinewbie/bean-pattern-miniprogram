<view class="container">

  <!-- 隐藏的 Canvas 用于渲染（渲染完成后传递给结果页） -->
  <canvas canvas-id="patternCanvas" style="width:300px;height:300px;position:fixed;left:-9999px;top:-9999px;"></canvas>
  <canvas canvas-id="resultCanvas" style="width:300px;height:300px;position:fixed;left:-9999px;top:-9999px;"></canvas>

  <view wx:if="{{!isTimeout}}" class="main">
    <view class="anim-wrap">
      <view class="ring ring1"></view>
      <view class="ring ring2"></view>
      <view class="center-box">
        <view class="spinner"></view>
      </view>
    </view>
    <text class="title">{{loadingText}}</text>
    <text class="sub">请稍候，马上就好...</text>
  </view>

  <view wx:else class="main">
    <view class="anim-wrap">
      <view class="ring ring1"></view>
      <view class="ring ring2"></view>
      <view class="center-box">
        <view class="spinner"></view>
      </view>
    </view>
    <text class="title">仍在生成中</text>
    <text class="sub">图片较为复杂，可稍后在「我的图纸」查看</text>
    <view class="btn-row">
      <view class="btn-outline" bindtap="onGoMyPatterns">去我的图纸</view>
      <view class="btn-primary" bindtap="onKeepWaiting">继续等待</view>
    </view>
  </view>

</view>
