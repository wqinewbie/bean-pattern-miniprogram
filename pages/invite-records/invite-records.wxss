.page.records-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffefbf 0rpx, #fff9ed 240rpx, #fffdf7 100%);
  box-sizing: border-box;
}

.safe-area {
  width: 100%;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 24rpx;
  box-sizing: border-box;
  position: relative;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.nav-back-icon {
  width: 38rpx;
  height: 38rpx;
}

.nav-title-abs {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  max-width: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5d4037;
  text-align: center;
}

.nav-right-spacer {
  height: 72rpx;
  flex-shrink: 0;
  margin-left: auto;
}

.page-body {
  padding: 12rpx 24rpx 40rpx;
}

.warm-panel,
.section-card {
  background: linear-gradient(180deg, #ffffff 0%, #fffaf0 100%);
  border-radius: 30rpx;
  border: 2rpx solid #fff0c8;
  box-shadow: 0 14rpx 36rpx rgba(255, 180, 64, 0.12);
  box-sizing: border-box;
}

.hero-card {
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.hero-card::after {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 213, 79, 0.22);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 168rpx;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff4dc;
  color: #b7791f;
  font-size: 22rpx;
  font-weight: 800;
  position: relative;
  z-index: 1;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #5d4037;
  position: relative;
  z-index: 1;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #9b7b5b;
  position: relative;
  z-index: 1;
}

.hero-code-box {
  margin-top: 26rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fffbef 0%, #fff3d1 100%);
  border: 2rpx solid #ffe1a0;
  position: relative;
  z-index: 1;
}

.hero-code-label,
.summary-label {
  display: block;
  font-size: 22rpx;
  color: #a1887f;
  font-weight: 700;
}

.hero-code-value {
  display: block;
  margin-top: 10rpx;
  font-size: 52rpx;
  line-height: 1.1;
  font-weight: 900;
  color: #ff9800;
  letter-spacing: 8rpx;
}

.section-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.section-head--compact {
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #5d4037;
}

.section-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #a1887f;
}

.section-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff3cf 0%, #ffe1a0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.section-icon--orange {
  background: linear-gradient(135deg, #fff3db 0%, #ffd7a0 100%);
}

.summary-grid {
  display: flex;
  gap: 18rpx;
}

.summary-item {
  flex: 1;
  padding: 26rpx 20rpx;
  border-radius: 24rpx;
  text-align: center;
  border: 2rpx solid transparent;
}

.summary-item--gold {
  background: linear-gradient(180deg, #fffaf0 0%, #fff1c9 100%);
  border-color: #ffe1a0;
}

.summary-item--green {
  background: linear-gradient(180deg, #f5fff5 0%, #e4f9e4 100%);
  border-color: #c9ecc9;
}

.summary-value {
  display: block;
  font-size: 54rpx;
  line-height: 1.1;
  font-weight: 900;
  color: #5d4037;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fffdf8;
  border: 2rpx solid #fff1d7;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #ffe9c2;
  flex-shrink: 0;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b5e3c;
  font-size: 30rpx;
  font-weight: 800;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #5d4037;
  font-weight: 800;
}

.time,
.empty-desc {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: #a1887f;
}

.status {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.status-registered {
  color: #2b6cb0;
  background: #e8f3ff;
}

.status-paid {
  color: #2f855a;
  background: #e8f8ea;
}

.empty-state {
  padding: 80rpx 20rpx 60rpx;
  text-align: center;
}

.empty-illustration {
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #fff3cf 0%, #ffe1a0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #5d4037;
  font-weight: 800;
  margin-bottom: 12rpx;
}
