.container {
  min-height: 100vh;
  background: #1a1a2e;
  padding: 0;
}

.video-wrapper {
  width: 100%;
  height: calc(100vh - 220rpx);
  min-height: 640rpx;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video {
  width: 100%;
  height: 100%;
  background: #000;
}

.info {
  padding: 32rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
}

.error-tip {
  padding: 40rpx;
  text-align: center;
  color: #ff6b6b;
  font-size: 28rpx;
}
