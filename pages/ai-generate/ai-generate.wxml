<view class="container">
  <view class="status-bar" style="height:{{statusBarHeight}}px"></view>

  <scroll-view scroll-y style="height:{{scrollHeight}}px" class="scroll-body" scroll-top="{{scrollTop}}" scroll-with-animation="{{true}}">
    <!-- 标题区 -->
    <view class="header">
      <view class="header-icon-card">
        <image class="header-icon" src="/assets/icons/6a80bb15-4304-48d3-8446-214e4fae91c6.png" mode="aspectFit"></image>
      </view>
      <view class="header-texts">
        <text class="header-title">AI 一键生成</text>
        <text class="header-sub">高级定制专属图纸</text>
      </view>
    </view>

    <!-- 图片上传卡片 -->
    <view class="upload-section">
      <view class="upload-card" bindtap="onChooseImage">
        <view wx:if="{{uploadedImage}}" class="preview-interact" catchtouchstart="onPreviewTouchStart" catchtouchmove="onPreviewTouchMove" catchtouchend="onPreviewTouchEnd" catchtouchcancel="onPreviewTouchEnd">
          <view class="preview-image-layer" style="left:{{previewLeft}}px;top:{{previewTop}}px;width:{{previewBaseW}}px;height:{{previewBaseH}}px;transform:translate3d({{previewX}}px,{{previewY}}px,0) scale({{previewScale}});">
            <image class="preview-img" src="{{uploadedImage}}" mode="scaleToFill"/>
          </view>
        </view>
        <view wx:if="{{uploadedImage}}" class="upload-overlay" catchtap="onChooseImage">
          <view class="upload-overlay-text">点击重新上传</view>
        </view>
        <view wx:else class="upload-placeholder">
          <image class="upload-icon" src="/assets/icons/upload-icon.png" mode="aspectFit"/>
          <text class="upload-title">点击上传图片</text>
          <text class="upload-desc">支持正方形图片 自动居中裁剪</text>
        </view>
        <view wx:if="{{uploadedImage}}" class="grid-overlay">
          <view class="grid-line h" style="top:33.3%"></view>
          <view class="grid-line h" style="top:66.6%"></view>
          <view class="grid-line v" style="left:33.3%"></view>
          <view class="grid-line v" style="left:66.6%"></view>
        </view>
      </view>
    </view>

    <!-- AI 指令（可选） -->
    <view class="ai-instruction-card">
      <textarea
        class="ai-instruction-input"
        placeholder="AI指令（可选）例如：去除背景..."
        value="{{aiInstruction}}"
        bindinput="onAiInstructionInput"
        maxlength="100"
        auto-height
      />
    </view>

    <!-- 魔法风格选择 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">魔法风格</text>
      </view>
      <scroll-view scroll-x class="magic-styles-scroll">
        <view class="magic-styles-list">
          <view wx:for="{{magicStyles}}" wx:key="name"
            class="magic-style-item {{selectedStyle===item.name?'magic-style-item--active':''}}"
            bindtap="onStyleTap" data-style="{{item.name}}">
            <view class="magic-style-icon-box">
              <image wx:if="{{item.icon}}" class="magic-style-icon-img" src="{{item.icon}}" mode="aspectFit" />
              <text wx:else class="magic-style-icon">✨</text>
              <view class="magic-style-tag">{{item.tag}}</view>
            </view>
            <text class="magic-style-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 图纸参数 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">图纸参数</text>
      </view>

      <view class="param-container">
        <!-- 图纸尺寸 -->
        <view class="param-group">
          <text class="param-label">图纸尺寸</text>
          <view class="size-mode-buttons">
            <view class="size-mode-btn {{sizeMode==='default'?'size-mode-btn--active':''}}" bindtap="onSizeModeTap" data-mode="default">
              默认尺寸
            </view>
            <view class="size-mode-btn {{sizeMode==='small'?'size-mode-btn--active':''}}" bindtap="onSizeModeTap" data-mode="small">
              小图特化
            </view>
          </view>
          <view class="param-hint-box">
            <text class="param-hint">{{sizeMode==='default'?'默认则根据图片自动匹配尺寸(区间在30~80)':'小图模式会将拼豆尺寸控制在 40 以内'}}</text>
          </view>
        </view>

        <!-- 品牌、色号、镜像 -->
        <view class="param-row-three">
          <view class="param-col">
            <text class="param-label-small">拼豆品牌</text>
            <app-select id="aiBrandSelect" custom-class="ai-dropdown ai-dropdown--brand" value="{{brandIndex}}" title="{{brands[brandIndex]}}" options="{{brandOptionsSelect}}" active-color="#9C27B0" panel-background="#FDF7FF" panel-border-color="#CE93D8" active-background="#F3E5F5" option-text-color="#7B1FA2" placement="top" bind:change="onBrandDropdownChange" bind:open="onBrandDropdownOpen" />
          </view>
          <view class="param-col">
            <text class="param-label-small">色号选择</text>
            <app-select id="aiColorSelect" custom-class="ai-dropdown ai-dropdown--color" value="{{colorSetValue}}" title="{{colorSetLabel}}" options="{{colorSetOptionsSelect}}" active-color="#9C27B0" panel-background="#FDF7FF" panel-border-color="#CE93D8" active-background="#F3E5F5" option-text-color="#7B1FA2" placement="top" bind:change="onColorSetDropdownChange" bind:open="onColorSetDropdownOpen" />
          </view>
          <view class="param-col param-col--small">
            <text class="param-label-small">图纸镜像</text>
            <view class="param-switch {{isMirrored?'param-switch--on':''}}" bindtap="onMirrorToggle">
              {{isMirrored ? '已开启' : '已关闭'}}
            </view>
          </view>
        </view>
      </view>
    </view>

  </scroll-view>
  <view wx:if="{{showAdjustModal}}" class="adjust-modal">
    <!-- 状态栏占位 -->
    <view class="adjust-status-bar" style="height:{{statusBarHeight}}px"></view>

    <!-- 顶部导航栏（与胶囊按钮对齐） -->
    <view class="adjust-header" style="height:40px">
      <view class="adjust-back-btn" bindtap="onCancelAdjust">
        <image class="header-icon" src="/assets/icons/lucide-arrow-left-brown.svg" mode="aspectFit"/>
      </view>
      <text class="adjust-title">照片尺寸调整</text>
      <view class="adjust-placeholder"></view>
    </view>

    <!-- 中间调整区域 -->
    <view class="adjust-body">
      <view class="adjust-hint">
        <text class="adjust-hint-icon">✨</text>
        <text class="adjust-hint-text">双指缩放、拖动以调整主体位置</text>
      </view>

      <view class="adjust-preview-box">
        <!-- 预览区域 -->
        <view class="adjust-preview-area"
          catchtouchstart="onAdjustTouchStart"
          catchtouchmove="onAdjustTouchMove"
          catchtouchend="onAdjustTouchEnd">
          <view class="adjust-image-layer"
            style="width:{{adjustBaseW}}px;height:{{adjustBaseH}}px;left:{{adjustLeft}}px;top:{{adjustTop}}px;transform:translate3d({{adjustX}}px,{{adjustY}}px,0) scale({{adjustScale}});">
            <image class="adjust-image" src="{{tempImage}}" mode="scaleToFill"/>
          </view>
        </view>

        <!-- 九宫格辅助线 -->
        <view class="adjust-grid-overlay">
          <view class="adjust-grid-line adjust-grid-h" style="top:33.3%"></view>
          <view class="adjust-grid-line adjust-grid-h" style="top:66.6%"></view>
          <view class="adjust-grid-line adjust-grid-v" style="left:33.3%"></view>
          <view class="adjust-grid-line adjust-grid-v" style="left:66.6%"></view>
        </view>
      </view>

      <!-- 底部占位，平衡布局 -->
      <view class="adjust-spacer"></view>
    </view>

    <!-- 底部固定按钮区（在tabbar上方） -->
    <view class="adjust-footer-fixed">
      <view class="adjust-confirm-btn" bindtap="onConfirmAdjust">
        <text class="adjust-confirm-icon">✨</text>
        <text>完成调整</text>
      </view>
    </view>
  </view>

  <!-- 隐藏的Canvas用于裁剪 -->
  <canvas type="2d" id="cropCanvas" style="width:{{previewBoxPx}}px;height:{{previewBoxPx}}px;position:fixed;left:-9999px;top:-9999px;"></canvas>


  <!-- 底部固定按钮区 -->
  <view class="bottom-action">
    <view class="generate-btn {{!uploadedImage?'generate-btn--disabled':''}}" bindtap="onGenerate">
      <view class="btn-content">
        <view class="btn-main">
          <text class="btn-icon">✨</text>
          <text>立即施展魔法</text>
        </view>
        <text class="btn-sub">剩余魔法 {{magicCount}} 次</text>
      </view>
    </view>
    <view class="ad-btn">
      <text class="ad-icon">📹</text>
      <text>看广告领取免费魔法次数</text>
    </view>
  </view>
</view>
