/* ai-generate.wxss */
.container {
  background: #FFF9ED;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.status-bar {
  width: 100%;
  background: #FFF9ED;
}

.scroll-body {
  flex: 1;
  padding: 0 0 calc(350rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: 100%;
  background: #FFFFFF;
}

/* ─── 标题栏 ─── */
.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 32rpx 40rpx;
}

.header-icon-card {
  width: 72rpx;
  height: 72rpx;
  background: #9C27B0;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(156,39,176,0.3);
  border-bottom: 6rpx solid #7B1FA2;
  flex-shrink: 0;
  transform: rotate(-6deg);
}

.header-icon {
  width: 40rpx;
  height: 40rpx;
}

.header-texts {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #5D4037;
  letter-spacing: 1rpx;
}

.header-sub {
  font-size: 24rpx;
  font-weight: 800;
  color: #A1887F;
}

/* ─── 上传区域 ─── */
.upload-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 40rpx 32rpx;
  width: calc(100% - 80rpx);
  box-sizing: border-box;
}

.upload-card {
  width: 640rpx;
  height: 640rpx;
  background: #fff;
  border-radius: 64rpx;
  border: 8rpx dashed #CE93D8;
  box-shadow: 0 16rpx 60rpx rgba(156,39,176,0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.upload-card:active {
  transform: scale(0.98);
}


.preview-interact {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.preview-image-layer {
  position: absolute;
  transform-origin: center center;
  will-change: transform;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.upload-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(2rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 64rpx;
  z-index: 10;
}

.upload-overlay-text {
  background: rgba(255,255,255,0.9);
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #9C27B0;
}


.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.upload-icon {
  width: 128rpx;
  height: 128rpx;
}

.upload-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #8C6B4B;
}

.upload-desc {
  font-size: 24rpx;
  font-weight: 800;
  color: #D0B8A1;
  max-width: 640rpx;
  text-align: center;
}

.grid-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 5;
}

.grid-line {
  position: absolute;
  background: rgba(156,39,176,0.15);
}

.grid-line.h {
  left: 0;
  right: 0;
  height: 2rpx;
}

.grid-line.v {
  top: 0;
  bottom: 0;
  width: 2rpx;
}

/* ─── Section ─── */
.section {
  margin-bottom: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.scroll-body .section:last-of-type {
  margin-bottom: 56rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 0 40rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #5D4037;
}

/* ─── 魔法风格 ─── */
.magic-styles-scroll {
  width: 100%;
  white-space: nowrap;
}

.magic-styles-list {
  display: inline-flex;
  gap: 28rpx;
  padding: 24rpx 40rpx 28rpx;
}

.magic-style-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  transition: all 0.3s;
}

.magic-style-item--active {
  transform: scale(1.08) translateY(-8rpx);
}

.magic-style-icon-box {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  border: 6rpx solid #F3E5F5;
  background: #fff;
  position: relative;
  overflow: hidden;
  transition: all 0.3s;
}

.magic-style-item--active .magic-style-icon-box {
  background: #F3E5F5;
  border-color: #9C27B0;
  box-shadow: 0 12rpx 40rpx rgba(156,39,176,0.25);
}

.magic-style-icon {
  position: relative;
  z-index: 2;
}

.magic-style-icon-img {
  width: 100%;
  height: 100%;
  position: relative;
  z-index: 2;
}

.magic-style-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 32rpx;
  background: rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(93,64,55,0.8);
  z-index: 3;
}

.magic-style-name {
  font-size: 24rpx;
  font-weight: 800;
  color: #8C6B4B;
  text-align: center;
}

.magic-style-item--active .magic-style-name {
  color: #9C27B0;
}

/* ─── 图纸参数 ─── */
.param-container {
  background: #fff;
  border: 4rpx solid #CE93D8;
  border-radius: 32rpx;
  padding: 32rpx;
  margin: 0 40rpx;
  box-sizing: border-box;
}

.param-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.param-group:last-child {
  margin-bottom: 0;
}

.param-label {
  font-size: 26rpx;
  font-weight: 800;
  color: #5D4037;
}

.size-mode-buttons {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.size-mode-btn {
  min-height: 96rpx;
  border-radius: 24rpx;
  color: #fff;
  background: #CE93D8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: all 0.3s;
  box-sizing: border-box;
  padding: 10rpx 8rpx;
}

.size-mode-name {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.1;
}

.size-mode-desc {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.1;
  opacity: 0.92;
}

.size-mode-btn--active {
  background: #9C27B0;
  box-shadow: 0 4rpx 16rpx rgba(156,39,176,0.3);
  border-bottom: 4rpx solid #7B1FA2;
}

.param-hint-box {
  background: #F3E5F5;
  border: 2rpx solid #E1BEE7;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.param-hint {
  font-size: 24rpx;
  font-weight: 500;
  color: #7B1FA2;
  line-height: 1.5;
}

.param-row-three {
  display: flex;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.param-col {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1.2;
  min-width: 0;
}

.param-col--small {
  flex: 0.9;
}

.param-label-small {
  font-size: 24rpx;
  font-weight: 800;
  color: #A1887F;
}

.param-picker {
  height: 72rpx;
  background: #F9FAFB;
  border: 4rpx solid #F1F8E9;
  border-radius: 24rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #5D4037;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  transition: all 0.2s;
}

.param-picker-arrow {
  font-size: 32rpx;
  color: #A1887F;
}

/* AppSelect Dropdown 覆盖样式 - AI Generate */
.ai-dropdown {
  width: 100%;
  box-sizing: border-box;
}

.ai-dropdown .app-select__trigger {
  min-height: 72rpx;
  padding: 0 12rpx;
  border-color: #CE93D8;
  background: #F3E5F5;
}

.ai-dropdown.app-select--open .app-select__trigger {
  border-color: #9C27B0;
  background: #E1BEE7;
  box-shadow: 0 0 0 4rpx rgba(156, 39, 176, 0.12);
}

.ai-dropdown .app-select__value {
  font-size: 24rpx;
  color: #7B1FA2;
}

.ai-dropdown.app-select--open .app-select__value {
  color: #9C27B0;
}

.ai-dropdown .app-select__arrow {
  width: 16rpx;
  height: 16rpx;
  color: #9C27B0;
  margin-left: auto;
  position: static;
}

.param-switch {
  width: 100%;
  height: 72rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 4rpx solid #E1BEE7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #9C27B0;
  transition: all 0.3s;
  box-sizing: border-box;
}

.param-switch--on {
  background: #F3E5F5;
  border-color: #9C27B0;
  color: #9C27B0;
}

.param-switch-thumb {
  display: none;
  transition: all 0.3s;
}

.param-switch--on .param-switch-thumb {
  transform: translateX(calc(100% + 8rpx));
}

/* ─── 底部固定按钮栏 ─── */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: auto;
  background: #FFFFFF;
  backdrop-filter: blur(20rpx);
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(140,107,75,0.06);
  padding: 20rpx 40rpx calc(24rpx + 110rpx + env(safe-area-inset-bottom));
  border-top: 4rpx solid #FFF4DC;
  z-index: 100;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.generate-btn {
  width: 100%;
  height: 120rpx;
  background: #9C27B0;
  border-radius: 24rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(156,39,176,0.25);
  border-bottom: 4rpx solid #7B1FA2;
  margin-bottom: 20rpx;
  transition: all 0.2s;
  box-sizing: border-box;
  padding: 20rpx 32rpx;
  gap: 4rpx;
}

.generate-btn:active {
  transform: translateY(4rpx);
  border-bottom-width: 0;
}

.generate-btn--disabled {
  background: #CE93D8;
  box-shadow: none;
  border-bottom-color: #AB47BC;
  transform: none;
}

.btn-loading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 8rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.btn-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 100%;
}

.btn-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 40rpx;
}

.btn-sub {
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.9);
  text-align: center;
}

.ad-btn {
  width: 100%;
  background: transparent;
  color: #FF9800;
  font-size: 26rpx;
  font-weight: 800;
  padding: 8rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.ad-btn:active {
  opacity: 0.7;
}

.ad-icon {
  font-size: 28rpx;
}

/* ─── 底部弹窗 ─── */

/* ─── 图片调整浮层 ─── */
.adjust-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFF9ED;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  animation: fade-in 0.3s ease-out;
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.adjust-status-bar {
  width: 100%;
  background: #fff;
  flex-shrink: 0;
}

.adjust-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  background: #fff;
  flex-shrink: 0;
  box-shadow: 0 1px 8px rgba(0,0,0,0.05);
}

.adjust-back-btn {
  width: 32px;
  height: 32px;
  background: #F3E5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.adjust-back-btn:active {
  transform: scale(0.95);
}

.adjust-back-icon {
  font-size: 24px;
  color: #9C27B0;
  font-weight: 300;
}

.adjust-title {
  font-size: 18px;
  font-weight: 800;
  color: #5D4037;
  flex: 1;
  text-align: center;
}

.adjust-placeholder {
  width: 32px;
  flex-shrink: 0;
}

.adjust-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 20px 12px;
  background: rgba(93,64,55,0.05);
  overflow: hidden;
}

.adjust-hint {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 16px;
  margin-bottom: 16px;
  border-radius: 999px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  flex-shrink: 0;
}

.adjust-hint-icon {
  font-size: 16px;
  color: #FF9800;
}

.adjust-hint-text {
  font-size: 13px;
  font-weight: 700;
  color: #8C6B4B;
}

.adjust-preview-box {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.adjust-spacer {
  height: 220px;
  flex-shrink: 0;
}

.adjust-preview-area {
  width: 340px;
  height: 340px;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(140,107,75,0.15);
  border: 2px solid #fff;
  position: relative;
}

.adjust-image-layer {
  position: absolute;
  transform-origin: center center;
  will-change: transform;
}

.adjust-image {
  width: 100%;
  height: 100%;
}

.adjust-grid-overlay {
  position: absolute;
  width: 340px;
  height: 340px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 10;
  border-radius: 16px;
  overflow: hidden;
}

.adjust-grid-line {
  position: absolute;
  background: rgba(156,39,176,0.2);
}

.adjust-grid-h {
  left: 0;
  right: 0;
  height: 1px;
}

.adjust-grid-v {
  top: 0;
  bottom: 0;
  width: 1px;
}

.adjust-footer-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  box-shadow: 0 -8px 30px rgba(140,107,75,0.08);
  padding: 24px 20px calc(24px + 120rpx + env(safe-area-inset-bottom));
  z-index: 101;
  box-sizing: border-box;
}

.adjust-confirm-btn {
  width: 100%;
  height: 48px;
  background: #9C27B0;
  border-radius: 999px;
  color: #fff;
  font-size: 18px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  box-shadow: 0 8px 20px rgba(156,39,176,0.3);
  border-bottom: 4px solid #7B1FA2;
  transition: all 0.2s;
}

.adjust-confirm-btn:active {
  transform: translateY(4px);
  border-bottom-width: 0;
}

.adjust-confirm-icon {
  font-size: 22px;
}
