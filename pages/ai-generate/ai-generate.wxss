/* ai-generate.wxss */
.container {
  background: #FFF9ED;
  min-height: 100vh;
}

.header {
  background: #FFEBB5;
  padding: 100rpx 40rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
  border-bottom: 4rpx solid #FFD54F;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.header-icon {
  width: 80rpx; height: 80rpx;
  background: #9C27B0;
  border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(156,39,176,0.3);
  border-bottom: 4rpx solid #7B1FA2;
  transform: rotate(-6deg);
  flex-shrink: 0;
}

.header-texts { display: flex; flex-direction: column; gap: 6rpx; }
.header-title { font-size: 36rpx; font-weight: 700; color: #5D4037; }
.header-sub   { font-size: 22rpx; color: #A1887F; }

.scroll-body {
  padding: 32rpx 32rpx 160rpx;
  box-sizing: border-box;
}

/* 输入卡片 */
.input-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 32rpx;
  border: 2rpx solid #F3E5F5;
  box-shadow: 0 8rpx 20rpx rgba(156,39,176,0.08);
  margin-bottom: 40rpx;
}

.prompt-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #5D4037;
  line-height: 1.6;
  background: transparent;
}

.input-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #FFF9ED;
}

.random-btn {
  font-size: 24rpx;
  font-weight: 700;
  color: #9C27B0;
  background: #F3E5F5;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
}

.random-btn:active { opacity: 0.7; }

.char-count { font-size: 22rpx; color: #D0B8A1; font-weight: 700; }

.section { margin-bottom: 40rpx; }

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #5D4037;
  margin-bottom: 20rpx;
}

.style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.style-item {
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8C6B4B;
  background: #fff;
  border: 2rpx solid #F3E5F5;
}

.style-item:active { opacity: 0.7; }

.style-item--active {
  background: #9C27B0;
  color: #fff;
  border-color: #7B1FA2;
  box-shadow: 0 4rpx 12rpx rgba(156,39,176,0.3);
  transform: translateY(-4rpx);
}

.size-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.size-item {
  height: 96rpx;
  border-radius: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #8C6B4B;
  background: #fff;
  border: 2rpx solid #E8F5E9;
  display: flex; align-items: center; justify-content: center;
}

.size-item:active { opacity: 0.7; }

.size-item--active {
  background: #4CAF50;
  color: #fff;
  border-color: #388E3C;
  box-shadow: 0 4rpx 12rpx rgba(76,175,80,0.3);
  transform: translateY(-4rpx);
}

.generate-btn {
  width: 100%;
  height: 104rpx;
  background: #9C27B0;
  border-radius: 52rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(156,39,176,0.3);
  border-bottom: 4rpx solid #7B1FA2;
  margin-bottom: 24rpx;
}

.generate-btn:active {
  transform: translateY(4rpx);
  border-bottom-width: 0;
}

.generate-btn--disabled {
  background: #CE93D8;
  box-shadow: none;
  border-bottom-color: #AB47BC;
}

.btn-loading { display: flex; align-items: center; gap: 16rpx; }

.spinner {
  width: 40rpx; height: 40rpx;
  border: 5rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.energy-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #A1887F;
}
