<view class="container">
  
  <!-- 顶部导航 -->
  <page-nav-bar title="图纸箱" nav-top="{{navTop}}" bind:back="onBack">
    <view slot="right" class="nav-add" bindtap="onAdd">+</view>
  </page-nav-bar>

  <!-- 搜索框 -->
  <view class="search-wrap">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" type="text" placeholder="搜索图纸..." placeholder-class="search-placeholder" bindinput="onSearchInput"/>
    </view>
  </view>

  <!-- 内容区 -->
  <scroll-view scroll-y class="scroll-body">
    <view wx:if="{{filteredPatterns.length===0}}" class="empty-state">
      <view class="empty-icon-wrap">
        <text class="empty-icon">📁</text>
      </view>
      <text class="empty-text">还没有图纸哦</text>
      <text class="empty-sub">生成图纸后点击「保存到图纸箱」</text>
    </view>

    <view class="list">
      <view wx:for="{{filteredPatterns}}" wx:key="id" class="pattern-item">
        <view class="item-thumb" bindtap="onItemTap" data-item="{{item}}">
          <view class="thumb-ph">{{item.gridSize || 64}}x{{item.gridSize || 64}}</view>
        </view>
        <view class="item-info" bindtap="onItemTap" data-item="{{item}}">
          <text class="item-title">{{item.name || ('图纸#'+item.id)}}</text>
          <text class="item-meta">{{item.brand || 'MARD'}} · {{item.colorCount || 0}}色 · {{item.createdAt}}</text>
        </view>
        <view class="item-del" bindtap="onDelete" data-id="{{item.id}}">🗑</view>
      </view>
    </view>
    <view style="height:120rpx"></view>
  </scroll-view>

  <!-- 统一底部 TabBar -->
  <app-tab-bar id="appTabBar" />

</view>
