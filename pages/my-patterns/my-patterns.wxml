<view class="patterns-page">
  <view class="safe-area" style="height: {{statusBarHeight}}px;"></view>

  <view class="patterns-header" style="height: {{navHeight}}px;">
    <view class="header-back" bindtap="onBack">
      <image class="header-icon" src="/assets/icons/lucide-arrow-left-brown.svg" mode="aspectFit"/>
    </view>
    <view class="header-title-wrap">
      <text class="header-title">图纸箱</text>
      <view class="header-badge">
        <image class="header-badge-icon" src="/assets/icons/lucide-folder-blue.svg" mode="aspectFit"/>
        <text>{{patterns.length}}/{{maxCapacity}}</text>
      </view>
    </view>
    <view class="header-right-spacer" style="width: {{capsuleWidth}}px;"></view>
  </view>

  <scroll-view scroll-y class="patterns-scroll">
    <view class="patterns-toolbar">
      <view class="search-box {{searchFocused ? 'search-box--focus' : ''}}">
        <image class="search-icon" src="/assets/icons/lucide-search-orange.svg" mode="aspectFit"/>
        <input class="search-input" type="text" placeholder="搜索图纸..." placeholder-class="search-placeholder" value="{{keyword}}" bindfocus="onSearchFocus" bindblur="onSearchBlur" bindinput="onSearchInput"/>
      </view>
      <view class="view-toggle-btn" bindtap="onToggleViewMode">
        <text>{{viewMode === 'thumb' ? '列表' : '缩略图'}}</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-state">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在打开图纸箱...</text>
    </view>

    <view wx:elif="{{filteredPatterns.length===0}}" class="empty-state">
      <view class="empty-icon-wrap">
        <image class="empty-icon" src="/assets/icons/lucide-folder-blue.svg" mode="aspectFit"/>
      </view>
      <text class="empty-text">{{keyword ? '没有找到相关图纸' : '还没有施展过魔法哦'}}</text>
    </view>

    <!-- 缩略图模式 -->
    <view wx:elif="{{viewMode === 'thumb'}}" class="patterns-grid">
      <view wx:for="{{filteredPatterns}}" wx:key="id" class="pattern-card">
        <view class="pattern-thumb" bindtap="onItemTap" data-item="{{item}}">
          <canvas wx:if="{{item.hasCanvasCover}}" id="boxThumbCanvas{{item.id}}" canvas-id="boxThumbCanvas{{item.id}}" class="thumb-canvas" type="2d"/>
          <image wx:elif="{{item.sourceUrl || item.coverUrl}}" class="thumb-img" src="{{item.sourceUrl || item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="thumb-ph">{{item.gridSize || 64}}x{{item.gridSize || 64}}</view>
          <view wx:if="{{item.sourceLabel}}" class="source-badge source-badge--{{item.sourceClass}}">
            <image wx:if="{{item.sourceClass==='ai'}}" class="source-icon" src="/assets/icons/lucide-sparkles-brown.svg" mode="aspectFit"/>
            <image wx:if="{{item.sourceClass==='free'}}" class="source-icon" src="/assets/icons/lucide-image-plus-blue.svg" mode="aspectFit"/>
            <image wx:if="{{item.sourceClass==='draft'}}" class="source-icon" src="/assets/icons/lucide-file-text-orange.svg" mode="aspectFit"/>
            <text>{{item.sourceLabel}}</text>
          </view>
        </view>
        <view class="pattern-body">
          <view class="pattern-name-row">
            <text class="pattern-name">{{item.name || '未命名作品'}}</text>
            <view class="pattern-name-actions">
              <view class="icon-btn icon-btn--rename" catchtap="onRename" data-item="{{item}}">
                <text class="icon-btn-emoji">✏️</text>
              </view>
              <view class="icon-btn icon-btn--delete" catchtap="onDelete" data-id="{{item.id}}">
                <image class="icon-btn-img" src="/assets/icons/lucide-trash-red.svg" mode="aspectFit"/>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 列表模式 -->
    <view wx:else class="patterns-list">
      <view wx:for="{{filteredPatterns}}" wx:key="id" class="list-item-wrapper">
        <!-- 操作按钮背景层 -->
        <view class="list-actions-bg">
          <view class="list-action-bg list-action-bg--rename" catchtap="onRename" data-item="{{item}}">
            <text>重命名</text>
          </view>
          <view class="list-action-bg list-action-bg--delete" catchtap="onDelete" data-id="{{item.id}}">
            <text>删除</text>
          </view>
        </view>
        <!-- 滑动层 -->
        <view class="list-item {{touchItemId === item.id && isSwiping ? 'swiping' : ''}}"
              style="transform: translateX({{swipedOffsets[item.id] || 0}}px);"
              bindtouchstart="onTouchStart"
              bindtouchmove="onTouchMove"
              bindtouchend="onTouchEnd"
              data-id="{{item.id}}">
          <view class="list-item-main" bindtap="onItemTap" data-item="{{item}}">
            <image wx:if="{{item.sourceUrl || item.coverUrl}}" class="list-thumb" src="{{item.sourceUrl || item.coverUrl}}" mode="aspectFill" />
            <view wx:else class="list-thumb list-thumb--ph">{{item.gridSize || 64}}</view>
            <view class="list-info">
              <text class="list-name">{{item.name || '未命名作品'}}</text>
              <text class="list-meta-text">{{item.gridSize || 64}}x{{item.gridSize || 64}} · {{item.sourceLabel || '未知'}} · {{item.createdAt}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view style="height: 48rpx;"></view>
  </scroll-view>
</view>
