/* draft.wxss - 草稿箱页面样式 */

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFF9ED;
}

.scroll-body {
  flex: 1;
  overflow: hidden;
}

/* ─── 提示卡片 ─── */
.tip-card {
  margin: 28rpx 32rpx;
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  border: 2rpx solid #FFCC80;
}

.tip-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.tip-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #E65100;
}

.tip-desc {
  font-size: 24rpx;
  color: #BF360C;
  line-height: 1.5;
}

/* ─── 加载状态 ─── */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #FFE0B2;
  border-top-color: #FF9800;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #A1887F;
}

/* ─── 空状态 ─── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  gap: 20rpx;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
}

.empty-desc {
  font-size: 26rpx;
  color: #A1887F;
  text-align: center;
}

.empty-btn {
  margin-top: 20rpx;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #FFD54F, #FF9800);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #3E2723;
}

/* ─── 草稿列表 ─── */
.list-area {
  padding: 0 32rpx;
}

.draft-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.draft-item {
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(140, 107, 75, 0.08);
  border: 2rpx solid #FFF4DC;
}

/* 缩略图 */
.draft-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  background: #F5F5F5;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.draft-canvas {
  width: 140rpx;
  height: 140rpx;
}

.draft-thumb-ph {
  font-size: 60rpx;
}

.draft-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.draft-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.draft-meta {
  font-size: 22rpx;
  color: #8C6B4B;
  background: #FFF9ED;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  align-self: flex-start;
}

.draft-time {
  font-size: 20rpx;
  color: #A1887F;
}

/* 操作按钮 */
.draft-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.draft-action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #FFF4DC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.draft-action:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.draft-action--del {
  background: #FFEBEE;
}

/* ─── 保存到图纸箱弹窗 ─── */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(93, 64, 55, 0.4);
  z-index: 70;
}

.save-modal {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: -520rpx;
  background: #fff;
  border-radius: 36rpx;
  border: 3rpx solid #FFEBC8;
  box-shadow: 0 20rpx 60rpx rgba(140, 107, 75, 0.22);
  padding: 28rpx;
  z-index: 71;
  transition: bottom 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.save-modal--show {
  bottom: calc(34rpx + env(safe-area-inset-bottom));
}

.modal-handle {
  width: 60rpx;
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-input {
  height: 84rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFE3B2;
  background: #FFF9ED;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #5D4037;
}

.modal-placeholder {
  color: #C9A98A;
}

.modal-hint {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #A1887F;
}

.modal-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 82rpx;
  border-radius: 41rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.modal-btn--cancel {
  background: #FFF4DC;
  color: #8C6B4B;
}

.modal-btn--confirm {
  background: linear-gradient(135deg, #FFD54F, #FF9800);
  color: #3E2723;
  border-bottom: 6rpx solid #F57C00;
}
