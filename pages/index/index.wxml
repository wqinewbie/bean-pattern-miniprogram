<view class="home-page">
  <!-- 安全区域占位 -->
  <view style="height: {{statusBarHeight}}px; width: 100%;"></view>

  <!-- 顶部欢迎卡片 -->
  <view class="welcome-card">
    <view class="welcome-deco-1"></view>
    <view class="welcome-deco-2"></view>
    <view class="welcome-row">
      <view class="welcome-text">
        <view class="welcome-title-row">
          <text class="welcome-title">{{isLoggedIn ? (isVip ? '尊贵的魔法师' : '可爱的魔法学徒') : '欢迎来到魔法屋'}}</text>
          <image
            class="welcome-title-icon"
            src="{{isLoggedIn ? (isVip ? '/assets/icons/welcome-crown.svg' : '/assets/icons/lucide-wand.svg') : '/assets/icons/lucide-wand.svg'}}"
            mode="aspectFit"
          />
        </view>
        <text class="welcome-sub">今天想创造什么奇迹呢？</text>
      </view>
      <view wx:if="{{isLoggedIn}}" class="welcome-magic-pill">
        <image class="welcome-magic-icon" src="/assets/icons/ai-sparkle-yellow-uhd.png" mode="aspectFit"/>
        <text class="welcome-magic-count">{{magicCount}}</text>
      </view>
    </view>
  </view>

  <!-- Banner 轮播 -->
  <view class="banner-zone" wx:if="{{bannerList.length > 0}}">
    <view class="banner-frame">
      <swiper
        class="banner-swiper"
        circular="{{bannerList.length > 1}}"
        autoplay="{{bannerAutoplay}}"
        interval="3600"
        duration="500"
        current="{{activeBanner}}"
        bindchange="onBannerChange"
        indicator-dots="{{false}}"
      >
        <swiper-item wx:for="{{bannerList}}" wx:key="id">
          <view
            class="banner-slide"
            bindtap="onBannerTap"
            data-banner="{{item}}"
          >
            <image wx:if="{{item.imageUrl}}" class="banner-bg-img" src="{{item.imageUrl}}" mode="aspectFill"/>
          </view>
        </swiper-item>
      </swiper>
      <view class="banner-dots">
        <view
          wx:for="{{bannerList}}"
          wx:key="id"
          class="banner-dot {{activeBanner === index ? 'banner-dot--active' : ''}}"
        ></view>
      </view>
    </view>
  </view>

  <!-- 功能卡片区域 -->
  <view class="action-zone">
    <view class="action-grid">
      <!-- 图片转图纸 -->
      <view class="action-card" bindtap="onBeadPatternLocal">
        <view class="action-icon icon-pink">
          <image class="icon-img icon-img--convert-home" src="/assets/icons/convert-icon-red-uhd.png" mode="aspectFit"/>
        </view>
        <text class="action-title">图片转图纸</text>
        <text class="action-desc">智能识别色彩</text>
      </view>

      <!-- AI一键生成 -->
      <view class="action-card" bindtap="onBeadPatternAI">
        <view class="action-icon icon-purple">
          <image class="icon-img icon-img--ai-home" src="/assets/icons/ai-sparkle-purple-uhd.png" mode="aspectFit"/>
        </view>
        <text class="action-title">AI一键生成</text>
        <text class="action-desc">高级定制图纸</text>
      </view>

      <!-- 空白画板 -->
      <view class="action-card" bindtap="onDrawBoard">
        <view class="action-icon icon-blue">
          <image class="icon-img" src="/assets/icons/lucide-pen-tool.svg" mode="aspectFit"/>
        </view>
        <text class="action-title">空白画板</text>
        <text class="action-desc">自由创作拼豆</text>
      </view>

      <!-- 拼豆魔法 -->
      <view class="action-card" bindtap="onGoMyPatterns">
        <view class="action-icon icon-yellow">
          <image class="icon-img icon-img--jimeng" src="/assets/icons/tweezers-orange.svg" mode="aspectFit"/>
        </view>
        <text class="action-title">沉浸式拼豆</text>
        <text class="action-desc">让拼豆变得更高效</text>
      </view>
    </view>
  </view>

  <!-- 魔法小课堂 -->
  <view class="tutorial-zone" wx:if="{{tutorials.length > 0}}">
    <view class="tutorial-header">
      <view class="tutorial-title-row">
        <view class="title-bar"></view>
        <text class="tutorial-title">魔法小课堂</text>
      </view>
    </view>

    <view class="tutorial-list">
      <view class="tutorial-card" wx:for="{{tutorials}}" wx:key="id" bindtap="onTutorialTap" data-tutorial="{{item}}">
        <view class="tutorial-thumb">
          <image wx:if="{{item.thumbnailUrl}}" src="{{item.thumbnailUrl}}" class="tutorial-thumb-img" mode="aspectFill" />
          <view wx:else class="tutorial-play-icon">▶</view>
          <view class="tutorial-thumb-overlay"></view>
        </view>
        <view class="tutorial-info">
          <text class="tutorial-name">{{item.title}}</text>
          <text class="tutorial-desc">{{item.description}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-space"></view>

  <!-- 全局弹窗 -->
  <global-popup id="globalPopup" config="{{currentPopup}}" bind:confirm="onPopupConfirm" bind:close="onPopupClose"/>

  <!-- 加载蒙层 -->
  <view wx:if="{{loading}}" class="loading-mask">
    <view class="loading-box">
      <view class="loading-spinner"></view>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>

  <login-modal id="login-modal" />
</view>
