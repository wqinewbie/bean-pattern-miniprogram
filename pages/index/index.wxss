.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.convert-btn {
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
}

.card {
  width: 100%;
  margin-top: 36rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
}

.preview {
  width: 100%;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.download-btn {
  margin-top: 20rpx;
}
