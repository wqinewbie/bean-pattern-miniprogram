/* app.wxss - 全局样式 */

page {
  background: #FFF9ED;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* 全局滚动条隐藏 */
::-webkit-scrollbar { display: none; }

/* 通用点击态 */
.touchable { transition: opacity 0.15s; }
.touchable:active { opacity: 0.7; }

/* 通用加载蒙层 */
.g-loading-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.g-loading-box {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.g-loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: #FACC15;
  border-radius: 50%;
  animation: g-spin 0.8s linear infinite;
}

@keyframes g-spin { to { transform: rotate(360deg); } }

.g-loading-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

