/* page-nav-bar 组件样式 - 暖色调 */
/* 注意：所有尺寸使用 px 单位，与 JS 计算保持一致 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 10px;
  padding-left: 16px;
  padding-right: 16px;
  background: #FFF9ED;
  flex-shrink: 0;
  z-index: 10;
  height: 32px;
}

.nav-back {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back-arrow {
  font-size: 20px;
  color: #A1887F;
}

.nav-placeholder {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
}

.nav-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.nav-title {
  font-size: 16px;
  font-weight: 800;
  color: #5D4037;
  line-height: 1.2;
}

.nav-sub {
  font-size: 11px;
  color: #A1887F;
  font-weight: 700;
  line-height: 1.2;
}

.nav-right {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
