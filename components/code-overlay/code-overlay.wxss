/* 色号覆盖层容器 */
.code-overlay-container {
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none; /* 不拦截触摸事件 */
  z-index: 30; /* 在网格层和触摸层之上，确保可见 */
  overflow: visible;
}

/* 色号 Canvas */
.code-canvas {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none;
  z-index: 30;
  /* 硬件加速 */
  will-change: auto;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.code-label {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  pointer-events: none;
  -webkit-font-smoothing: antialiased;
  text-rendering: geometricPrecision;
}
