/* 登录弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(93, 64, 55, 0.4);
  z-index: 999;
}

.login-modal {
  position: fixed;
  bottom: -100%;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 32rpx 48rpx 80rpx;
  z-index: 1000;
  transition: bottom 0.35s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  border-top: 8rpx solid #FFEBB5;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.login-modal--show {
  bottom: 0;
}

.modal-close {
  position: absolute;
  top: 32rpx;
  right: 40rpx;
  font-size: 36rpx;
  color: #D0B8A1;
  padding: 8rpx;
}

.modal-magic-icon {
  width: 120rpx;
  height: 120rpx;
  background: #FFF4DC;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  border: 8rpx solid #FFEBB5;
  margin-top: 24rpx;
}

.modal-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #5D4037;
  margin-top: 8rpx;
}

.modal-sub {
  font-size: 26rpx;
  color: #A1887F;
  margin-top: -8rpx;
  text-align: center;
}

.modal-wechat-btn {
  width: 100%;
  height: 104rpx;
  background: #07C160;
  border-radius: 52rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  border-bottom: 8rpx solid #05964B;
  margin-top: 8rpx;
}

.modal-wechat-btn:active {
  opacity: 0.85;
}

.modal-wechat-btn--ghost {
  background: #EAF9F0;
  color: #0F8F4D;
  box-shadow: none;
  border: 4rpx solid #BDECCF;
  border-bottom: 4rpx solid #8DD8AE;
}

.modal-wechat-btn--ghost .modal-spinner {
  border: 5rpx solid rgba(15, 143, 77, 0.18);
  border-top-color: #0F8F4D;
}

.btn-loading-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.modal-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.modal-skip-btn {
  width: 100%;
  height: 96rpx;
  background: #FFF9ED;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #8C6B4B;
}

.modal-skip-btn:active {
  background: #FFEBB5;
}

.modal-policy {
  font-size: 22rpx;
  color: #D0B8A1;
  text-align: center;
}

.policy-link {
  color: #FF9800;
}
