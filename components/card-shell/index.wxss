.card-shell {
  border-radius: 28rpx;
  overflow: hidden;
}

.card-shell--warm {
  background: rgba(254, 243, 199, 0.98);
  box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
  border: 2rpx solid rgba(255, 244, 220, 0.9);
}

.card-shell--plain {
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(140, 107, 75, 0.06);
  border: 2rpx solid #FFF4DC;
}

.card-shell--animated {
  animation: panelSlideIn .4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes panelSlideIn {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
