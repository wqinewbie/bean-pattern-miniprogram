.popup-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.popup-card {
  width: 600rpx;
  max-width: 90vw;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  position: relative;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.popup-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
  background: #f5f5f5;
  border-radius: 50%;
}

.popup-image {
  width: 100%;
  height: 300rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.popup-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #333;
  text-align: center;
  margin-bottom: 16rpx;
}

.popup-content {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 32rpx;
}

.popup-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FFD54F, #FF9800);
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #3E2723;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 6rpx solid #F57C00;
}

.popup-btn:active {
  transform: translateY(4rpx);
  border-bottom-width: 2rpx;
}

.popup-never {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.never-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
}
