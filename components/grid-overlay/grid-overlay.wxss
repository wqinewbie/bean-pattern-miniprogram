/* 网格覆盖层容器 */
.grid-overlay-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none; /* 不拦截触摸事件 */
  z-index: 10; /* 在主 Canvas 之上 */
  overflow: visible;
}

/* 网格 Canvas */
.grid-canvas {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  /* 不使用 transform，让它跟随父容器的 transform */
  /* 硬件加速 */
  will-change: auto;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
