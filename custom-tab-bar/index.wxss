/* custom-tab-bar/index.wxss */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  border-top: 2rpx solid #FFEBB5;
  border-radius: 40rpx 40rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 8rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -8rpx 40rpx rgba(255, 200, 100, 0.18);
  z-index: 90;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 0;
  position: relative;
  transform: translateY(0);
}

.tab-item--active {
  animation: tab-rise 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  transform: translateY(-18rpx);
}

.tab-item--leaving {
  animation: tab-drop 0.22s ease-out;
  transform: translateY(0);
}

.tab-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

.tab-item--active .tab-icon-wrap {
  transform: scale(1.12);
}

.tab-item--leaving .tab-icon-wrap {
  transform: scale(1);
}

.tab-glow {
  position: absolute;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  opacity: 0;
  transform: scale(0.7);
  transition: opacity 0.24s ease, transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}

.tab-glow--show {
  opacity: 1;
  transform: scale(1);
}

.tab-glow--hide {
  opacity: 0;
  transform: scale(0.7);
}

.tab-glow--orange { background: radial-gradient(circle, rgba(255, 152, 0, 0.38) 0%, transparent 70%); }
.tab-glow--red { background: radial-gradient(circle, rgba(255, 107, 107, 0.38) 0%, transparent 70%); }
.tab-glow--purple { background: radial-gradient(circle, rgba(156, 39, 176, 0.38) 0%, transparent 70%); }
.tab-glow--green { background: radial-gradient(circle, rgba(76, 175, 80, 0.38) 0%, transparent 70%); }

.tab-icon {
  width: 46rpx;
  height: 46rpx;
  position: relative;
  z-index: 1;
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

.tab-item--active .tab-icon {
  transform: scale(1.12);
}

.tab-item--leaving .tab-icon {
  transform: scale(1);
}

.tab-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #D0B8A1;
  letter-spacing: 1rpx;
  transition: color 0.22s ease, font-size 0.24s ease, opacity 0.22s ease;
}

.tab-label--active {
  font-size: 24rpx;
  font-weight: 800;
}

.tab-label--leaving {
  font-size: 22rpx;
  font-weight: 700;
  color: #D0B8A1;
}

.tab-label--orange { color: #FF9800; }
.tab-label--red { color: #FF6B6B; }
.tab-label--purple { color: #9C27B0; }
.tab-label--green { color: #4CAF50; }

@keyframes tab-rise {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(-18rpx);
  }
}

@keyframes tab-drop {
  from {
    transform: translateY(-18rpx);
  }
  to {
    transform: translateY(0);
  }
}
