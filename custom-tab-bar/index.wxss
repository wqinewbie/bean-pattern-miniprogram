/* custom-tab-bar/index.wxss */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0; right: 0;
  height: 120rpx;
  background: #fff;
  border-top: 2rpx solid #FFEBB5;
  border-radius: 40rpx 40rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 8rpx;
  box-shadow: 0 -8rpx 40rpx rgba(255,200,100,0.18);
  z-index: 90;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 0;
  transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  will-change: transform;
}

.tab-item--active {
  transform: translateY(-18rpx);
}

.tab-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  /* 图标圆圈也弹跳放大 */
  transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-item--active .tab-icon-wrap {
  transform: scale(1.15);
}

/* 光晕：始终存在，用 opacity + scale 控制显隐，配合 transition 过渡 */
.tab-glow {
  position: absolute;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  opacity: 0;
  transform: scale(0.6);
  transition:
    opacity 0.35s ease,
    transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
}

.tab-glow--show {
  opacity: 1;
  transform: scale(1);
  animation: glow-pulse 2.5s ease infinite 0.45s;
}

.tab-glow--orange { background: radial-gradient(circle, rgba(255,152,0,0.4) 0%, transparent 70%); }
.tab-glow--red    { background: radial-gradient(circle, rgba(255,107,107,0.4) 0%, transparent 70%); }
.tab-glow--purple { background: radial-gradient(circle, rgba(156,39,176,0.4) 0%, transparent 70%); }
.tab-glow--green  { background: radial-gradient(circle, rgba(76,175,80,0.4) 0%, transparent 70%); }

@keyframes glow-pulse {
  0%, 100% { opacity: 1;   transform: scale(1); }
  50%       { opacity: 0.5; transform: scale(1.3); }
}

.tab-emoji {
  font-size: 44rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
  transition: font-size 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-item--active .tab-emoji {
  font-size: 54rpx;
}

.tab-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #D0B8A1;
  letter-spacing: 1rpx;
  transition:
    color 0.25s ease,
    font-size 0.3s ease;
}

.tab-label--active { font-size: 24rpx; font-weight: 800; }
.tab-label--orange { color: #FF9800; }
.tab-label--red    { color: #FF6B6B; }
.tab-label--purple { color: #9C27B0; }
.tab-label--green  { color: #4CAF50; }
