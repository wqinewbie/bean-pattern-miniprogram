/* common-result.wxss - 结果页公共样式 */

/* ========== 容器布局 ========== */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ========== 滚动区 ========== */
.scroll-body {
  flex: 1;
  overflow: hidden;
}

/* ========== 预览卡片 ========== */
.preview-card {
  margin: 28rpx 32rpx 0;
  border-radius: 48rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 30rpx var(--shadow-color);
  border: 4rpx solid var(--border-color);
  background: var(--card-bg);
}

.preview-wrap {
  width: 100%;
  aspect-ratio: 1;
  background: var(--preview-bg);
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 24rpx;
  z-index: 1;
}

.preview-wrap--tall {
  aspect-ratio: auto;
  min-height: 400rpx;
  display: block;
}

/* ========== 加载占位 ========== */
.preview-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: var(--placeholder-bg);
  z-index: 1;
}

.preview-placeholder-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--accent-color);
  animation: pulse 1.1s ease-in-out infinite;
}

.preview-placeholder-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

@keyframes pulse {
  0%, 100% { transform: scale(0.85); opacity: 0.7; }
  50% { transform: scale(1.15); opacity: 1; }
}

/* ========== 图片显示 ========== */
.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  object-fit: contain;
}

.preview-img--pattern {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 32rpx;
}

.preview-img--mirror {
  transform: scaleX(-1);
}

/* ========== Canvas ========== */
.pattern-canvas,
.result-canvas {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
}

.canvas-rendering {
  opacity: 0.3;
}

/* ========== Tab 切换栏 ========== */
.tab-bar {
  position: relative;
  z-index: 20;
  display: flex;
  background: var(--tab-bar-bg);
  border-radius: 24rpx;
  padding: 8rpx;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--tab-inactive-color);
  border-radius: 18rpx;
  transition: all 0.2s;
}

.tab--active {
  background: var(--tab-active-bg);
  color: var(--tab-active-color);
  box-shadow: 0 4rpx 12rpx var(--tab-shadow);
}

/* ========== 操作按钮 ========== */
.action-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}

.action-btn--primary {
  background: var(--primary-gradient);
  color: var(--primary-text);
  box-shadow: 0 8rpx 24rpx var(--primary-shadow);
}

.action-btn--secondary {
  background: var(--secondary-bg);
  color: var(--secondary-text);
  border: 2rpx solid var(--secondary-border);
}

.action-btn--disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ========== 色号清单卡片 ========== */
.stats-card {
  margin: 32rpx;
  background: var(--card-bg);
  border-radius: 48rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 30rpx var(--shadow-color);
  border: 4rpx solid var(--border-color);
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid var(--divider-color);
}

.stats-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stats-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: var(--accent-gradient);
}

.stats-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stats-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 600;
}

/* ========== 色号网格 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--item-bg);
  padding: 24rpx;
  border-radius: 24rpx;
  transition: all 0.2s;
  border: 2rpx solid var(--item-border);
}

.stat-item:active {
  transform: scale(0.98);
  background: var(--item-hover-bg);
}

.stat-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.stat-idx {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 600;
  min-width: 40rpx;
}

.stat-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  border: 2rpx solid var(--dot-border);
}

.stat-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.stat-id {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-name {
  font-size: 22rpx;
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-count {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent-color);
  flex-shrink: 0;
}

/* ========== 底部操作栏 ========== */
.footer {
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  background: var(--footer-bg);
  box-shadow: 0 -4rpx 20rpx var(--footer-shadow);
}

.footer-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.2s;
}

.footer-btn:active {
  transform: scale(0.98);
}

.footer-btn-primary {
  background: var(--primary-gradient);
  color: var(--primary-text);
  box-shadow: 0 8rpx 24rpx var(--primary-shadow);
}

.footer-btn-secondary {
  background: var(--secondary-bg);
  color: var(--secondary-text);
  border: 2rpx solid var(--secondary-border);
}

.footer-btn-icon {
  font-size: 32rpx;
}

.footer-btn-text {
  font-size: 28rpx;
  font-weight: 700;
}

/* ========== 图片占位 ========== */
.image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 80rpx 40rpx;
}

.ph-icon {
  font-size: 80rpx;
  opacity: 0.3;
}

.ph-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 600;
}
